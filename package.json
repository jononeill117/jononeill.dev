{
  "name": "jononeill-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "node scripts/security-fixes.test.mjs && pnpm --filter site build",
    "check": "pnpm -r check",
    "test": "node scripts/security-fixes.test.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.40.2"
  }
}
