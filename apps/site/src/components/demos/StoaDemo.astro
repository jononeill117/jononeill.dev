---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="stoa-demo"
  aspect="16 / 10"
  system="Data → underwriting → decision"
  cta="Open a Portico file. This is the queue 40 analysts worked."
  caption="Interactive walkthrough"
>
  <div class="sp" data-sp>
    <aside class="sp__rail" aria-hidden="true">
      <span class="sp__rail-mark">P</span>
      <span class="sp__rail-dot is-active"></span>
      <span class="sp__rail-dot"></span>
      <span class="sp__rail-dot"></span>
      <span class="sp__rail-dot"></span>
      <span class="sp__rail-dot"></span>
      <span class="sp__rail-dot"></span>
    </aside>

    <div class="sp__app">
      <header class="sp__top">
        <div class="sp__brand">
          <span class="sp__logo" aria-hidden="true"></span>
          <div class="sp__brand-text">
            <span class="sp__product">Portico</span>
            <span class="sp__module">Evaluations</span>
          </div>
        </div>
        <nav class="sp__tabs" aria-label="Workflow">
          <span class="sp__tab">Pre-screening</span>
          <span class="sp__tab is-active">Home Fact Verification</span>
          <span class="sp__tab">Rental Comps</span>
          <span class="sp__tab">ARV Comps</span>
          <span class="sp__tab">Wrap Up</span>
        </nav>
        <div class="sp__user" aria-hidden="true">
          <span class="sp__user-icon"></span>
          <span class="sp__avatar">CM</span>
        </div>
      </header>

      <p class="sp__status" data-sp-step>Waiting for file</p>

      <div class="sp__workspace">
        <section class="sp__details" aria-label="Home fact verification">
          <div class="sp__meta">
            <button type="button" class="sp__back" tabindex="-1" aria-hidden="true">&lt; Back</button>
            <div class="sp__scores" data-sp-scores>
              <span class="sp__score sp__score--deal" data-sp-score="deal">Deal Score: -</span>
              <span class="sp__score sp__score--partner" data-sp-score="partner">Partner Score: -</span>
              <span class="sp__score sp__score--entity" data-sp-score="entity">Entity Score: -</span>
            </div>
          </div>

          <h3 class="sp__addr" data-sp-addr>Opening file…</h3>
          <p class="sp__facts" data-sp-facts></p>

          <div class="sp__summary">
            <div class="sp__desc" data-sp-desc>
              <p class="sp__desc-title">Property Description</p>
              <p class="sp__desc-body" data-sp-desc-body>
                Quiet single-family lot with solid bones for a light reno. Kitchen and baths need
                updates; roof and HVAC recent. Close to schools and retail.
                <span class="sp__more">…more</span>
              </p>
            </div>

            <div class="sp__val" data-sp-val-card>
              <p class="sp__val-label">Stoa Valuation</p>
              <p class="sp__val-price">
                <strong data-sp-val>$-</strong>
                <span class="sp__val-psf" data-sp-psf></span>
              </p>
              <div class="sp__range" data-sp-range aria-hidden="true">
                <div class="sp__range-track">
                  <span class="sp__range-fill"></span>
                  <span class="sp__range-marker" data-sp-marker></span>
                </div>
                <div class="sp__range-labels">
                  <span data-sp-low>Low Estimate</span>
                  <span data-sp-high>High Estimate</span>
                </div>
              </div>
            </div>
          </div>

          <div class="sp__table-wrap" data-sp-table>
            <div class="sp__table-head">
              <h4 class="sp__table-title">Property Details</h4>
              <span class="sp__feed-pill" data-sp-feed-pill>Feeds idle</span>
            </div>
            <div class="sp__table-scroll">
              <table class="sp__table">
                <thead>
                  <tr>
                    <th>Details</th>
                    <th>Post Reno</th>
                    <th data-sp-col="public">Public Record</th>
                    <th data-sp-col="mls">MLS</th>
                    <th data-sp-col="third">3rd Party</th>
                    <th data-sp-col="final">Final Data</th>
                    <th>Contingency</th>
                  </tr>
                </thead>
                <tbody>
                  <tr data-sp-row="beds" class="sp__row--flag">
                    <td>Bedrooms</td>
                    <td data-sp-cell="beds-reno">-</td>
                    <td data-sp-cell="beds-public">-</td>
                    <td data-sp-cell="beds-mls">-</td>
                    <td data-sp-cell="beds-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="beds" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="beds" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="baths">
                    <td>Bathrooms</td>
                    <td data-sp-cell="baths-reno">-</td>
                    <td data-sp-cell="baths-public">-</td>
                    <td data-sp-cell="baths-mls">-</td>
                    <td data-sp-cell="baths-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="baths" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="baths" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="stories">
                    <td>Story Count</td>
                    <td data-sp-cell="stories-reno">-</td>
                    <td data-sp-cell="stories-public">-</td>
                    <td data-sp-cell="stories-mls">-</td>
                    <td data-sp-cell="stories-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="stories" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="stories" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="gla">
                    <td>GLA</td>
                    <td data-sp-cell="gla-reno">-</td>
                    <td data-sp-cell="gla-public">-</td>
                    <td data-sp-cell="gla-mls">-</td>
                    <td data-sp-cell="gla-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="gla" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="gla" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="basement">
                    <td>Basement</td>
                    <td data-sp-cell="basement-reno">-</td>
                    <td data-sp-cell="basement-public">-</td>
                    <td data-sp-cell="basement-mls">-</td>
                    <td data-sp-cell="basement-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="basement" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="basement" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="lot" class="sp__row--flag">
                    <td>Lot Size</td>
                    <td data-sp-cell="lot-reno">-</td>
                    <td data-sp-cell="lot-public">-</td>
                    <td data-sp-cell="lot-mls">-</td>
                    <td data-sp-cell="lot-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="lot" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="lot" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="year">
                    <td>Year Built</td>
                    <td data-sp-cell="year-reno">-</td>
                    <td data-sp-cell="year-public">-</td>
                    <td data-sp-cell="year-mls">-</td>
                    <td data-sp-cell="year-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="year" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="year" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="pool">
                    <td>Pool</td>
                    <td data-sp-cell="pool-reno">-</td>
                    <td data-sp-cell="pool-public">-</td>
                    <td data-sp-cell="pool-mls">-</td>
                    <td data-sp-cell="pool-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="pool" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="pool" disabled tabindex="-1" />
                    </td>
                  </tr>
                  <tr data-sp-row="septic">
                    <td>Septic System</td>
                    <td data-sp-cell="septic-reno">-</td>
                    <td data-sp-cell="septic-public">-</td>
                    <td data-sp-cell="septic-mls">-</td>
                    <td data-sp-cell="septic-third">-</td>
                    <td>
                      <button type="button" class="sp__final" data-sp-nudge="septic" disabled>-</button>
                    </td>
                    <td>
                      <input type="checkbox" class="sp__check" data-sp-check="septic" disabled tabindex="-1" />
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <ul class="sp__flags" data-sp-flags hidden>
            <li class="sp__flag" data-sp-flag="beds">Bedrooms mismatch across sources</li>
            <li class="sp__flag" data-sp-flag="lot">Lot size variance flagged</li>
            <li class="sp__flag" data-sp-flag="avm">Valuation band within 6%</li>
          </ul>

          <div class="sp__actions" data-sp-actions>
            <button type="button" class="sp__accept" data-sp-accept disabled>Accept</button>
            <button type="button" class="sp__recalc" data-sp-recalc hidden disabled>Recalc</button>
            <button type="button" class="sp__replay" data-sp-replay hidden>Replay</button>
            <p class="sp__hint" data-sp-hint hidden>Nudge a Final Data cell, then Recalc.</p>
          </div>
        </section>

        <section class="sp__map" data-sp-map aria-label="Value heatmap">
          <div class="sp__map-chrome">
            <div class="sp__map-modes">
              <span class="sp__map-mode is-active">Satellite</span>
              <span class="sp__map-mode">Map</span>
              <span class="sp__map-mode">Street</span>
              <span class="sp__map-mode">Lot</span>
            </div>
            <div class="sp__map-zoom" aria-hidden="true">
              <span>+</span>
              <span>-</span>
            </div>
          </div>
          <div class="sp__map-canvas">
            <svg class="sp__map-svg" viewBox="0 0 320 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <linearGradient id="sp-sea" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#1a4a6e"></stop>
                  <stop offset="100%" stop-color="#2d6a8a"></stop>
                </linearGradient>
                <linearGradient id="sp-land" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#3d5a3a"></stop>
                  <stop offset="55%" stop-color="#5a7248"></stop>
                  <stop offset="100%" stop-color="#6b7a52"></stop>
                </linearGradient>
                <filter id="sp-soft">
                  <feGaussianBlur stdDeviation="1.2"></feGaussianBlur>
                </filter>
              </defs>
              <rect width="320" height="280" fill="url(#sp-land)"></rect>
              <path
                d="M0 40 C40 30 70 55 110 48 C150 40 170 20 210 28 C250 36 280 18 320 30 L320 0 L0 0 Z"
                fill="url(#sp-sea)"
                opacity="0.85"
              ></path>
              <path
                d="M0 280 L0 210 C30 200 50 220 90 215 C140 208 160 180 210 190 C260 200 290 175 320 185 L320 280 Z"
                fill="url(#sp-sea)"
                opacity="0.55"
              ></path>
              <g class="sp__hexes" data-sp-hexes opacity="0">
                <polygon points="40,90 55,82 70,90 70,106 55,114 40,106" fill="#86efac" opacity="0.55"></polygon>
                <polygon points="70,106 85,98 100,106 100,122 85,130 70,122" fill="#4ade80" opacity="0.6"></polygon>
                <polygon points="100,90 115,82 130,90 130,106 115,114 100,106" fill="#22d3ee" opacity="0.55"></polygon>
                <polygon points="130,106 145,98 160,106 160,122 145,130 130,122" fill="#38bdf8" opacity="0.65"></polygon>
                <polygon points="160,90 175,82 190,90 190,106 175,114 160,106" fill="#818cf8" opacity="0.7"></polygon>
                <polygon points="190,106 205,98 220,106 220,122 205,130 190,122" fill="#a78bfa" opacity="0.75"></polygon>
                <polygon points="100,122 115,114 130,122 130,138 115,146 100,138" fill="#34d399" opacity="0.55"></polygon>
                <polygon points="130,138 145,130 160,138 160,154 145,162 130,154" fill="#60a5fa" opacity="0.7"></polygon>
                <polygon points="160,122 175,114 190,122 190,138 175,146 160,138" fill="#8b5cf6" opacity="0.8"></polygon>
                <polygon points="190,138 205,130 220,138 220,154 205,162 190,154" fill="#7c3aed" opacity="0.85"></polygon>
                <polygon points="220,106 235,98 250,106 250,122 235,130 220,122" fill="#6366f1" opacity="0.75"></polygon>
                <polygon points="220,138 235,130 250,138 250,154 235,162 220,154" fill="#4f46e5" opacity="0.8"></polygon>
                <polygon points="145,162 160,154 175,162 175,178 160,186 145,178" fill="#c4b5fd" opacity="0.7"></polygon>
                <polygon points="175,178 190,170 205,178 205,194 190,202 175,194" fill="#a855f7" opacity="0.75"></polygon>
                <polygon points="70,138 85,130 100,138 100,154 85,162 70,154" fill="#6ee7b7" opacity="0.5"></polygon>
                <polygon points="55,162 70,154 85,162 85,178 70,186 55,178" fill="#86efac" opacity="0.45"></polygon>
                <circle cx="188" cy="128" r="5" fill="#fff" stroke="#7c3aed" stroke-width="2"></circle>
              </g>
              <text x="16" y="268" fill="rgba(255,255,255,0.7)" font-size="9" font-family="system-ui,sans-serif">
                Value heatmap
              </text>
            </svg>
          </div>
          <div class="sp__map-foot">
            <div class="sp__layers">
              <span class="sp__layer is-active">Value</span>
              <span class="sp__layer">Property</span>
              <span class="sp__layer">Region</span>
              <span class="sp__layer">Hazards</span>
              <span class="sp__layer">Market</span>
            </div>
            <span class="sp__view-images">View Images</span>
          </div>
        </section>
      </div>
    </div>
  </div>
</DemoFrame>

<script>
  type SpFeed = "public" | "mls" | "third" | "final";

  type SpRowKey =
    | "beds"
    | "baths"
    | "stories"
    | "gla"
    | "basement"
    | "lot"
    | "year"
    | "pool"
    | "septic";

  type SpRowData = {
    reno: string;
    public: string;
    mls: string;
    third: string;
    final: string;
    contingency: boolean;
  };

  const ADDRESS = "14436 Williamsburg Manor Drive, Longcityname, ST, 84657";
  const FACTS = "Single Family Detached · 2 Beds · 1 Bath · 1,500 SqFt. · Built 1965 · Stoa ID #4418";

  const ROW_KEYS: SpRowKey[] = [
    "beds",
    "baths",
    "stories",
    "gla",
    "basement",
    "lot",
    "year",
    "pool",
    "septic",
  ];

  const TABLE: Record<SpRowKey, SpRowData> = {
    beds: { reno: "2", public: "2", mls: "1", third: "-", final: "2", contingency: true },
    baths: { reno: "3", public: "3", mls: "0", third: "-", final: "2", contingency: false },
    stories: { reno: "-", public: "-", mls: "2", third: "2", final: "2", contingency: false },
    gla: { reno: "2000", public: "2000", mls: "1814", third: "-", final: "1500", contingency: false },
    basement: { reno: "-", public: "-", mls: "No", third: "No", final: "No", contingency: false },
    lot: {
      reno: "5643 sqft.",
      public: "5000 sqft.",
      mls: "5643 sqft.",
      third: "5000 sqft.",
      final: "5000 sqft.",
      contingency: true,
    },
    year: { reno: "-", public: "1952", mls: "1953", third: "-", final: "1965", contingency: false },
    pool: { reno: "No", public: "Yes", mls: "No", third: "-", final: "No", contingency: false },
    septic: { reno: "-", public: "-", mls: "No", third: "-", final: "No", contingency: false },
  };

  const NUDGE_CYCLES: Partial<Record<SpRowKey, string[]>> = {
    beds: ["2", "3", "2"],
    gla: ["1500", "1620", "1480"],
    lot: ["5000 sqft.", "5643 sqft.", "5200 sqft."],
    year: ["1965", "1953", "1960"],
  };

  const VALUATIONS = [
    { price: "$392,547", psf: "$230/sqft.", low: "Low Estimate $379,465 ($222/sqft.)", high: "High Estimate $405,630 ($227/sqft.)" },
    { price: "$384,200", psf: "$225/sqft.", low: "Low Estimate $371,100 ($217/sqft.)", high: "High Estimate $397,400 ($233/sqft.)" },
    { price: "$401,100", psf: "$235/sqft.", low: "Low Estimate $388,050 ($227/sqft.)", high: "High Estimate $414,200 ($243/sqft.)" },
  ] as const;

  const FEEDS: { id: SpFeed; label: string; progressMs: number; resolveMs: number }[] = [
    { id: "public", label: "Public Record", progressMs: 1320, resolveMs: 920 },
    { id: "mls", label: "MLS", progressMs: 1380, resolveMs: 940 },
    { id: "third", label: "3rd Party", progressMs: 1300, resolveMs: 900 },
    { id: "final", label: "Final Data", progressMs: 1420, resolveMs: 960 },
  ];

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireStoa(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-sp-wired")) return;
    frame.setAttribute("data-sp-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-sp-step]");
    const addrEl = root.querySelector<HTMLElement>("[data-sp-addr]");
    const factsEl = root.querySelector<HTMLElement>("[data-sp-facts]");
    const descBody = root.querySelector<HTMLElement>("[data-sp-desc-body]");
    const desc = root.querySelector<HTMLElement>("[data-sp-desc]");
    const valCard = root.querySelector<HTMLElement>("[data-sp-val-card]");
    const valEl = root.querySelector<HTMLElement>("[data-sp-val]");
    const psfEl = root.querySelector<HTMLElement>("[data-sp-psf]");
    const lowEl = root.querySelector<HTMLElement>("[data-sp-low]");
    const highEl = root.querySelector<HTMLElement>("[data-sp-high]");
    const rangeEl = root.querySelector<HTMLElement>("[data-sp-range]");
    const feedPill = root.querySelector<HTMLElement>("[data-sp-feed-pill]");
    const flags = root.querySelector<HTMLElement>("[data-sp-flags]");
    const hexes = root.querySelector<HTMLElement>("[data-sp-hexes]");
    const mapEl = root.querySelector<HTMLElement>("[data-sp-map]");
    const acceptBtn = root.querySelector<HTMLButtonElement>("[data-sp-accept]");
    const recalcBtn = root.querySelector<HTMLButtonElement>("[data-sp-recalc]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-sp-replay]");
    const hint = root.querySelector<HTMLElement>("[data-sp-hint]");
    const nudgeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sp-nudge]"));

    let running = false;
    let token = 0;
    let tryMode = false;
    let dirty = false;
    let recalcing = false;
    let valuationIdx = 0;
    const nudgeIdx: Partial<Record<SpRowKey, number>> = {};

    const setStep = (text: string) => {
      if (stepEl) stepEl.textContent = text;
    };

    const setValuation = (idx: number, working = false) => {
      const v = VALUATIONS[idx] ?? VALUATIONS[0]!;
      valuationIdx = idx;
      if (valEl) valEl.textContent = working ? "…" : v.price;
      if (psfEl) psfEl.textContent = working ? "" : v.psf;
      if (lowEl) lowEl.textContent = working ? "Low Estimate" : v.low;
      if (highEl) highEl.textContent = working ? "High Estimate" : v.high;
      valCard?.classList.toggle("is-working", working);
      valCard?.classList.toggle("is-live", !working && idx >= 0);
      rangeEl?.classList.toggle("is-live", !working);
    };

    const clearCells = () => {
      ROW_KEYS.forEach((key) => {
        (["reno", "public", "mls", "third"] as const).forEach((col) => {
          const el = root.querySelector(`[data-sp-cell='${key}-${col}']`);
          if (el) {
            el.textContent = "-";
            el.classList.remove("is-working", "is-live");
          }
        });
        const btn = root.querySelector<HTMLButtonElement>(`[data-sp-nudge='${key}']`);
        if (btn) {
          btn.textContent = "-";
          btn.disabled = true;
          btn.classList.remove("is-working", "is-live", "is-pulse", "is-nudge");
        }
        const check = root.querySelector<HTMLInputElement>(`[data-sp-check='${key}']`);
        if (check) {
          check.checked = false;
          check.disabled = true;
          check.classList.remove("is-live");
        }
        root.querySelector(`[data-sp-row='${key}']`)?.classList.remove("is-working", "is-live");
      });
      (["public", "mls", "third", "final"] as SpFeed[]).forEach((id) => {
        root.querySelector(`[data-sp-col='${id}']`)?.classList.remove("is-working", "is-live");
      });
    };

    const fillReno = () => {
      ROW_KEYS.forEach((key) => {
        const el = root.querySelector(`[data-sp-cell='${key}-reno']`);
        if (el) {
          el.textContent = TABLE[key].reno;
          el.classList.add("is-live");
        }
      });
    };

    const setFeedWorking = (id: SpFeed) => {
      root.querySelector(`[data-sp-col='${id}']`)?.classList.add("is-working");
      root.querySelector(`[data-sp-col='${id}']`)?.classList.remove("is-live");
      ROW_KEYS.forEach((key) => {
        if (id === "final") {
          const btn = root.querySelector(`[data-sp-nudge='${key}']`);
          btn?.classList.add("is-working");
          btn?.classList.remove("is-live");
          if (btn) btn.textContent = "…";
        } else {
          const el = root.querySelector(`[data-sp-cell='${key}-${id}']`);
          el?.classList.add("is-working");
          el?.classList.remove("is-live");
          if (el) el.textContent = "…";
        }
      });
    };

    const setFeedLive = (id: SpFeed) => {
      root.querySelector(`[data-sp-col='${id}']`)?.classList.remove("is-working");
      root.querySelector(`[data-sp-col='${id}']`)?.classList.add("is-live");
      ROW_KEYS.forEach((key) => {
        const row = TABLE[key];
        if (id === "final") {
          const btn = root.querySelector<HTMLButtonElement>(`[data-sp-nudge='${key}']`);
          if (btn) {
            btn.textContent = row.final;
            btn.classList.remove("is-working");
            btn.classList.add("is-live");
          }
        } else {
          const el = root.querySelector(`[data-sp-cell='${key}-${id}']`);
          if (el) {
            el.textContent = row[id];
            el.classList.remove("is-working");
            el.classList.add("is-live");
          }
        }
      });
    };

    const resetBoard = () => {
      setStep("Waiting for file");
      if (addrEl) addrEl.textContent = "Opening file…";
      if (factsEl) factsEl.textContent = "";
      desc?.classList.remove("is-live");
      if (descBody) descBody.style.opacity = "0.35";
      clearCells();
      setValuation(0, true);
      if (valEl) valEl.textContent = "$-";
      valCard?.classList.remove("is-working", "is-live");
      rangeEl?.classList.remove("is-live");
      if (feedPill) feedPill.textContent = "Feeds idle";
      if (flags) flags.hidden = true;
      flags?.querySelectorAll(".sp__flag").forEach((el) => {
        el.classList.remove("is-working", "is-live");
      });
      hexes?.setAttribute("opacity", "0");
      mapEl?.classList.remove("is-live");
      root.querySelectorAll("[data-sp-score]").forEach((el) => {
        el.classList.remove("is-live");
        const kind = el.getAttribute("data-sp-score");
        if (kind === "deal") el.textContent = "Deal Score: -";
        if (kind === "partner") el.textContent = "Partner Score: -";
        if (kind === "entity") el.textContent = "Entity Score: -";
      });
      if (acceptBtn) {
        acceptBtn.disabled = true;
        acceptBtn.classList.remove("is-done");
        acceptBtn.textContent = "Accept";
        acceptBtn.hidden = false;
      }
      if (recalcBtn) {
        recalcBtn.hidden = true;
        recalcBtn.disabled = true;
      }
      if (replayBtn) replayBtn.hidden = true;
      if (hint) hint.hidden = true;
      tryMode = false;
      dirty = false;
      recalcing = false;
      valuationIdx = 0;
      Object.keys(nudgeIdx).forEach((k) => delete nudgeIdx[k as SpRowKey]);
    };

    const paintScores = () => {
      const deal = root.querySelector("[data-sp-score='deal']");
      const partner = root.querySelector("[data-sp-score='partner']");
      const entity = root.querySelector("[data-sp-score='entity']");
      if (deal) deal.textContent = "Deal Score: 92";
      if (partner) partner.textContent = "Partner Score: 77";
      if (entity) entity.textContent = "Entity Score: 90";
      root.querySelectorAll("[data-sp-score]").forEach((el) => el.classList.add("is-live"));
    };

    const paintContingencies = () => {
      ROW_KEYS.forEach((key) => {
        const check = root.querySelector<HTMLInputElement>(`[data-sp-check='${key}']`);
        if (!check) return;
        check.checked = TABLE[key].contingency;
        check.classList.toggle("is-live", TABLE[key].contingency);
      });
    };

    const enableTry = () => {
      tryMode = true;
      nudgeBtns.forEach((btn) => {
        const key = btn.getAttribute("data-sp-nudge") as SpRowKey | null;
        if (key && NUDGE_CYCLES[key]) {
          btn.disabled = false;
          btn.classList.add("is-pulse");
        }
      });
      if (recalcBtn) {
        recalcBtn.hidden = false;
        recalcBtn.disabled = true;
      }
      if (replayBtn) replayBtn.hidden = false;
      if (hint) hint.hidden = false;
    };

    const paintFinal = () => {
      if (addrEl) addrEl.textContent = ADDRESS;
      if (factsEl) factsEl.textContent = FACTS;
      desc?.classList.add("is-live");
      if (descBody) descBody.style.opacity = "1";
      paintScores();
      fillReno();
      FEEDS.forEach((f) => setFeedLive(f.id));
      paintContingencies();
      setValuation(0, false);
      if (feedPill) feedPill.textContent = "Feeds live";
      if (flags) flags.hidden = false;
      flags?.querySelectorAll(".sp__flag").forEach((el) => el.classList.add("is-live"));
      hexes?.setAttribute("opacity", "1");
      mapEl?.classList.add("is-live");
      if (acceptBtn) {
        acceptBtn.disabled = false;
        acceptBtn.classList.add("is-done");
        acceptBtn.textContent = "Accepted";
      }
      enableTry();
    };

    const finish = () => {
      running = false;
      setStep("Decision recorded · try the Final Data cells");
      enableTry();
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const snapFinal = () => {
      resetBoard();
      paintFinal();
      finish();
    };

    const run = async () => {
      const my = ++token;
      running = true;
      tryMode = false;
      resetBoard();

      // 1. File opens
      setStep("File opening…");
      if (addrEl) addrEl.textContent = "Loading #4418…";
      await sleep(1100);
      if (my !== token) return;

      if (addrEl) addrEl.textContent = ADDRESS;
      if (factsEl) factsEl.textContent = FACTS;
      paintScores();
      fillReno();
      desc?.classList.add("is-live");
      if (descBody) descBody.style.opacity = "1";
      mapEl?.classList.add("is-live");
      setStep("File open · Home Fact Verification");
      await sleep(1100);
      if (my !== token) return;

      // 2. Feeds resolve into table cells (working → live)
      setStep("Resolving vendor feeds");
      for (const feed of FEEDS) {
        if (my !== token) return;
        if (feedPill) feedPill.textContent = `Pulling ${feed.label}…`;
        setStep(`Pulling ${feed.label}…`);
        setFeedWorking(feed.id);
        await sleep(feed.progressMs);
        if (my !== token) return;
        setFeedLive(feed.id);
        if (feedPill) feedPill.textContent = `${feed.label} live`;
        await sleep(feed.resolveMs);
        if (my !== token) return;
      }
      if (feedPill) feedPill.textContent = "Feeds live";
      setStep("Vendor feeds resolved");
      await sleep(1050);
      if (my !== token) return;

      // 3. Valuation calculates
      setStep("Calculating Stoa valuation…");
      setValuation(0, true);
      await sleep(2000);
      if (my !== token) return;
      setValuation(0, false);
      hexes?.setAttribute("opacity", "1");
      setStep("Stoa valuation locked at $392,547");
      await sleep(1400);
      if (my !== token) return;

      // 4. Flags / contingencies
      setStep("Raising contingencies…");
      if (flags) flags.hidden = false;
      const flagIds = ["beds", "lot", "avm"] as const;
      for (const id of flagIds) {
        if (my !== token) return;
        const el = root.querySelector(`[data-sp-flag='${id}']`);
        el?.classList.add("is-working");
        await sleep(380);
        if (my !== token) return;
        el?.classList.remove("is-working");
        el?.classList.add("is-live");
        if (id === "beds" || id === "lot") {
          const check = root.querySelector<HTMLInputElement>(`[data-sp-check='${id}']`);
          if (check) {
            check.checked = true;
            check.classList.add("is-live");
          }
        }
        await sleep(320);
        if (my !== token) return;
      }
      setStep("Contingencies ready for review");
      await sleep(1100);
      if (my !== token) return;

      // 5. Accept
      setStep("Analyst review");
      if (acceptBtn) acceptBtn.disabled = false;
      await sleep(1700);
      if (my !== token) return;

      if (acceptBtn) {
        acceptBtn.classList.add("is-done");
        acceptBtn.textContent = "Accepted";
      }
      setStep("Decision recorded");
      await sleep(1100);
      if (my !== token) return;

      finish();
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        snapFinal();
        return;
      }
      void run();
    });

    frame.addEventListener("demo-replay", () => void run());

    nudgeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!tryMode || running || recalcing) return;
        const key = btn.getAttribute("data-sp-nudge") as SpRowKey | null;
        if (!key) return;
        const cycle = NUDGE_CYCLES[key];
        if (!cycle) return;
        const next = ((nudgeIdx[key] ?? 0) + 1) % cycle.length;
        nudgeIdx[key] = next;
        btn.textContent = cycle[next] ?? cycle[0]!;
        dirty = true;
        btn.classList.add("is-nudge");
        btn.classList.remove("is-pulse");
        setTimeout(() => btn.classList.remove("is-nudge"), 280);
        nudgeBtns.forEach((b) => b.classList.remove("is-pulse"));
        if (recalcBtn) recalcBtn.disabled = false;
        setStep("Final Data nudged · Recalc when ready");
      });
    });

    recalcBtn?.addEventListener("click", async () => {
      if (!tryMode || running || !dirty || recalcing) return;
      recalcing = true;
      dirty = false;
      if (recalcBtn) recalcBtn.disabled = true;
      setStep("Recalculating valuation…");
      setValuation(valuationIdx, true);
      recalcBtn?.classList.add("is-nudge");
      await sleep(1700);
      const nextIdx = (valuationIdx + 1) % VALUATIONS.length;
      setValuation(nextIdx, false);
      setStep(`Valuation updated to ${VALUATIONS[nextIdx]!.price}`);
      setTimeout(() => recalcBtn?.classList.remove("is-nudge"), 280);
      recalcing = false;
    });

    replayBtn?.addEventListener("click", () => {
      if (running || recalcing) return;
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });

    acceptBtn?.addEventListener("click", () => {
      if (!tryMode || running || acceptBtn.classList.contains("is-done")) return;
      acceptBtn.classList.add("is-done");
      acceptBtn.textContent = "Accepted";
      setStep("Decision recorded");
    });
  }

  document.querySelectorAll("[data-sp]").forEach((el) => wireStoa(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-sp]").forEach((el) => wireStoa(el as HTMLElement));
  });
</script>

