---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="stoa-demo"
  system="Data → underwriting → decision"
  cta="Open a Portico file. This is the queue 40 analysts worked."
  caption="Interactive walkthrough"
>
  <div class="sp" data-sp>
    <header class="sp__head">
      <div class="sp__brand">
        <span class="sp__product">Portico</span>
        <span class="sp__queue-label" data-sp-step>Queue idle</span>
      </div>
      <span class="sp__eval" data-sp-eval>Eval -</span>
    </header>

    <div class="sp__queue" data-sp-queue>
      <div class="sp__file is-empty" data-sp-file>
        <span class="sp__file-id" data-sp-file-id>Waiting for file</span>
        <span class="sp__file-addr" data-sp-file-addr></span>
        <span class="sp__file-status" data-sp-file-status></span>
      </div>
    </div>

    <div class="sp__feeds" data-sp-feeds aria-label="Vendor feeds">
      <div class="sp__feed" data-sp-feed="mls" role="listitem">
        <span class="sp__feed-name">MLS</span>
        <span class="sp__feed-detail" data-sp-feed-detail="mls">Idle</span>
      </div>
      <div class="sp__feed" data-sp-feed="tax" role="listitem">
        <span class="sp__feed-name">Tax</span>
        <span class="sp__feed-detail" data-sp-feed-detail="tax">Idle</span>
      </div>
      <div class="sp__feed" data-sp-feed="title" role="listitem">
        <span class="sp__feed-name">Title</span>
        <span class="sp__feed-detail" data-sp-feed-detail="title">Idle</span>
      </div>
      <div class="sp__feed" data-sp-feed="avm" role="listitem">
        <span class="sp__feed-name">AVM</span>
        <span class="sp__feed-detail" data-sp-feed-detail="avm">Idle</span>
      </div>
      <div class="sp__feed" data-sp-feed="insp" role="listitem">
        <span class="sp__feed-name">Inspection</span>
        <span class="sp__feed-detail" data-sp-feed-detail="insp">Idle</span>
      </div>
      <div class="sp__feed" data-sp-feed="comp" role="listitem">
        <span class="sp__feed-name">Comps</span>
        <span class="sp__feed-detail" data-sp-feed-detail="comp">Idle</span>
      </div>
    </div>

    <div class="sp__record" data-sp-record>
      <p class="sp__record-title">Property record</p>
      <p class="sp__record-body" data-sp-record-body>Feeds unresolved. No consolidated file yet.</p>
    </div>

    <ul class="sp__flags" data-sp-flags hidden>
      <li class="sp__flag" data-sp-flag="roof">Roof age 14 yr</li>
      <li class="sp__flag" data-sp-flag="title">Title exception</li>
      <li class="sp__flag" data-sp-flag="avm">Valuation variance 6%</li>
    </ul>

    <div class="sp__valuation-lock" data-sp-valuation-lock hidden>
      <span class="sp__valuation-lock-label">Valuation</span>
      <strong class="sp__valuation-lock-num" data-sp-valuation-lock-num>Pending</strong>
    </div>

    <div class="sp__review" data-sp-review hidden>
      <span class="sp__review-label" data-sp-review-label>Analyst review</span>
      <button type="button" class="sp__accept" data-sp-accept disabled>Accept</button>
    </div>

    <div class="sp__metrics" data-sp-metrics hidden>
      <span class="sp__chip">$1B underwritten</span>
      <span class="sp__chip">cycle time 85% faster</span>
      <span class="sp__chip">22 to 6 integrations</span>
    </div>

    <div class="sp__try" data-sp-try hidden>
      <table class="sp__table">
        <thead>
          <tr><th>Field</th><th>Source</th><th>Final data</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Sq ft</td>
            <td>1,840</td>
            <td>1,840</td>
          </tr>
          <tr>
            <td>Roof age</td>
            <td>12 yr</td>
            <td>
              <button type="button" class="sp__cell sp__cell--pulse" data-sp-nudge="roof">14 yr</button>
            </td>
          </tr>
          <tr>
            <td>Contingency</td>
            <td>$8,200</td>
            <td>
              <button type="button" class="sp__cell" data-sp-nudge="contingency">$9,400</button>
            </td>
          </tr>
        </tbody>
      </table>
      <div class="sp__try-bar">
        <p class="sp__valuation" data-sp-try-val>
          Valuation <strong data-sp-val>$392,547</strong>
        </p>
        <button type="button" class="sp__recalc" data-sp-recalc>Recalc</button>
        <button type="button" class="sp__replay" data-sp-replay>Replay</button>
      </div>
      <p class="sp__hint" data-sp-hint>Nudge roof age or contingency, then Recalc.</p>
    </div>
  </div>
</DemoFrame>

<script>
  type SpFeedBeat = {
    id: string;
    progressDetail: string;
    resolvedDetail: string;
    progressMs: number;
    resolveMs: number;
  };

  const FEEDS: SpFeedBeat[] = [
    {
      id: "mls",
      progressDetail: "Pulling MLS…",
      resolvedDetail: "Done",
      progressMs: 900,
      resolveMs: 380,
    },
    {
      id: "tax",
      progressDetail: "Pulling tax…",
      resolvedDetail: "Done",
      progressMs: 900,
      resolveMs: 380,
    },
    {
      id: "title",
      progressDetail: "Checking title…",
      resolvedDetail: "Done",
      progressMs: 900,
      resolveMs: 380,
    },
    {
      id: "avm",
      progressDetail: "Running AVM…",
      resolvedDetail: "Done",
      progressMs: 1000,
      resolveMs: 400,
    },
    {
      id: "insp",
      progressDetail: "Loading inspection…",
      resolvedDetail: "Done",
      progressMs: 900,
      resolveMs: 380,
    },
    {
      id: "comp",
      progressDetail: "Matching comps…",
      resolvedDetail: "Done",
      progressMs: 900,
      resolveMs: 380,
    },
  ];

  const ROOF_VALUES = ["14 yr", "16 yr", "11 yr"] as const;
  const CONTINGENCY_VALUES = ["$9,400", "$11,200", "$7,800"] as const;
  const VALUATIONS = ["$392,547", "$384,200", "$401,100"] as const;

  const RECORD_FACTS =
    "1847 Longcityname Blvd, Unit 3B · 1,840 sq ft · SFR · Phoenix MSA";

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireStoa(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-sp-wired")) return;
    frame.setAttribute("data-sp-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-sp-step]");
    const evalEl = root.querySelector<HTMLElement>("[data-sp-eval]");
    const fileEl = root.querySelector<HTMLElement>("[data-sp-file]");
    const fileId = root.querySelector<HTMLElement>("[data-sp-file-id]");
    const fileAddr = root.querySelector<HTMLElement>("[data-sp-file-addr]");
    const fileStatus = root.querySelector<HTMLElement>("[data-sp-file-status]");
    const recordEl = root.querySelector<HTMLElement>("[data-sp-record]");
    const recordBody = root.querySelector<HTMLElement>("[data-sp-record-body]");
    const flags = root.querySelector<HTMLElement>("[data-sp-flags]");
    const valuationLock = root.querySelector<HTMLElement>("[data-sp-valuation-lock]");
    const valuationLockNum = root.querySelector<HTMLElement>("[data-sp-valuation-lock-num]");
    const review = root.querySelector<HTMLElement>("[data-sp-review]");
    const reviewLabel = root.querySelector<HTMLElement>("[data-sp-review-label]");
    const acceptBtn = root.querySelector<HTMLButtonElement>("[data-sp-accept]");
    const metrics = root.querySelector<HTMLElement>("[data-sp-metrics]");
    const tryPanel = root.querySelector<HTMLElement>("[data-sp-try]");
    const tryVal = root.querySelector<HTMLElement>("[data-sp-try-val]");
    const recalcBtn = root.querySelector<HTMLButtonElement>("[data-sp-recalc]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-sp-replay]");
    const valEl = root.querySelector<HTMLElement>("[data-sp-val]");
    const roofBtn = root.querySelector<HTMLButtonElement>("[data-sp-nudge='roof']");
    const contingencyBtn = root.querySelector<HTMLButtonElement>("[data-sp-nudge='contingency']");

    let running = false;
    let token = 0;
    let roofIdx = 0;
    let contingencyIdx = 0;
    let valuationIdx = 0;
    let dirty = false;
    let recalcing = false;

    const setStep = (text: string) => {
      if (stepEl) stepEl.textContent = text;
    };

    const clearFeedState = (id: string) => {
      const el = root.querySelector(`[data-sp-feed='${id}']`);
      el?.classList.remove("is-working", "is-done", "is-live");
    };

    const setFeedWorking = (id: string, detail: string) => {
      clearFeedState(id);
      root.querySelector(`[data-sp-feed='${id}']`)?.classList.add("is-working");
      const d = root.querySelector(`[data-sp-feed-detail='${id}']`);
      if (d) d.textContent = detail;
    };

    const setFeedDone = (id: string, detail: string) => {
      clearFeedState(id);
      root.querySelector(`[data-sp-feed='${id}']`)?.classList.add("is-done");
      const d = root.querySelector(`[data-sp-feed-detail='${id}']`);
      if (d) d.textContent = detail;
    };

    const clearFeeds = () => {
      FEEDS.forEach((f) => {
        clearFeedState(f.id);
        const d = root.querySelector(`[data-sp-feed-detail='${f.id}']`);
        if (d) d.textContent = "Idle";
      });
    };

    const clearFlags = () => {
      flags?.querySelectorAll(".sp__flag").forEach((el) => {
        el.classList.remove("is-working", "is-live");
      });
      if (flags) flags.hidden = true;
    };

    const resetBoard = () => {
      setStep("Queue idle");
      if (evalEl) evalEl.textContent = "Eval -";
      fileEl?.classList.remove("is-live", "is-accepted", "is-working");
      fileEl?.classList.add("is-empty");
      if (fileId) fileId.textContent = "Waiting for file";
      if (fileAddr) fileAddr.textContent = "";
      if (fileStatus) fileStatus.textContent = "";
      clearFeeds();
      recordEl?.classList.remove("is-working", "is-live");
      if (recordBody) {
        recordBody.textContent = "Feeds unresolved. No consolidated file yet.";
      }
      clearFlags();
      if (valuationLock) valuationLock.hidden = true;
      valuationLock?.classList.remove("is-working", "is-live");
      if (valuationLockNum) valuationLockNum.textContent = "Pending";
      if (review) review.hidden = true;
      review?.classList.remove("is-live", "is-working");
      if (reviewLabel) reviewLabel.textContent = "Analyst review";
      if (acceptBtn) {
        acceptBtn.disabled = true;
        acceptBtn.classList.remove("is-done");
        acceptBtn.textContent = "Accept";
      }
      if (metrics) metrics.hidden = true;
      if (tryPanel) tryPanel.hidden = true;
      tryVal?.classList.remove("is-working", "is-live");
      roofBtn?.classList.remove("is-pulse");
      dirty = false;
      recalcing = false;
    };

    const showTry = () => {
      if (tryPanel) tryPanel.hidden = false;
      if (metrics) metrics.hidden = false;
      roofBtn?.classList.add("is-pulse");
      if (roofBtn) roofBtn.textContent = ROOF_VALUES[0];
      if (contingencyBtn) contingencyBtn.textContent = CONTINGENCY_VALUES[0];
      if (valEl) valEl.textContent = VALUATIONS[0];
      tryVal?.classList.remove("is-working");
      tryVal?.classList.add("is-live");
      roofIdx = 0;
      contingencyIdx = 0;
      valuationIdx = 0;
      dirty = false;
      recalcing = false;
    };

    const finish = () => {
      running = false;
      setStep("Decision recorded");
      if (metrics) metrics.hidden = false;
      showTry();
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const paintFinal = () => {
      setStep("Decision recorded");
      if (evalEl) evalEl.textContent = "#4418";
      fileEl?.classList.remove("is-empty", "is-working");
      fileEl?.classList.add("is-live", "is-accepted");
      if (fileId) fileId.textContent = "#4418";
      if (fileAddr) fileAddr.textContent = "1847 Longcityname Blvd, Unit 3B";
      if (fileStatus) fileStatus.textContent = "Accepted";
      FEEDS.forEach((f) => setFeedDone(f.id, f.resolvedDetail));
      recordEl?.classList.remove("is-working");
      recordEl?.classList.add("is-live");
      if (recordBody) recordBody.textContent = RECORD_FACTS;
      if (flags) flags.hidden = false;
      flags?.querySelectorAll(".sp__flag").forEach((el) => {
        el.classList.remove("is-working");
        el.classList.add("is-live");
      });
      if (valuationLock) valuationLock.hidden = false;
      valuationLock?.classList.remove("is-working");
      valuationLock?.classList.add("is-live");
      if (valuationLockNum) valuationLockNum.textContent = VALUATIONS[0]!;
      if (review) review.hidden = false;
      review?.classList.remove("is-working");
      review?.classList.add("is-live");
      if (reviewLabel) reviewLabel.textContent = "Analyst accepted";
      if (acceptBtn) {
        acceptBtn.disabled = false;
        acceptBtn.classList.add("is-done");
        acceptBtn.textContent = "Accepted";
      }
    };

    const snapFinal = () => {
      resetBoard();
      paintFinal();
      finish();
    };

    const run = async () => {
      const my = ++token;
      running = true;
      resetBoard();

      // 1. File lands in queue
      setStep("File entering queue…");
      fileEl?.classList.remove("is-empty");
      fileEl?.classList.add("is-working");
      if (evalEl) evalEl.textContent = "#4418";
      if (fileId) fileId.textContent = "#4418";
      if (fileAddr) fileAddr.textContent = "1847 Longcityname Blvd, Unit 3B";
      if (fileStatus) fileStatus.textContent = "Inbound";
      await sleep(1600);
      if (my !== token) return;

      fileEl?.classList.remove("is-working");
      fileEl?.classList.add("is-live");
      if (fileStatus) fileStatus.textContent = "New";
      setStep("File in queue");
      await sleep(900);
      if (my !== token) return;

      // 2. Six vendor feeds: working → done, one by one
      setStep("Resolving vendor feeds");
      if (fileStatus) fileStatus.textContent = "Pulling data";
      for (const beat of FEEDS) {
        if (my !== token) return;
        setStep(beat.progressDetail);
        setFeedWorking(beat.id, beat.progressDetail);
        await sleep(beat.progressMs);
        if (my !== token) return;
        setFeedDone(beat.id, beat.resolvedDetail);
        await sleep(beat.resolveMs);
        if (my !== token) return;
      }
      setStep("Vendor feeds resolved");
      await sleep(500);
      if (my !== token) return;

      // 3. Consolidate property record with visible facts
      setStep("Consolidating record…");
      if (fileStatus) fileStatus.textContent = "Consolidating";
      recordEl?.classList.add("is-working");
      if (recordBody) recordBody.textContent = "Merging feed facts…";
      await sleep(1400);
      if (my !== token) return;

      recordEl?.classList.remove("is-working");
      recordEl?.classList.add("is-live");
      if (recordBody) recordBody.textContent = RECORD_FACTS;
      setStep("Property record locked");
      await sleep(1100);
      if (my !== token) return;

      // 4. Automation flags appear one by one
      setStep("Raising automation flags…");
      if (fileStatus) fileStatus.textContent = "Flagged";
      if (flags) flags.hidden = false;
      const flagIds = ["roof", "title", "avm"] as const;
      for (const id of flagIds) {
        if (my !== token) return;
        const el = root.querySelector(`[data-sp-flag='${id}']`);
        el?.classList.add("is-working");
        await sleep(420);
        if (my !== token) return;
        el?.classList.remove("is-working");
        el?.classList.add("is-live");
        await sleep(380);
        if (my !== token) return;
      }
      setStep("Automation flags ready");
      await sleep(600);
      if (my !== token) return;

      // 5. Valuation calculates, then locks
      setStep("Calculating valuation…");
      if (fileStatus) fileStatus.textContent = "Pricing";
      if (valuationLock) valuationLock.hidden = false;
      valuationLock?.classList.add("is-working");
      if (valuationLockNum) valuationLockNum.textContent = "…";
      await sleep(1600);
      if (my !== token) return;

      valuationLock?.classList.remove("is-working");
      valuationLock?.classList.add("is-live");
      if (valuationLockNum) valuationLockNum.textContent = VALUATIONS[0]!;
      setStep("Valuation locked");
      await sleep(900);
      if (my !== token) return;

      // 6. Accept / try panel
      setStep("Analyst review");
      if (review) review.hidden = false;
      review?.classList.add("is-live");
      if (acceptBtn) acceptBtn.disabled = false;
      await sleep(1200);
      if (my !== token) return;

      if (acceptBtn) {
        acceptBtn.classList.add("is-done");
        acceptBtn.textContent = "Accepted";
      }
      if (reviewLabel) reviewLabel.textContent = "Analyst accepted";
      fileEl?.classList.add("is-accepted");
      if (fileStatus) fileStatus.textContent = "Accepted";
      setStep("Decision recorded");
      await sleep(1000);
      if (my !== token) return;

      finish();
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        snapFinal();
        return;
      }
      void run();
    });

    frame.addEventListener("demo-replay", () => void run());

    root.querySelectorAll<HTMLButtonElement>("[data-sp-nudge]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (running || recalcing) return;
        const key = btn.getAttribute("data-sp-nudge");
        if (key === "roof") {
          roofIdx = (roofIdx + 1) % ROOF_VALUES.length;
          btn.textContent = ROOF_VALUES[roofIdx] ?? ROOF_VALUES[0]!;
        } else if (key === "contingency") {
          contingencyIdx = (contingencyIdx + 1) % CONTINGENCY_VALUES.length;
          btn.textContent = CONTINGENCY_VALUES[contingencyIdx] ?? CONTINGENCY_VALUES[0]!;
        }
        dirty = true;
        btn.classList.add("is-nudge");
        setTimeout(() => btn.classList.remove("is-nudge"), 280);
        roofBtn?.classList.remove("is-pulse");
      });
    });

    recalcBtn?.addEventListener("click", async () => {
      if (running || !dirty || recalcing) return;
      recalcing = true;
      dirty = false;
      setStep("Recalculating valuation…");
      tryVal?.classList.remove("is-live");
      tryVal?.classList.add("is-working");
      if (valEl) valEl.textContent = "…";
      valuationLock?.classList.remove("is-live");
      valuationLock?.classList.add("is-working");
      if (valuationLockNum) valuationLockNum.textContent = "…";
      recalcBtn.classList.add("is-nudge");
      await sleep(1100);
      valuationIdx = (valuationIdx + 1) % VALUATIONS.length;
      const next = VALUATIONS[valuationIdx] ?? VALUATIONS[0]!;
      if (valEl) valEl.textContent = next;
      if (valuationLockNum) valuationLockNum.textContent = next;
      tryVal?.classList.remove("is-working");
      tryVal?.classList.add("is-live");
      valuationLock?.classList.remove("is-working");
      valuationLock?.classList.add("is-live");
      setStep("Valuation updated");
      setTimeout(() => recalcBtn.classList.remove("is-nudge"), 280);
      recalcing = false;
    });

    replayBtn?.addEventListener("click", () => {
      if (running || recalcing) return;
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-sp]").forEach((el) => wireStoa(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-sp]").forEach((el) => wireStoa(el as HTMLElement));
  });
</script>

<style>
  .sp {
    --sp-copper: var(--accent, #b87333);
    --sp-ink: var(--fg, #f2ebe1);
    --sp-muted: var(--fg-muted, #8a837a);
    --sp-secondary: var(--fg-secondary, #b8afa3);
    --sp-line: var(--hairline-color, #1f1d1b);
    --sp-panel: var(--ghost-color, #2e2b28);

    height: 100%;
    padding: var(--s-4);
    display: grid;
    grid-template-rows: auto auto auto auto auto auto auto auto 1fr;
    gap: var(--s-3);
    color: var(--sp-ink);
    background:
      radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--sp-copper) 16%, transparent), transparent 48%),
      linear-gradient(180deg, color-mix(in srgb, var(--sp-panel) 55%, transparent), transparent 42%),
      var(--bg, #0b0a09);
  }

  .sp__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .sp__brand {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
  }

  .sp__product {
    color: var(--sp-copper);
  }

  .sp__queue-label {
    color: var(--sp-muted);
  }

  .sp__eval {
    color: var(--sp-secondary);
  }

  .sp__queue {
    min-height: 3.25rem;
  }

  .sp__file {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3);
    border: var(--hairline) solid var(--sp-line);
    background: color-mix(in srgb, var(--sp-panel) 70%, transparent);
    transition:
      border-color var(--dur-base, 240ms) var(--ease-out, ease-out),
      opacity var(--dur-base, 240ms) var(--ease-out, ease-out),
      box-shadow var(--dur-base, 240ms) var(--ease-out, ease-out);
  }

  .sp__file.is-empty {
    opacity: 0.45;
  }

  .sp__file.is-working {
    opacity: 1;
    border-color: color-mix(in srgb, var(--sp-copper) 55%, var(--sp-line));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sp-copper) 28%, transparent);
    animation: sp-working 1.4s ease-in-out infinite;
  }

  .sp__file.is-live {
    opacity: 1;
    border-color: color-mix(in srgb, var(--sp-copper) 55%, var(--sp-line));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sp-copper) 28%, transparent);
    animation: none;
  }

  .sp__file.is-accepted {
    border-color: var(--sp-copper);
  }

  .sp__file-id {
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--sp-copper);
  }

  .sp__file-addr {
    font-size: var(--t-body-sm);
    color: var(--sp-ink);
  }

  .sp__file-status {
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--sp-muted);
  }

  .sp__feeds {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .sp__feed {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-2);
    border: var(--hairline) solid var(--sp-line);
