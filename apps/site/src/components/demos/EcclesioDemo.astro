---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="ecclesio-demo"
  aspect="16 / 10"
  system="Users → application → data → action"
  cta="Open the church dashboard we shipped to invite-only beta."
  caption="Interactive walkthrough · Ecclesio invite-only beta"
>
  <div class="ec" data-ec>
    <aside class="ec__side" aria-label="App navigation">
      <div class="ec__logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <nav class="ec__nav">
        <button type="button" class="ec__nav-btn is-active" aria-label="Dashboard" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </button>
        <button type="button" class="ec__nav-btn" aria-label="Members" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </button>
        <button type="button" class="ec__nav-btn" aria-label="Events" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
            <path d="M16 2v4M8 2v4M3 10h18"></path>
          </svg>
        </button>
        <button type="button" class="ec__nav-btn" aria-label="Messages" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
        <button type="button" class="ec__nav-btn" aria-label="Analytics" disabled>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M18 20V10M12 20V4M6 20v-6"></path>
          </svg>
        </button>
      </nav>
    </aside>

    <div class="ec__main">
      <header class="ec__bar">
        <div class="ec__brand">
          <h3 class="ec__title">Ecclesio</h3>
          <p class="ec__sub" data-ec-status>Opening dashboard</p>
        </div>
        <div class="ec__controls">
          <label class="ec__campus-wrap" data-ec-pulse>
            <span class="ec__sr">Campus location</span>
            <svg class="ec__pin" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <select class="ec__select" data-ec-campus aria-label="Campus location" disabled>
              <option value="all">All Locations</option>
              <option value="downtown">Downtown</option>
              <option value="north">North Campus</option>
              <option value="west">West Side</option>
              <option value="east">East Valley</option>
            </select>
          </label>
          <span class="ec__mode-tag" data-ec-mode>Staff</span>
        </div>
      </header>

      <div class="ec__modes" role="group" aria-label="Insight mode">
        <button type="button" class="ec__mode" data-ec-view="assimilation" disabled>Assimilation</button>
        <button type="button" class="ec__mode" data-ec-view="memberCare" disabled>Member Care</button>
        <button type="button" class="ec__mode is-active" data-ec-view="both" disabled>Both</button>
      </div>

      <div class="ec__grid">
        <section class="ec__panel ec__panel--insights" data-ec-panel="stats" aria-label="Member insights">
          <header class="ec__panel-head">
            <div>
              <h4 class="ec__panel-title" data-ec-insights-title>Member & Guest Insights</h4>
              <p class="ec__panel-sub">Real-time analytics from app engagement</p>
            </div>
          </header>
          <div class="ec__stats" data-ec-stats>
            <article class="ec__stat" data-ec-stat="members" style="--ec-accent: #818cf8">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              <span class="ec__stat-label">Total Members</span>
              <strong class="ec__stat-val" data-ec-val="members">…</strong>
              <span class="ec__stat-delta is-up">+12.5% vs last month</span>
            </article>
            <article class="ec__stat" data-ec-stat="new" style="--ec-accent: #a78bfa">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M19 8v6M22 11h-6"></path>
                </svg>
              </span>
              <span class="ec__stat-label">New This Month</span>
              <strong class="ec__stat-val" data-ec-val="new">…</strong>
              <span class="ec__stat-delta is-up">+8.3% vs last month</span>
            </article>
            <article class="ec__stat" data-ec-stat="engagement" style="--ec-accent: #f472b6">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
                </svg>
              </span>
              <span class="ec__stat-label">Active Engagement</span>
              <strong class="ec__stat-val" data-ec-val="engagement">…</strong>
              <span class="ec__stat-delta is-up">+3.2% vs last month</span>
            </article>
            <article class="ec__stat" data-ec-stat="guests" style="--ec-accent: #22d3ee">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </span>
              <span class="ec__stat-label">First Time Guests</span>
              <strong class="ec__stat-val" data-ec-val="guests">…</strong>
              <span class="ec__stat-delta is-up">+15.7% vs last month</span>
            </article>
            <article class="ec__stat" data-ec-stat="attendance" style="--ec-accent: #34d399">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
              </span>
              <span class="ec__stat-label">Avg Attendance</span>
              <strong class="ec__stat-val" data-ec-val="attendance">…</strong>
              <span class="ec__stat-delta is-up">+5.1% vs last month</span>
            </article>
            <article class="ec__stat" data-ec-stat="followups" style="--ec-accent: #fbbf24">
              <span class="ec__stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              </span>
              <span class="ec__stat-label">Follow-ups Needed</span>
              <strong class="ec__stat-val" data-ec-val="followups">…</strong>
              <span class="ec__stat-delta is-down">-12.3% vs last month</span>
            </article>
          </div>
        </section>

        <section class="ec__panel ec__panel--health" data-ec-panel="health" aria-label="Church health score">
          <header class="ec__panel-head ec__panel-head--row">
            <div>
              <h4 class="ec__panel-title">Church Health Score</h4>
              <p class="ec__panel-sub">Labeled as demo data</p>
            </div>
            <div class="ec__health-score" data-ec-health-score>
              <span class="ec__health-dot" aria-hidden="true"></span>
              <strong data-ec-val="health">…</strong>
            </div>
          </header>
          <div class="ec__chart" data-ec-chart>
            <svg class="ec__chart-svg" viewBox="0 0 280 88" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="ec-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#ff1493" stop-opacity="0.45"></stop>
                  <stop offset="55%" stop-color="#8b2f8f" stop-opacity="0.18"></stop>
                  <stop offset="100%" stop-color="#0a0118" stop-opacity="0.05"></stop>
                </linearGradient>
              </defs>
              <g class="ec__chart-grid" stroke="rgba(255,255,255,0.06)" stroke-width="1">
                <line x1="0" y1="22" x2="280" y2="22"></line>
                <line x1="0" y1="44" x2="280" y2="44"></line>
                <line x1="0" y1="66" x2="280" y2="66"></line>
              </g>
              <path
                class="ec__chart-area"
                data-ec-area
                fill="url(#ec-fill)"
                d="M0 70 L18 62 L36 66 L54 48 L72 55 L90 38 L108 44 L126 30 L144 36 L162 24 L180 28 L198 18 L216 22 L234 14 L252 20 L280 12 L280 88 L0 88 Z"
              ></path>
              <path
                class="ec__chart-line"
                data-ec-line
                fill="none"
                stroke="#ff1493"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M0 70 L18 62 L36 66 L54 48 L72 55 L90 38 L108 44 L126 30 L144 36 L162 24 L180 28 L198 18 L216 22 L234 14 L252 20 L280 12"
              ></path>
              <circle class="ec__chart-dot" data-ec-dot cx="280" cy="12" r="4.5" fill="#ff1493"></circle>
            </svg>
            <div class="ec__chart-axis">
              <span>Day 1</span>
              <span>Day 10</span>
              <span>Day 21</span>
            </div>
          </div>
        </section>

        <section class="ec__panel ec__panel--actions" data-ec-panel="insights" aria-label="Actionable insights">
          <header class="ec__panel-head">
            <h4 class="ec__panel-title">Actionable Insights</h4>
            <span class="ec__panel-meta" data-ec-insight-meta>…</span>
          </header>
          <ul class="ec__insights" data-ec-insights>
            <li class="ec__insight" data-ec-insight="0" data-tone="amber">
              <span class="ec__insight-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                  <path d="M12 9v4M12 17h.01"></path>
                </svg>
              </span>
              <div class="ec__insight-body">
                <p class="ec__insight-title" data-ec-insight-title="0">12 members need immediate follow-up</p>
                <p class="ec__insight-sub">Have not been contacted in 3+ weeks</p>
              </div>
              <button type="button" class="ec__insight-btn" data-ec-pick="0" disabled>View</button>
            </li>
            <li class="ec__insight" data-ec-insight="1" data-tone="purple">
              <span class="ec__insight-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              <div class="ec__insight-body">
                <p class="ec__insight-title" data-ec-insight-title="1">23 first-time guests to welcome</p>
                <p class="ec__insight-sub">From last Sunday service</p>
              </div>
              <button type="button" class="ec__insight-btn" data-ec-pick="1" disabled>View</button>
            </li>
            <li class="ec__insight" data-ec-insight="2" data-tone="pink">
              <span class="ec__insight-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
                </svg>
              </span>
              <div class="ec__insight-body">
                <p class="ec__insight-title" data-ec-insight-title="2">8 members ready for next step</p>
                <p class="ec__insight-sub">High engagement, invite to serve</p>
              </div>
              <button type="button" class="ec__insight-btn" data-ec-pick="2" disabled>View</button>
            </li>
          </ul>
          <p class="ec__picked" data-ec-picked hidden>Follow-up queued for staff.</p>
        </section>
      </div>

      <footer class="ec__foot">
        <span class="ec__demo-note">Demo data · invite-only beta</span>
        <button type="button" class="ec__replay" data-ec-replay hidden>Replay</button>
      </footer>
    </div>
  </div>
</DemoFrame>

<script>
  type EcCampus = "all" | "downtown" | "north" | "west" | "east";
  type EcView = "assimilation" | "memberCare" | "both";

  type EcSnapshot = {
    members: string;
    new: string;
    engagement: string;
    guests: string;
    attendance: string;
    followups: string;
    health: string;
    insights: [string, string, string];
  };

  const BASE: Record<EcCampus, EcSnapshot> = {
    all: {
      members: "2,847",
      new: "143",
      engagement: "87%",
      guests: "89",
      attendance: "1,234",
      followups: "47",
      health: "76%",
      insights: [
        "12 members need immediate follow-up",
        "23 first-time guests to welcome",
        "8 members ready for next step",
      ],
    },
    downtown: {
      members: "741",
      new: "39",
      engagement: "82%",
      guests: "28",
      attendance: "412",
      followups: "14",
      health: "72%",
      insights: [
        "4 members need immediate follow-up",
        "9 first-time guests to welcome",
        "3 members ready for next step",
      ],
    },
    north: {
      members: "912",
      new: "48",
      engagement: "91%",
      guests: "31",
      attendance: "486",
      followups: "11",
      health: "81%",
      insights: [
        "3 members need immediate follow-up",
        "7 first-time guests to welcome",
        "2 members ready for next step",
      ],
    },
    west: {
      members: "684",
      new: "31",
      engagement: "85%",
      guests: "18",
      attendance: "198",
      followups: "9",
      health: "78%",
      insights: [
        "2 members need immediate follow-up",
        "4 first-time guests to welcome",
        "2 members ready for next step",
      ],
    },
    east: {
      members: "510",
      new: "25",
      engagement: "88%",
      guests: "12",
      attendance: "138",
      followups: "6",
      health: "83%",
      insights: [
        "1 member needs immediate follow-up",
        "3 first-time guests to welcome",
        "1 member ready for next step",
      ],
    },
  };

  const VIEW_LABEL: Record<EcView, string> = {
    assimilation: "Guest Insights",
    memberCare: "Member Insights",
    both: "Member & Guest Insights",
  };

  const VIEW_SCALE: Record<EcView, number> = {
    assimilation: 0.6,
    memberCare: 0.4,
    both: 1,
  };

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function scaleInt(raw: string, scale: number) {
    const n = Number(raw.replace(/,/g, ""));
    return Math.max(1, Math.round(n * scale)).toLocaleString("en-US");
  }

  function scaleInsight(text: string, scale: number) {
    return text.replace(/\d+/, (m) => String(Math.max(1, Math.round(Number(m) * scale))));
  }

  function wireEcclesio(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-ec-wired")) return;
    frame.setAttribute("data-ec-wired", "true");

    const status = root.querySelector<HTMLElement>("[data-ec-status]");
    const mode = root.querySelector<HTMLElement>("[data-ec-mode]");
    const statsEl = root.querySelector<HTMLElement>("[data-ec-stats]");
    const healthPanel = root.querySelector<HTMLElement>("[data-ec-panel='health']");
    const insightsPanel = root.querySelector<HTMLElement>("[data-ec-panel='insights']");
    const statsPanel = root.querySelector<HTMLElement>("[data-ec-panel='stats']");
    const chart = root.querySelector<HTMLElement>("[data-ec-chart]");
    const line = root.querySelector<SVGPathElement>("[data-ec-line]");
    const area = root.querySelector<SVGPathElement>("[data-ec-area]");
    const dot = root.querySelector<SVGCircleElement>("[data-ec-dot]");
    const healthScore = root.querySelector<HTMLElement>("[data-ec-health-score]");
    const insightsTitle = root.querySelector<HTMLElement>("[data-ec-insights-title]");
    const insightMeta = root.querySelector<HTMLElement>("[data-ec-insight-meta]");
    const picked = root.querySelector<HTMLElement>("[data-ec-picked]");
    const campus = root.querySelector<HTMLSelectElement>("[data-ec-campus]");
    const pulseWrap = root.querySelector<HTMLElement>("[data-ec-pulse]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-ec-replay]");
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ec-view]"));
    const insightEls = Array.from(root.querySelectorAll<HTMLElement>("[data-ec-insight]"));
    const pickBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ec-pick]"));
    const vals = {
      members: root.querySelector("[data-ec-val='members']"),
      new: root.querySelector("[data-ec-val='new']"),
      engagement: root.querySelector("[data-ec-val='engagement']"),
      guests: root.querySelector("[data-ec-val='guests']"),
      attendance: root.querySelector("[data-ec-val='attendance']"),
      followups: root.querySelector("[data-ec-val='followups']"),
      health: root.querySelector("[data-ec-val='health']"),
    };

    let running = false;
    let token = 0;
    let interactive = false;
    let filterBusy = false;
    let campusKey: EcCampus = "all";
    let view: EcView = "both";
    let selectedInsight = -1;

    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };

    const clearWorkingLive = (...els: (HTMLElement | null | undefined)[]) => {
      els.forEach((el) => el?.classList.remove("is-working", "is-live"));
    };

    const setWorking = (el: HTMLElement | null | undefined) => {
      if (!el) return;
      el.classList.remove("is-live");
      el.classList.add("is-working");
    };

    const setLive = (el: HTMLElement | null | undefined) => {
      if (!el) return;
      el.classList.remove("is-working");
      el.classList.add("is-live");
    };

    const blankStats = () => {
      Object.values(vals).forEach((el) => {
        if (el) el.textContent = "…";
      });
      if (insightMeta) insightMeta.textContent = "…";
    };

    const snapshotFor = (): EcSnapshot => {
      const base = BASE[campusKey];
      const scale = VIEW_SCALE[view];
      if (scale === 1) return base;
      return {
        members: scaleInt(base.members, scale),
        new: scaleInt(base.new, scale),
        engagement: base.engagement,
        guests: scaleInt(base.guests, scale),
        attendance: scaleInt(base.attendance, scale),
        followups: scaleInt(base.followups, scale),
        health: base.health,
        insights: [
          scaleInsight(base.insights[0], scale),
          scaleInsight(base.insights[1], scale),
          scaleInsight(base.insights[2], scale),
        ],
      };
    };

    const applySnapshot = (snap: EcSnapshot) => {
      if (vals.members) vals.members.textContent = snap.members;
      if (vals.new) vals.new.textContent = snap.new;
      if (vals.engagement) vals.engagement.textContent = snap.engagement;
      if (vals.guests) vals.guests.textContent = snap.guests;
      if (vals.attendance) vals.attendance.textContent = snap.attendance;
      if (vals.followups) vals.followups.textContent = snap.followups;
      if (vals.health) vals.health.textContent = snap.health;
      snap.insights.forEach((text, i) => {
        const title = root.querySelector(`[data-ec-insight-title="${i}"]`);
        if (title) title.textContent = text;
      });
      if (insightMeta) insightMeta.textContent = `${snap.followups} open`;
      if (insightsTitle) insightsTitle.textContent = VIEW_LABEL[view];
    };

    const resetChart = () => {
      chart?.classList.remove("is-drawn");
      line?.classList.remove("is-drawn");
      area?.classList.remove("is-drawn");
      dot?.classList.remove("is-drawn");
    };

    const drawChart = () => {
      chart?.classList.add("is-drawn");
      line?.classList.add("is-drawn");
      area?.classList.add("is-drawn");
      dot?.classList.add("is-drawn");
    };

    const clearHighlights = () => {
      clearWorkingLive(
        statsEl,
        statsPanel,
        healthPanel,
        insightsPanel,
        chart,
        healthScore,
        status,
        picked,
      );
      insightEls.forEach((el) => el.classList.remove("is-working", "is-live", "is-active", "is-done"));
      pickBtns.forEach((b) => b.classList.remove("is-press"));
      root.classList.remove("is-try", "is-reveal");
      pulseWrap?.classList.remove("is-pulse");
      resetChart();
    };

    const setControlsEnabled = (on: boolean) => {
      interactive = on;
      if (campus) campus.disabled = !on;
      viewBtns.forEach((b) => {
        b.disabled = !on;
      });
      pickBtns.forEach((b) => {
        b.disabled = !on;
      });
    };

    const resetBoard = () => {
      campusKey = "all";
      view = "both";
      selectedInsight = -1;
      if (campus) campus.value = "all";
      viewBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.ecView === "both");
      });
      clearHighlights();
      setControlsEnabled(false);
      blankStats();
      if (picked) picked.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      if (mode) mode.textContent = "Staff";
      if (insightsTitle) insightsTitle.textContent = VIEW_LABEL.both;
      setStatus("Opening dashboard");
      root.dataset.ecPhase = "idle";
    };

    const paintFinal = () => {
      applySnapshot(snapshotFor());
      setLive(statsEl);
      setLive(statsPanel);
      setLive(healthPanel);
      setLive(healthScore);
      drawChart();
      setLive(chart);
      setLive(insightsPanel);
      insightEls.forEach((el, i) => {
        el.classList.remove("is-working");
        el.classList.add("is-live");
        if (i === 0) el.classList.add("is-done", "is-active");
      });
      if (picked) {
        picked.hidden = false;
        setLive(picked);
      }
      setStatus("Follow-up queued for staff");
    };

    const finishTry = () => {
      running = false;
      setControlsEnabled(true);
      root.classList.add("is-try", "is-reveal");
      pulseWrap?.classList.add("is-pulse");
      if (replayBtn) replayBtn.hidden = false;
      if (mode) mode.textContent = "Try";
      setStatus("Try it: change campus or pick a follow-up");
      root.dataset.ecPhase = "try";
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const runFilterUpdate = async (label: string) => {
      if (filterBusy) return;
      filterBusy = true;
      const my = ++token;
      setStatus(label);
      setWorking(statsEl);
      blankStats();
      await sleep(1280);
      if (my !== token) {
        filterBusy = false;
        return;
      }
      applySnapshot(snapshotFor());
      setLive(statsEl);
      setLive(insightsPanel);
      setStatus(`${label} · updated`);
      await sleep(220);
      filterBusy = false;
    };

    const run = async () => {
      const my = ++token;
      running = true;
      resetBoard();
      root.dataset.ecPhase = "walk";
      root.classList.add("is-reveal");

      setStatus("Loading Ecclesio dashboard…");
      setWorking(status);
      await sleep(1700);
      if (my !== token) return;
      setLive(status);

      setStatus("Calculating member insights…");
      setWorking(statsPanel);
      setWorking(statsEl);
      blankStats();
      await sleep(1900);
      if (my !== token) return;
      applySnapshot(BASE.all);
      setLive(statsEl);
      setLive(statsPanel);
      setStatus("Stats loaded");
      await sleep(1300);
      if (my !== token) return;

      setStatus("Drawing health score…");
      setWorking(healthPanel);
      setWorking(healthScore);
      resetChart();
      await sleep(1200);
      if (my !== token) return;
      if (vals.health) vals.health.textContent = "76%";
      drawChart();
      setLive(chart);
      setLive(healthScore);
      setLive(healthPanel);
      setStatus("Health score ready (demo data)");
      await sleep(1700);
      if (my !== token) return;

      setStatus("Surfacing actionable insights…");
      setWorking(insightsPanel);
      for (let i = 0; i < insightEls.length; i++) {
        if (my !== token) return;
        setWorking(insightEls[i]);
        await sleep(320);
        if (my !== token) return;
        setLive(insightEls[i]);
      }
      setLive(insightsPanel);
      if (insightMeta) insightMeta.textContent = "47 open";
      setStatus("Insights ready");
      await sleep(1250);
      if (my !== token) return;

      setStatus("Picking a follow-up…");
      insightEls[0]?.classList.remove("is-live");
      insightEls[0]?.classList.add("is-active", "is-working");
      pickBtns[0]?.classList.add("is-press");
      await sleep(1500);
      if (my !== token) return;
      selectedInsight = 0;
      insightEls[0]?.classList.remove("is-working");
      insightEls[0]?.classList.add("is-done", "is-live", "is-active");
      if (picked) {
        picked.hidden = false;
        setLive(picked);
      }
      setStatus("Follow-up queued for staff");
      await sleep(1500);
      if (my !== token) return;

      paintFinal();
      finishTry();
    };

    const onPick = (index: number) => {
      if (!interactive || running || filterBusy) return;
      selectedInsight = index;
      insightEls.forEach((el, i) => {
        el.classList.toggle("is-active", i === index);
        el.classList.toggle("is-done", i === index);
      });
      if (picked) {
        picked.hidden = false;
        picked.textContent = "Follow-up queued for staff.";
        setLive(picked);
      }
      setStatus("Follow-up selected");
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        resetBoard();
        paintFinal();
        finishTry();
        return;
      }
      void run();
    });
    frame.addEventListener("demo-replay", () => void run());

    campus?.addEventListener("change", () => {
      if (!interactive || running) return;
      campusKey = (campus.value as EcCampus) || "all";
      pulseWrap?.classList.remove("is-pulse");
      const label = campus.selectedOptions[0]?.textContent?.trim() || campusKey;
      void runFilterUpdate(`Loading ${label}`);
    });

    viewBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!interactive || running) return;
        const next = (btn.dataset.ecView as EcView) || "both";
        view = next;
        viewBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        void runFilterUpdate(`Loading ${VIEW_LABEL[next]}`);
      });
    });

    pickBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = Number(btn.dataset.ecPick);
        if (Number.isFinite(idx)) onPick(idx);
      });
    });

    replayBtn?.addEventListener("click", () => {
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });

    void selectedInsight;
  }

  document.querySelectorAll("[data-ec]").forEach((el) => wireEcclesio(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-ec]").forEach((el) => wireEcclesio(el as HTMLElement));
  });
</script>

