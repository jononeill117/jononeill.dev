---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame class="zillow-demo" aspect="16 / 11">
  <div class="zl" data-zl>
    <div class="zl__layout">
      <aside class="zl__sql">
        <p class="zl__sql-label">Query</p>
        <pre class="zl__sql-code">SELECT address, model_est, human_est
FROM lakeview_queue
WHERE status = 'pending'
LIMIT 5;</pre>
      </aside>
      <main class="zl__main">
        <header class="zl__head">
          <h4 class="zl__title">Lakeview Estimate</h4>
          <span class="zl__vol">~10 / day</span>
        </header>
        <svg class="zl__spark" viewBox="0 0 120 28" aria-hidden="true">
          <polyline
            points="0,22 12,18 24,20 36,14 48,16 60,10 72,12 84,8 96,11 108,6 120,9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></polyline>
        </svg>
        <ul class="zl__queue" role="list">
          <li>
            <button type="button" class="zl__row is-active" data-zl-row>
              <span>142 Harbor Ln</span>
              <span class="zl__model">$318,400</span>
              <span class="zl__human">$322,100</span>
            </button>
          </li>
          <li>
            <button type="button" class="zl__row" data-zl-row>
              <span>55 Ridge Ct</span>
              <span class="zl__model">$445,200</span>
              <span class="zl__human">$441,800</span>
            </button>
          </li>
          <li>
            <button type="button" class="zl__row" data-zl-row>
              <span>901 Willow St</span>
              <span class="zl__model">$267,900</span>
              <span class="zl__human">$271,500</span>
            </button>
          </li>
        </ul>
        <p class="zl__detail" data-zl-detail>
          Model vs human delta: $3,700 (1.2%)
        </p>
      </main>
    </div>
  </div>
</DemoFrame>

<script>
  function wireZillow(root: HTMLElement) {
    if (root.hasAttribute("data-zl-wired")) return;
    root.setAttribute("data-zl-wired", "true");

    const detail = root.querySelector("[data-zl-detail]");
    const rows = root.querySelectorAll<HTMLButtonElement>("[data-zl-row]");

    const deltas: Record<number, string> = {
      0: "Model vs human delta: $3,700 (1.2%)",
      1: "Model vs human delta: -$3,400 (-0.8%)",
      2: "Model vs human delta: $3,600 (1.3%)",
    };

    rows.forEach((row, i) => {
      row.addEventListener("click", () => {
        rows.forEach((r) => r.classList.toggle("is-active", r === row));
        if (detail) detail.textContent = deltas[i] ?? deltas[0];
      });
    });
  }

  document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  });
</script>

<style>
  .zl {
    height: 100%;
    background: #12181f;
    color: #d4dce6;
  }

  .zl__layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    height: 100%;
  }

  @media (max-width: 30rem) {
    .zl__layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
  }

  .zl__sql {
    padding: var(--s-3);
    background: #0a0e12;
    border-inline-end: var(--hairline) solid #243040;
  }

  .zl__sql-label {
    margin: 0 0 var(--s-2);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: #5a7a94;
  }

  .zl__sql-code {
    margin: 0;
    font-family: var(--font-mono, var(--font-label));
    font-size: 0.65rem;
    line-height: 1.5;
    color: #6ee7b7;
    white-space: pre-wrap;
  }

  .zl__main {
    padding: var(--s-3);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
  }

  .zl__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .zl__title {
    margin: 0;
    font-size: var(--t-body);
    font-weight: var(--fw-semibold);
    color: #7eb8da;
  }

  .zl__vol {
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    color: #6b7d8c;
  }

  .zl__spark {
    width: 100%;
    height: 1.75rem;
    color: #3d8fd1;
  }

  .zl__queue {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: auto;
  }

  .zl__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: var(--s-2);
    width: 100%;
    padding: var(--s-2);
    border: 0;
    border-block-end: var(--hairline) solid #243040;
    background: transparent;
    color: inherit;
    font-size: var(--t-mono-sm);
    text-align: left;
    cursor: pointer;
  }

  .zl__row.is-active {
    background: #1a2836;
  }

  .zl__model {
    color: #6ee7b7;
  }

  .zl__human {
    color: #fbbf24;
  }

  .zl__detail {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    color: #8b9aab;
  }
</style>
