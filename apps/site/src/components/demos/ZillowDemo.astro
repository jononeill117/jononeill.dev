---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="zillow-demo"
  system="Data → model → acquisition"
  cta="Watch a pricing queue: model estimate vs human."
  caption="Interactive walkthrough"
>
  <div class="zl" data-zl>
    <header class="zl__head">
      <div class="zl__title-row">
        <h4 class="zl__title">Pricing queue</h4>
        <span class="zl__chip" data-zl-chip hidden>~10 / day</span>
      </div>
      <span class="zl__kicker" data-zl-step>Ready</span>
    </header>

    <div class="zl__table" role="table" aria-label="Pricing queue">
      <div class="zl__cols" role="row">
        <span role="columnheader">Address</span>
        <span role="columnheader">Model</span>
        <span role="columnheader">Human</span>
        <span role="columnheader">Delta</span>
        <span role="columnheader">Status</span>
      </div>
      <ul class="zl__rows" role="rowgroup" data-zl-rows>
        <li role="row">
          <button type="button" class="zl__row" data-zl-row="0">
            <span class="zl__addr">142 Harbor Ln</span>
            <span class="zl__model" data-zl-model>-</span>
            <span class="zl__human" data-zl-human>-</span>
            <span class="zl__delta" data-zl-delta>-</span>
            <span class="zl__status" data-zl-status>Pending</span>
          </button>
        </li>
        <li role="row">
          <button type="button" class="zl__row" data-zl-row="1">
            <span class="zl__addr">55 Ridge Ct</span>
            <span class="zl__model" data-zl-model>-</span>
            <span class="zl__human" data-zl-human>-</span>
            <span class="zl__delta" data-zl-delta>-</span>
            <span class="zl__status" data-zl-status>Pending</span>
          </button>
        </li>
        <li role="row">
          <button type="button" class="zl__row" data-zl-row="2">
            <span class="zl__addr">901 Willow St</span>
            <span class="zl__model" data-zl-model>-</span>
            <span class="zl__human" data-zl-human>-</span>
            <span class="zl__delta" data-zl-delta>-</span>
            <span class="zl__status" data-zl-status>Pending</span>
          </button>
        </li>
        <li role="row">
          <button type="button" class="zl__row" data-zl-row="3">
            <span class="zl__addr">18 Oak Grove</span>
            <span class="zl__model" data-zl-model>-</span>
            <span class="zl__human" data-zl-human>-</span>
            <span class="zl__delta" data-zl-delta>-</span>
            <span class="zl__status" data-zl-status>Pending</span>
          </button>
        </li>
        <li role="row">
          <button type="button" class="zl__row" data-zl-row="4">
            <span class="zl__addr">770 Pine Ave</span>
            <span class="zl__model" data-zl-model>-</span>
            <span class="zl__human" data-zl-human>-</span>
            <span class="zl__delta" data-zl-delta>-</span>
            <span class="zl__status" data-zl-status>Pending</span>
          </button>
        </li>
      </ul>
    </div>

    <p class="zl__detail" data-zl-detail>Select a row after the walkthrough.</p>

    <details class="zl__sql">
      <summary class="zl__sql-summary">Queue query</summary>
      <pre class="zl__sql-code">SELECT address, model_est, human_est, delta_pct
FROM pricing_queue
WHERE status = 'pending'
ORDER BY created_at
LIMIT 5;</pre>
    </details>

    <div class="zl__actions">
      <p class="zl__hint" data-zl-hint hidden>Now explore it yourself.</p>
      <button type="button" class="zl__btn zl__btn--pulse" data-zl-try hidden>
        Select a row
      </button>
      <button type="button" class="zl__btn" data-zl-replay hidden>Replay</button>
    </div>
  </div>
</DemoFrame>

<script>
  type ZlRow = {
    address: string;
    model: string;
    human: string;
    delta: string;
    deltaNote: string;
  };

  const ROWS: ZlRow[] = [
    {
      address: "142 Harbor Ln",
      model: "$318,400",
      human: "$322,100",
      delta: "+1.2%",
      deltaNote: "Model vs human: $3,700 (1.2%)",
    },
    {
      address: "55 Ridge Ct",
      model: "$445,200",
      human: "$441,800",
      delta: "-0.8%",
      deltaNote: "Model vs human: $3,400 (0.8%)",
    },
    {
      address: "901 Willow St",
      model: "$267,900",
      human: "$271,500",
      delta: "+1.3%",
      deltaNote: "Model vs human: $3,600 (1.3%)",
    },
    {
      address: "18 Oak Grove",
      model: "$512,000",
      human: "$518,400",
      delta: "+1.2%",
      deltaNote: "Model vs human: $6,400 (1.2%)",
    },
    {
      address: "770 Pine Ave",
      model: "$389,100",
      human: "$385,200",
      delta: "-1.0%",
      deltaNote: "Model vs human: $3,900 (1.0%)",
    },
  ];

  const WALK_INDEX = 0;
  const EMPTY = "-";
  const CALC = "…";

  /** Full walkthrough target: ≥10s */
  const PENDING_MS = 1900;
  const MODEL_PROGRESS_MS = 2600;
  const MODEL_RESOLVE_MS = 1500;
  const HUMAN_PROGRESS_MS = 2600;
  const HUMAN_RESOLVE_MS = 1500;
  const DELTA_PROGRESS_MS = 2200;
  const DELTA_RESOLVE_MS = 1500;
  const ACCEPT_MS = 1700;
  const CHIP_MS = 1700;

  /** Faster beats for try-mode row resolve */
  const TRY_PENDING_MS = 400;
  const TRY_MODEL_PROGRESS_MS = 900;
  const TRY_MODEL_RESOLVE_MS = 350;
  const TRY_HUMAN_PROGRESS_MS = 900;
  const TRY_HUMAN_RESOLVE_MS = 350;
  const TRY_DELTA_PROGRESS_MS = 700;
  const TRY_DELTA_RESOLVE_MS = 350;
  const TRY_ACCEPT_MS = 400;

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireZillow(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-zl-wired")) return;
    frame.setAttribute("data-zl-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-zl-step]");
    const chipEl = root.querySelector<HTMLElement>("[data-zl-chip]");
    const detail = root.querySelector<HTMLElement>("[data-zl-detail]");
    const tryBtn = root.querySelector<HTMLButtonElement>("[data-zl-try]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-zl-replay]");
    const hint = root.querySelector<HTMLElement>("[data-zl-hint]");
    const rowBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-zl-row]"));

    let running = false;
    let token = 0;
    let tryMode = false;

    type RowEls = {
      btn: HTMLElement;
      model: Element | null;
      human: Element | null;
      delta: Element | null;
      status: Element | null;
    };

    const rowEls = (index: number): RowEls | null => {
      const btn = root.querySelector<HTMLElement>(`[data-zl-row='${index}']`);
      if (!btn) return null;
      return {
        btn,
        model: btn.querySelector("[data-zl-model]"),
        human: btn.querySelector("[data-zl-human]"),
        delta: btn.querySelector("[data-zl-delta]"),
        status: btn.querySelector("[data-zl-status]"),
      };
    };

    const clearRowState = (els: RowEls) => {
      els.btn.classList.remove("is-working", "is-live", "is-accepted", "is-active");
      els.model?.classList.remove("is-working", "is-live");
      els.human?.classList.remove("is-working", "is-live");
      els.delta?.classList.remove("is-working", "is-live");
    };

    const clearSelection = () => {
      rowBtns.forEach((r) => r.classList.remove("is-active"));
    };

    const resetRowValues = (els: RowEls) => {
      if (els.model) els.model.textContent = EMPTY;
      if (els.human) els.human.textContent = EMPTY;
      if (els.delta) els.delta.textContent = EMPTY;
      if (els.status) els.status.textContent = "Pending";
      clearRowState(els);
    };

    const resetBoard = () => {
      ROWS.forEach((_, i) => {
        const els = rowEls(i);
        if (!els) return;
        resetRowValues(els);
      });
      if (chipEl) chipEl.hidden = true;
      if (stepEl) stepEl.textContent = "Ready";
      if (detail) detail.textContent = "Select a row after the walkthrough.";
      if (tryBtn) tryBtn.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      if (hint) hint.hidden = true;
      tryBtn?.classList.remove("is-pulse");
      tryMode = false;
    };

    const paintRowFinal = (index: number) => {
      const data = ROWS[index];
      const els = rowEls(index);
      if (!data || !els) return;
      clearRowState(els);
      if (els.model) {
        els.model.textContent = data.model;
        els.model.classList.add("is-live");
      }
      if (els.human) {
        els.human.textContent = data.human;
        els.human.classList.add("is-live");
      }
      if (els.delta) {
        els.delta.textContent = data.delta;
        els.delta.classList.add("is-live");
      }
      if (els.status) els.status.textContent = "Accepted";
      els.btn.classList.add("is-live", "is-accepted");
    };

    const finish = () => {
      running = false;
      tryMode = true;
      if (chipEl) chipEl.hidden = false;
      if (stepEl) stepEl.textContent = "Accepted";
      if (detail) {
        detail.textContent = "Delta within tolerance · Accepted";
      }
      clearSelection();
      rowEls(WALK_INDEX)?.btn.classList.add("is-active");
      if (tryBtn) tryBtn.hidden = false;
      if (replayBtn) replayBtn.hidden = false;
      if (hint) hint.hidden = false;
      tryBtn?.classList.add("is-pulse");
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    type ResolveTiming = {
      pendingMs: number;
      modelProgressMs: number;
      modelResolveMs: number;
      humanProgressMs: number;
      humanResolveMs: number;
      deltaProgressMs: number;
      deltaResolveMs: number;
      acceptMs: number;
    };

    const resolveRow = async (
      index: number,
      my: number,
      timing: ResolveTiming,
      opts: { announce: boolean; activate: boolean },
    ): Promise<boolean> => {
      const data = ROWS[index];
      const els = rowEls(index);
      if (!data || !els) return false;

      resetRowValues(els);
      if (opts.activate) {
        clearSelection();
        els.btn.classList.add("is-active");
      }
      els.btn.classList.add("is-working");
      if (els.status) els.status.textContent = "Pending";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Pending";
        if (detail) detail.textContent = `${data.address} waiting on model`;
      }
      await sleep(timing.pendingMs);
      if (my !== token) return false;

      // Model estimating
      els.model?.classList.add("is-working");
      if (els.model) els.model.textContent = CALC;
      if (els.status) els.status.textContent = "Model";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Model estimating…";
        if (detail) detail.textContent = "Model estimating…";
      } else if (detail) {
        detail.textContent = "Model estimating…";
      }
      await sleep(timing.modelProgressMs);
      if (my !== token) return false;

      els.model?.classList.remove("is-working");
      els.model?.classList.add("is-live");
      if (els.model) els.model.textContent = data.model;
      if (opts.announce && stepEl) stepEl.textContent = "Model locked";
      if (detail) detail.textContent = `Model estimate ${data.model}`;
      await sleep(timing.modelResolveMs);
      if (my !== token) return false;

      // Human / analyst reviewing
      els.human?.classList.add("is-working");
      if (els.human) els.human.textContent = CALC;
      if (els.status) els.status.textContent = "Human";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Analyst reviewing…";
      }
      if (detail) detail.textContent = "Analyst reviewing…";
      await sleep(timing.humanProgressMs);
      if (my !== token) return false;

      els.human?.classList.remove("is-working");
      els.human?.classList.add("is-live");
      if (els.human) els.human.textContent = data.human;
      if (opts.announce && stepEl) stepEl.textContent = "Human locked";
      if (detail) detail.textContent = `Human estimate ${data.human}`;
      await sleep(timing.humanResolveMs);
      if (my !== token) return false;

      // Delta
      els.delta?.classList.add("is-working");
      if (els.delta) els.delta.textContent = CALC;
      if (els.status) els.status.textContent = "Delta";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Comparing…";
      }
      if (detail) detail.textContent = "Comparing model vs human…";
      await sleep(timing.deltaProgressMs);
      if (my !== token) return false;

      els.delta?.classList.remove("is-working");
      els.delta?.classList.add("is-live");
      if (els.delta) els.delta.textContent = data.delta;
      if (opts.announce && stepEl) stepEl.textContent = `Delta ${data.delta}`;
      if (detail) detail.textContent = data.deltaNote;
      await sleep(timing.deltaResolveMs);
      if (my !== token) return false;

      // Accepted
      els.btn.classList.remove("is-working");
      els.btn.classList.add("is-live", "is-accepted");
      if (els.status) els.status.textContent = "Accepted";
      if (opts.announce && stepEl) stepEl.textContent = "Accepted";
      if (detail) detail.textContent = "Delta within tolerance · Accepted";
      await sleep(timing.acceptMs);
      return my === token;
    };

    const walkTiming: ResolveTiming = {
      pendingMs: PENDING_MS,
      modelProgressMs: MODEL_PROGRESS_MS,
      modelResolveMs: MODEL_RESOLVE_MS,
      humanProgressMs: HUMAN_PROGRESS_MS,
      humanResolveMs: HUMAN_RESOLVE_MS,
      deltaProgressMs: DELTA_PROGRESS_MS,
      deltaResolveMs: DELTA_RESOLVE_MS,
      acceptMs: ACCEPT_MS,
    };

    const tryTiming: ResolveTiming = {
      pendingMs: TRY_PENDING_MS,
      modelProgressMs: TRY_MODEL_PROGRESS_MS,
      modelResolveMs: TRY_MODEL_RESOLVE_MS,
      humanProgressMs: TRY_HUMAN_PROGRESS_MS,
      humanResolveMs: TRY_HUMAN_RESOLVE_MS,
      deltaProgressMs: TRY_DELTA_PROGRESS_MS,
      deltaResolveMs: TRY_DELTA_RESOLVE_MS,
      acceptMs: TRY_ACCEPT_MS,
    };

    const run = async () => {
      const my = ++token;
      running = true;
      tryMode = false;
      resetBoard();

      const ok = await resolveRow(WALK_INDEX, my, walkTiming, {
        announce: true,
        activate: true,
      });
      if (!ok || my !== token) return;

      if (chipEl) chipEl.hidden = false;
      if (stepEl) stepEl.textContent = "Throughput";
      if (detail) detail.textContent = "Throughput ~10 / day";
      await sleep(CHIP_MS);
      if (my !== token) return;

      finish();
    };

    const runTryRow = async (index: number) => {
      const my = ++token;
      running = true;
      tryBtn?.classList.remove("is-pulse");
      if (tryBtn) tryBtn.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      if (hint) hint.hidden = true;

      const ok = await resolveRow(index, my, tryTiming, {
        announce: true,
        activate: true,
      });
      if (!ok || my !== token) return;

      running = false;
      tryMode = true;
      if (chipEl) chipEl.hidden = false;
      if (tryBtn) tryBtn.hidden = false;
      if (replayBtn) replayBtn.hidden = false;
      if (hint) hint.hidden = false;
      tryBtn?.classList.add("is-pulse");
    };

    frame.addEventListener("demo-play", (e) => {
      const eventDetail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (eventDetail?.reduced) {
        resetBoard();
        paintRowFinal(WALK_INDEX);
        if (chipEl) chipEl.hidden = false;
        finish();
        return;
      }
      void run();
    });
    frame.addEventListener("demo-replay", () => void run());

    rowBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!tryMode || running) return;
        const index = Number(btn.getAttribute("data-zl-row") ?? "0");
        if (!ROWS[index]) return;
        void runTryRow(index);
      });
    });

    tryBtn?.addEventListener("click", () => {
      if (!tryMode || running) return;
      const active = root.querySelector(".zl__row.is-active");
      const next = active
        ? (Number(active.getAttribute("data-zl-row") ?? "0") + 1) % ROWS.length
        : 0;
      void runTryRow(next);
    });
    replayBtn?.addEventListener("click", () => {
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  });
</script>

<style>
  .zl {
    --zl-bg: #f4f6f9;
    --zl-card: #ffffff;
    --zl-ink: #0f172a;
    --zl-muted: #64748b;
    --zl-line: #e2e8f0;
    --zl-accent: #1d4ed8;
    --zl-accent-soft: #dbeafe;
    --zl-green: #15803d;
    --zl-green-soft: #f0fdf4;
    height: 100%;
    padding: 0.85rem 1rem;
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    gap: 0.65rem;
    color: var(--zl-ink);
    background: var(--zl-bg);
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    overflow: hidden;
  }

  .zl__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.65rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--zl-line);
  }

  .zl__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.65rem;
  }

  .zl__title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--zl-ink);
    letter-spacing: -0.01em;
  }

  .zl__chip {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--zl-accent);
    background: var(--zl-accent-soft);
    border: 1px solid color-mix(in srgb, var(--zl-accent) 25%, var(--zl-line));
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }

  .zl__kicker {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--zl-muted);
  }

  .zl__table {
    min-height: 0;
    overflow: hidden;
    background: var(--zl-card);
    border: 1px solid var(--zl-line);
    border-radius: 0.65rem;
    box-shadow: 0 1px 2px color-mix(in srgb, #000 4%, transparent);
  }

  .zl__cols,
  .zl__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .zl__cols {
    padding: 0.55rem 0.75rem 0.45rem;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--zl-muted);
    border-block-end: 1px solid var(--zl-line);
    background: color-mix(in srgb, var(--zl-bg) 60%, var(--zl-card));
  }

  .zl__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zl__rows > li {
    margin: 0;
  }

  .zl__row {
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: 0;
    border-block-end: 1px solid var(--zl-line);
    background: transparent;
    color: inherit;
    font-size: 0.72rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .zl__rows > li:last-child .zl__row {
    border-block-end: 0;
  }

  .zl__row:hover {
    background: color-mix(in srgb, var(--zl-accent) 4%, var(--zl-card));
  }

  .zl__row.is-working {
    box-shadow: inset 3px 0 0 var(--zl-accent);
    background: color-mix(in srgb, var(--zl-accent) 6%, var(--zl-card));
    animation: zl-working 1.4s ease-in-out infinite;
  }

  .zl__row.is-live {
    box-shadow: inset 3px 0 0 var(--zl-accent);
    animation: none;
  }

  .zl__row.is-active {
    background: color-mix(in srgb, var(--zl-accent) 8%, var(--zl-card));
  }

  .zl__row.is-accepted .zl__status {
    color: var(--zl-green);
    font-weight: 600;
  }

  .zl__addr {
    color: var(--zl-ink);
    font-weight: 600;
  }

  .zl__model,
  .zl__human,
  .zl__delta,
  .zl__status {
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .zl__model,
  .zl__human {
    color: var(--zl-muted);
  }

  .zl__model.is-working,
  .zl__human.is-working,
  .zl__delta.is-working {
    color: var(--zl-accent);
    font-weight: 600;
  }

  .zl__model.is-live,
  .zl__human.is-live,
  .zl__delta.is-live {
    color: var(--zl-ink);
    font-weight: 500;
  }

  .zl__delta {
    color: var(--zl-ink);
  }

  .zl__status {
    color: var(--zl-muted);
    text-transform: uppercase;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .zl__detail {
    margin: 0;
    font-size: 0.72rem;
    color: var(--zl-muted);
    line-height: 1.4;
  }

  .zl__sql {
    border-block-start: 1px solid var(--zl-line);
    padding-block-start: 0.45rem;
  }

  .zl__sql-summary {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--zl-muted);
    cursor: pointer;
  }

  .zl__sql-summary:hover {
    color: var(--zl-accent);
  }

  .zl__sql-code {
    margin: 0.45rem 0 0;
    padding: 0.65rem;
    overflow: hidden;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.62rem;
