---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="zillow-demo"
  system="Data → model → acquisition"
  cta="Watch a pricing queue: model estimate vs human."
  caption="Interactive walkthrough"
>
  <div class="zl" data-zl>
    <header class="zl__head">
      <div class="zl__title-row">
        <h4 class="zl__title" data-zl-title>Pricing queue</h4>
        <span class="zl__chip" data-zl-chip hidden>~10 / day</span>
      </div>
      <span class="zl__kicker" data-zl-step>Ready</span>
    </header>

    <div class="zl__stage is-active" data-zl-view="queue">
      <div class="zl__table" role="table" aria-label="Pricing queue">
        <div class="zl__cols" role="row">
          <span role="columnheader">Address</span>
          <span role="columnheader">Model</span>
          <span role="columnheader">Human</span>
          <span role="columnheader">Delta</span>
          <span role="columnheader">Status</span>
        </div>
        <ul class="zl__rows" role="rowgroup" data-zl-rows>
          <li role="row">
            <button type="button" class="zl__row" data-zl-row="0">
              <span class="zl__addr">142 Harbor Ln</span>
              <span class="zl__model" data-zl-model>-</span>
              <span class="zl__human" data-zl-human>-</span>
              <span class="zl__delta" data-zl-delta>-</span>
              <span class="zl__status" data-zl-status>Pending</span>
            </button>
          </li>
          <li role="row">
            <button type="button" class="zl__row" data-zl-row="1">
              <span class="zl__addr">55 Ridge Ct</span>
              <span class="zl__model" data-zl-model>-</span>
              <span class="zl__human" data-zl-human>-</span>
              <span class="zl__delta" data-zl-delta>-</span>
              <span class="zl__status" data-zl-status>Pending</span>
            </button>
          </li>
          <li role="row">
            <button type="button" class="zl__row" data-zl-row="2">
              <span class="zl__addr">901 Willow St</span>
              <span class="zl__model" data-zl-model>-</span>
              <span class="zl__human" data-zl-human>-</span>
              <span class="zl__delta" data-zl-delta>-</span>
              <span class="zl__status" data-zl-status>Pending</span>
            </button>
          </li>
          <li role="row">
            <button type="button" class="zl__row" data-zl-row="3">
              <span class="zl__addr">18 Oak Grove</span>
              <span class="zl__model" data-zl-model>-</span>
              <span class="zl__human" data-zl-human>-</span>
              <span class="zl__delta" data-zl-delta>-</span>
              <span class="zl__status" data-zl-status>Pending</span>
            </button>
          </li>
          <li role="row">
            <button type="button" class="zl__row" data-zl-row="4">
              <span class="zl__addr">770 Pine Ave</span>
              <span class="zl__model" data-zl-model>-</span>
              <span class="zl__human" data-zl-human>-</span>
              <span class="zl__delta" data-zl-delta>-</span>
              <span class="zl__status" data-zl-status>Pending</span>
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="zl__stage" data-zl-view="chart" hidden>
      <article class="zl__chart-card" aria-label="Home valuation chart">
        <div class="zl__chart-head">
          <div>
            <p class="zl__chart-kicker">Home valuation</p>
            <h5 class="zl__chart-addr" data-zl-chart-addr>142 Harbor Ln</h5>
          </div>
          <div class="zl__chart-now">
            <span class="zl__chart-now-label">Current</span>
            <strong data-zl-chart-now>$318,400</strong>
          </div>
        </div>
        <svg
          class="zl__chart-svg"
          viewBox="0 0 360 150"
          preserveAspectRatio="none"
          role="img"
          aria-label="Valuation trend over twelve months"
        >
          <defs>
            <linearGradient id="zl-chart-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <g class="zl__chart-grid" aria-hidden="true">
            <line x1="28" y1="18" x2="350" y2="18"></line>
            <line x1="28" y1="52" x2="350" y2="52"></line>
            <line x1="28" y1="86" x2="350" y2="86"></line>
            <line x1="28" y1="120" x2="350" y2="120"></line>
          </g>
          <text x="2" y="22" class="zl__chart-axis">$340k</text>
          <text x="2" y="90" class="zl__chart-axis">$300k</text>
          <text x="2" y="124" class="zl__chart-axis">$280k</text>
          <path
            class="zl__chart-area"
            data-zl-chart-area
            d="M28,108 L57,102 L86,96 L115,88 L144,84 L173,78 L202,70 L231,62 L260,54 L289,48 L318,40 L350,32 L350,120 L28,120 Z"
            fill="url(#zl-chart-fill)"
          ></path>
          <path
            class="zl__chart-line"
            data-zl-chart-line
            d="M28,108 L57,102 L86,96 L115,88 L144,84 L173,78 L202,70 L231,62 L260,54 L289,48 L318,40 L350,32"
            fill="none"
            stroke="#1d4ed8"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle class="zl__chart-dot" data-zl-chart-dot cx="350" cy="32" r="4.5" fill="#1d4ed8"></circle>
          <g class="zl__chart-months" aria-hidden="true">
            <text x="28" y="140">Mar</text>
            <text x="115" y="140">Jun</text>
            <text x="202" y="140">Sep</text>
            <text x="289" y="140">Dec</text>
            <text x="338" y="140">Now</text>
          </g>
        </svg>
        <div class="zl__chart-legend">
          <span><i class="zl__swatch zl__swatch--model"></i> Model AVM</span>
          <span data-zl-chart-delta>+6.8% / 12 mo</span>
        </div>
      </article>
    </div>

    <div class="zl__stage" data-zl-view="offer" hidden>
      <article class="zl__offer" aria-label="Seller offer">
        <div class="zl__offer-banner">
          <span class="zl__offer-tag">Offer to seller</span>
          <span class="zl__offer-expire" data-zl-offer-expire>Expires in 7 days</span>
        </div>
        <div class="zl__offer-body">
          <div>
            <p class="zl__offer-label">Property</p>
            <h5 class="zl__offer-addr" data-zl-offer-addr>142 Harbor Ln</h5>
            <p class="zl__offer-sub">Cash close · no repairs · as-is</p>
          </div>
          <div class="zl__offer-amt-wrap">
            <p class="zl__offer-label">Our offer</p>
            <p class="zl__offer-amt" data-zl-offer-amt>$312,500</p>
            <p class="zl__offer-vs" data-zl-offer-vs>≈ 98.1% of model</p>
          </div>
        </div>
        <ul class="zl__offer-rows">
          <li><span>Model estimate</span><strong data-zl-offer-model>$318,400</strong></li>
          <li><span>Human estimate</span><strong data-zl-offer-human>$322,100</strong></li>
          <li><span>Net to seller (est.)</span><strong data-zl-offer-net>$304,800</strong></li>
        </ul>
        <div class="zl__offer-foot">
          <button type="button" class="zl__offer-send" data-zl-offer-send disabled>Send offer</button>
          <span class="zl__offer-status" data-zl-offer-status>Draft</span>
        </div>
      </article>
    </div>

    <p class="zl__detail" data-zl-detail>Select a row after the walkthrough.</p>

    <details class="zl__sql" data-zl-sql>
      <summary class="zl__sql-summary">Queue query</summary>
      <pre class="zl__sql-code">SELECT address, model_est, human_est, delta_pct
FROM pricing_queue
WHERE status = 'pending'
ORDER BY created_at
LIMIT 5;</pre>
    </details>

    <div class="zl__actions">
      <p class="zl__hint" data-zl-hint hidden>Now explore it yourself.</p>
      <button type="button" class="zl__btn zl__btn--pulse" data-zl-try hidden>
        Select a row
      </button>
    </div>
  </div>
</DemoFrame>

<script>
  type ZlRow = {
    address: string;
    model: string;
    human: string;
    delta: string;
    deltaNote: string;
    offer: string;
    offerVs: string;
    net: string;
    chartNow: string;
    chartDelta: string;
  };

  type ZlView = "queue" | "chart" | "offer";

  const ROWS: ZlRow[] = [
    {
      address: "142 Harbor Ln",
      model: "$318,400",
      human: "$322,100",
      delta: "+1.2%",
      deltaNote: "Model vs human: $3,700 (1.2%)",
      offer: "$312,500",
      offerVs: "≈ 98.1% of model",
      net: "$304,800",
      chartNow: "$318,400",
      chartDelta: "+6.8% / 12 mo",
    },
    {
      address: "55 Ridge Ct",
      model: "$445,200",
      human: "$441,800",
      delta: "-0.8%",
      deltaNote: "Model vs human: $3,400 (0.8%)",
      offer: "$436,000",
      offerVs: "≈ 97.9% of model",
      net: "$425,200",
      chartNow: "$445,200",
      chartDelta: "+4.2% / 12 mo",
    },
    {
      address: "901 Willow St",
      model: "$267,900",
      human: "$271,500",
      delta: "+1.3%",
      deltaNote: "Model vs human: $3,600 (1.3%)",
      offer: "$262,500",
      offerVs: "≈ 98.0% of model",
      net: "$255,900",
      chartNow: "$267,900",
      chartDelta: "+5.1% / 12 mo",
    },
    {
      address: "18 Oak Grove",
      model: "$512,000",
      human: "$518,400",
      delta: "+1.2%",
      deltaNote: "Model vs human: $6,400 (1.2%)",
      offer: "$501,000",
      offerVs: "≈ 97.9% of model",
      net: "$488,600",
      chartNow: "$512,000",
      chartDelta: "+7.4% / 12 mo",
    },
    {
      address: "770 Pine Ave",
      model: "$389,100",
      human: "$385,200",
      delta: "-1.0%",
      deltaNote: "Model vs human: $3,900 (1.0%)",
      offer: "$381,000",
      offerVs: "≈ 97.9% of model",
      net: "$371,400",
      chartNow: "$389,100",
      chartDelta: "+3.9% / 12 mo",
    },
  ];

  const WALK_INDEX = 0;
  const EMPTY = "-";
  const CALC = "…";

  /** Full walkthrough — ~600ms beat pad from baseline */
  const PENDING_MS = 1700;
  const MODEL_PROGRESS_MS = 2400;
  const MODEL_RESOLVE_MS = 1300;
  const HUMAN_PROGRESS_MS = 2400;
  const HUMAN_RESOLVE_MS = 1300;
  const DELTA_PROGRESS_MS = 2000;
  const DELTA_RESOLVE_MS = 1300;
  const ACCEPT_MS = 1200;
  const CHART_MS = 2800;
  const OFFER_DRAFT_MS = 1400;
  const OFFER_SEND_MS = 1600;
  const CHIP_MS = 900;

  /** Faster beats for try-mode row resolve */
  const TRY_PENDING_MS = 400;
  const TRY_MODEL_PROGRESS_MS = 900;
  const TRY_MODEL_RESOLVE_MS = 350;
  const TRY_HUMAN_PROGRESS_MS = 900;
  const TRY_HUMAN_RESOLVE_MS = 350;
  const TRY_DELTA_PROGRESS_MS = 700;
  const TRY_DELTA_RESOLVE_MS = 350;
  const TRY_ACCEPT_MS = 400;

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireZillow(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-zl-wired")) return;
    frame.setAttribute("data-zl-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-zl-step]");
    const titleEl = root.querySelector<HTMLElement>("[data-zl-title]");
    const chipEl = root.querySelector<HTMLElement>("[data-zl-chip]");
    const detail = root.querySelector<HTMLElement>("[data-zl-detail]");
    const tryBtn = root.querySelector<HTMLButtonElement>("[data-zl-try]");
    const hint = root.querySelector<HTMLElement>("[data-zl-hint]");
    const sqlEl = root.querySelector<HTMLElement>("[data-zl-sql]");
    const rowBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-zl-row]"));
    const views = {
      queue: root.querySelector<HTMLElement>("[data-zl-view='queue']"),
      chart: root.querySelector<HTMLElement>("[data-zl-view='chart']"),
      offer: root.querySelector<HTMLElement>("[data-zl-view='offer']"),
    };
    const chartAddr = root.querySelector<HTMLElement>("[data-zl-chart-addr]");
    const chartNow = root.querySelector<HTMLElement>("[data-zl-chart-now]");
    const chartDelta = root.querySelector<HTMLElement>("[data-zl-chart-delta]");
    const chartLine = root.querySelector<SVGPathElement>("[data-zl-chart-line]");
    const chartArea = root.querySelector<SVGPathElement>("[data-zl-chart-area]");
    const chartDot = root.querySelector<SVGCircleElement>("[data-zl-chart-dot]");
    const offerAddr = root.querySelector<HTMLElement>("[data-zl-offer-addr]");
    const offerAmt = root.querySelector<HTMLElement>("[data-zl-offer-amt]");
    const offerVs = root.querySelector<HTMLElement>("[data-zl-offer-vs]");
    const offerModel = root.querySelector<HTMLElement>("[data-zl-offer-model]");
    const offerHuman = root.querySelector<HTMLElement>("[data-zl-offer-human]");
    const offerNet = root.querySelector<HTMLElement>("[data-zl-offer-net]");
    const offerSend = root.querySelector<HTMLButtonElement>("[data-zl-offer-send]");
    const offerStatus = root.querySelector<HTMLElement>("[data-zl-offer-status]");

    let running = false;
    let token = 0;
    let tryMode = false;

    type RowEls = {
      btn: HTMLElement;
      model: Element | null;
      human: Element | null;
      delta: Element | null;
      status: Element | null;
    };

    const rowEls = (index: number): RowEls | null => {
      const btn = root.querySelector<HTMLElement>(`[data-zl-row='${index}']`);
      if (!btn) return null;
      return {
        btn,
        model: btn.querySelector("[data-zl-model]"),
        human: btn.querySelector("[data-zl-human]"),
        delta: btn.querySelector("[data-zl-delta]"),
        status: btn.querySelector("[data-zl-status]"),
      };
    };

    const setView = (view: ZlView) => {
      (Object.keys(views) as ZlView[]).forEach((id) => {
        const el = views[id];
        if (!el) return;
        const on = id === view;
        el.hidden = !on;
        el.classList.toggle("is-active", on);
      });
      if (sqlEl) sqlEl.hidden = view !== "queue";
      if (titleEl) {
        titleEl.textContent =
          view === "queue" ? "Pricing queue" : view === "chart" ? "Valuation" : "Seller offer";
      }
    };

    const clearRowState = (els: RowEls) => {
      els.btn.classList.remove("is-working", "is-live", "is-accepted", "is-active");
      els.model?.classList.remove("is-working", "is-live", "is-shimmer");
      els.human?.classList.remove("is-working", "is-live", "is-shimmer");
      els.delta?.classList.remove("is-working", "is-live", "is-shimmer");
    };

    const clearSelection = () => {
      rowBtns.forEach((r) => r.classList.remove("is-active"));
    };

    const resetRowValues = (els: RowEls) => {
      if (els.model) els.model.textContent = EMPTY;
      if (els.human) els.human.textContent = EMPTY;
      if (els.delta) els.delta.textContent = EMPTY;
      if (els.status) els.status.textContent = "Pending";
      clearRowState(els);
    };

    const resetChartAnim = () => {
      chartLine?.classList.remove("is-drawn");
      chartArea?.classList.remove("is-drawn");
      chartDot?.classList.remove("is-drawn");
    };

    const paintChart = (index: number) => {
      const data = ROWS[index];
      if (!data) return;
      if (chartAddr) chartAddr.textContent = data.address;
      if (chartNow) chartNow.textContent = data.chartNow;
      if (chartDelta) chartDelta.textContent = data.chartDelta;
      resetChartAnim();
      requestAnimationFrame(() => {
        chartLine?.classList.add("is-drawn");
        chartArea?.classList.add("is-drawn");
        chartDot?.classList.add("is-drawn");
      });
    };

    const paintOffer = (index: number, status: "Draft" | "Sending…" | "Sent") => {
      const data = ROWS[index];
      if (!data) return;
      if (offerAddr) offerAddr.textContent = data.address;
      if (offerAmt) offerAmt.textContent = data.offer;
      if (offerVs) offerVs.textContent = data.offerVs;
      if (offerModel) offerModel.textContent = data.model;
      if (offerHuman) offerHuman.textContent = data.human;
      if (offerNet) offerNet.textContent = data.net;
      if (offerStatus) offerStatus.textContent = status;
      offerStatus?.classList.toggle("is-sent", status === "Sent");
      if (offerSend) {
        offerSend.disabled = status !== "Draft";
        offerSend.textContent = status === "Sent" ? "Offer sent" : status === "Sending…" ? "Sending…" : "Send offer";
        offerSend.classList.toggle("is-sent", status === "Sent");
        offerSend.classList.toggle("is-pulse", status === "Draft");
      }
    };

    const resetBoard = () => {
      ROWS.forEach((_, i) => {
        const els = rowEls(i);
        if (!els) return;
        resetRowValues(els);
      });
      if (chipEl) chipEl.hidden = true;
      if (stepEl) {
        stepEl.textContent = "Ready";
        stepEl.classList.remove("is-pulse");
      }
      if (detail) detail.textContent = "Select a row after the walkthrough.";
      if (tryBtn) tryBtn.hidden = true;
      if (hint) hint.hidden = true;
      tryBtn?.classList.remove("is-pulse");
      tryMode = false;
      resetChartAnim();
      paintOffer(WALK_INDEX, "Draft");
      setView("queue");
    };

    const paintRowFinal = (index: number) => {
      const data = ROWS[index];
      const els = rowEls(index);
      if (!data || !els) return;
      clearRowState(els);
      if (els.model) {
        els.model.textContent = data.model;
        els.model.classList.add("is-live");
      }
      if (els.human) {
        els.human.textContent = data.human;
        els.human.classList.add("is-live");
      }
      if (els.delta) {
        els.delta.textContent = data.delta;
        els.delta.classList.add("is-live");
      }
      if (els.status) els.status.textContent = "Accepted";
      els.btn.classList.add("is-live", "is-accepted");
    };

    const finish = () => {
      running = false;
      tryMode = true;
      if (chipEl) chipEl.hidden = false;
      if (stepEl) {
        stepEl.textContent = "Offer sent";
        stepEl.classList.remove("is-pulse");
      }
      if (detail) {
        detail.textContent = "Offer on the wire · explore another queue row.";
      }
      clearSelection();
      rowEls(WALK_INDEX)?.btn.classList.add("is-active");
      if (tryBtn) {
        tryBtn.hidden = false;
        tryBtn.textContent = "Try another row";
      }
      if (hint) hint.hidden = false;
      tryBtn?.classList.add("is-pulse");
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    type ResolveTiming = {
      pendingMs: number;
      modelProgressMs: number;
      modelResolveMs: number;
      humanProgressMs: number;
      humanResolveMs: number;
      deltaProgressMs: number;
      deltaResolveMs: number;
      acceptMs: number;
    };

    const resolveRow = async (
      index: number,
      my: number,
      timing: ResolveTiming,
      opts: { announce: boolean; activate: boolean },
    ): Promise<boolean> => {
      const data = ROWS[index];
      const els = rowEls(index);
      if (!data || !els) return false;

      setView("queue");
      resetRowValues(els);
      if (opts.activate) {
        clearSelection();
        els.btn.classList.add("is-active");
      }
      els.btn.classList.add("is-working");
      if (els.status) els.status.textContent = "Working";
      if (opts.announce) {
        if (stepEl) {
          stepEl.textContent = "Loading queue…";
          stepEl.classList.add("is-pulse");
        }
        if (detail) detail.textContent = `${data.address} — starting resolve`;
      }
      els.model?.classList.add("is-shimmer");
      els.human?.classList.add("is-shimmer");
      els.delta?.classList.add("is-shimmer");
      if (els.model) els.model.textContent = "";
      if (els.human) els.human.textContent = "";
      if (els.delta) els.delta.textContent = "";
      await sleep(timing.pendingMs);
      if (my !== token) return false;

      els.model?.classList.add("is-working");
      els.model?.classList.remove("is-shimmer");
      if (els.model) els.model.textContent = CALC;
      if (els.status) els.status.textContent = "Model";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Pulling model estimate…";
        if (detail) detail.textContent = "Model running comps + AVM…";
      } else if (detail) {
        detail.textContent = "Model estimating…";
      }
      await sleep(timing.modelProgressMs);
      if (my !== token) return false;

      els.model?.classList.remove("is-working");
      els.model?.classList.add("is-live");
      if (els.model) els.model.textContent = data.model;
      if (opts.announce && stepEl) stepEl.textContent = "Model locked";
      if (detail) detail.textContent = `Model estimate ${data.model}`;
      await sleep(timing.modelResolveMs);
      if (my !== token) return false;

      els.human?.classList.add("is-working");
      els.human?.classList.remove("is-shimmer");
      if (els.human) els.human.textContent = CALC;
      if (els.status) els.status.textContent = "Human";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Human analyst reviewing…";
      }
      if (detail) detail.textContent = "Analyst checking model vs comps…";
      await sleep(timing.humanProgressMs);
      if (my !== token) return false;

      els.human?.classList.remove("is-working");
      els.human?.classList.add("is-live");
      if (els.human) els.human.textContent = data.human;
      if (opts.announce && stepEl) stepEl.textContent = "Human locked";
      if (detail) detail.textContent = `Human estimate ${data.human}`;
      await sleep(timing.humanResolveMs);
      if (my !== token) return false;

      els.delta?.classList.add("is-working");
      els.delta?.classList.remove("is-shimmer");
      if (els.delta) els.delta.textContent = CALC;
      if (els.status) els.status.textContent = "Delta";
      if (opts.announce) {
        if (stepEl) stepEl.textContent = "Comparing model vs human…";
      }
      if (detail) detail.textContent = "Computing delta…";
      await sleep(timing.deltaProgressMs);
      if (my !== token) return false;

      els.delta?.classList.remove("is-working");
      els.delta?.classList.add("is-live");
      if (els.delta) els.delta.textContent = data.delta;
      if (opts.announce && stepEl) {
        stepEl.textContent = `Delta ${data.delta}`;
        stepEl.classList.remove("is-pulse");
      }
      if (detail) detail.textContent = data.deltaNote;
      await sleep(timing.deltaResolveMs);
      if (my !== token) return false;

      els.btn.classList.remove("is-working");
      els.btn.classList.add("is-live", "is-accepted");
      els.human?.classList.remove("is-shimmer");
      els.model?.classList.remove("is-shimmer");
      els.delta?.classList.remove("is-shimmer");
      if (els.status) els.status.textContent = "Accepted";
      if (opts.announce && stepEl) {
        stepEl.textContent = "Accepted";
        stepEl.classList.remove("is-pulse");
      }
      if (detail) detail.textContent = "Delta within tolerance · Accepted";
      await sleep(timing.acceptMs);
      return my === token;
    };

    const showValuationAndOffer = async (index: number, my: number): Promise<boolean> => {
      setView("chart");
      paintChart(index);
      if (stepEl) {
        stepEl.textContent = "Home valuation trend";
        stepEl.classList.add("is-pulse");
      }
      if (detail) detail.textContent = "Twelve-month AVM path for this address";
      await sleep(CHART_MS);
      if (my !== token) return false;

      setView("offer");
      paintOffer(index, "Draft");
      if (stepEl) stepEl.textContent = "Drafting seller offer…";
      if (detail) detail.textContent = "Building cash offer from model + human lock";
      await sleep(OFFER_DRAFT_MS);
      if (my !== token) return false;

      paintOffer(index, "Sending…");
      if (stepEl) stepEl.textContent = "Sending offer to seller…";
      if (detail) detail.textContent = "Pushing offer packet to seller portal";
      await sleep(OFFER_SEND_MS);
      if (my !== token) return false;

      paintOffer(index, "Sent");
      if (stepEl) {
        stepEl.textContent = "Offer sent";
        stepEl.classList.remove("is-pulse");
      }
      if (detail) detail.textContent = "Seller notified · waiting on response";
      await sleep(CHIP_MS);
      return my === token;
    };

    const walkTiming: ResolveTiming = {
      pendingMs: PENDING_MS,
      modelProgressMs: MODEL_PROGRESS_MS,
      modelResolveMs: MODEL_RESOLVE_MS,
      humanProgressMs: HUMAN_PROGRESS_MS,
      humanResolveMs: HUMAN_RESOLVE_MS,
      deltaProgressMs: DELTA_PROGRESS_MS,
      deltaResolveMs: DELTA_RESOLVE_MS,
      acceptMs: ACCEPT_MS,
    };

    const tryTiming: ResolveTiming = {
      pendingMs: TRY_PENDING_MS,
      modelProgressMs: TRY_MODEL_PROGRESS_MS,
      modelResolveMs: TRY_MODEL_RESOLVE_MS,
      humanProgressMs: TRY_HUMAN_PROGRESS_MS,
      humanResolveMs: TRY_HUMAN_RESOLVE_MS,
      deltaProgressMs: TRY_DELTA_PROGRESS_MS,
      deltaResolveMs: TRY_DELTA_RESOLVE_MS,
      acceptMs: TRY_ACCEPT_MS,
    };

    const run = async () => {
      const my = ++token;
      running = true;
      tryMode = false;
      resetBoard();

      const ok = await resolveRow(WALK_INDEX, my, walkTiming, {
        announce: true,
        activate: true,
      });
      if (!ok || my !== token) return;

      const ok2 = await showValuationAndOffer(WALK_INDEX, my);
      if (!ok2 || my !== token) return;

      if (chipEl) chipEl.hidden = false;
      finish();
    };

    const runTryRow = async (index: number) => {
      const my = ++token;
      running = true;
      tryBtn?.classList.remove("is-pulse");
      if (tryBtn) tryBtn.hidden = true;
      if (hint) hint.hidden = true;

      const ok = await resolveRow(index, my, tryTiming, {
        announce: true,
        activate: true,
      });
      if (!ok || my !== token) return;

      const ok2 = await showValuationAndOffer(index, my);
      if (!ok2 || my !== token) return;

      running = false;
      tryMode = true;
      if (chipEl) chipEl.hidden = false;
      if (tryBtn) tryBtn.hidden = false;
      if (hint) hint.hidden = false;
      tryBtn?.classList.add("is-pulse");
    };

    frame.addEventListener("demo-play", (e) => {
      const eventDetail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (eventDetail?.reduced) {
        resetBoard();
        paintRowFinal(WALK_INDEX);
        paintChart(WALK_INDEX);
        paintOffer(WALK_INDEX, "Sent");
        setView("offer");
        if (chipEl) chipEl.hidden = false;
        finish();
        return;
      }
      void run();
    });
    frame.addEventListener("demo-replay", () => void run());

    rowBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!tryMode || running) return;
        const index = Number(btn.getAttribute("data-zl-row") ?? "0");
        if (!ROWS[index]) return;
        void runTryRow(index);
      });
    });

    tryBtn?.addEventListener("click", () => {
      if (!tryMode || running) return;
      if (views.offer && !views.offer.hidden) {
        setView("queue");
        if (stepEl) stepEl.textContent = "Pick a row";
        if (detail) detail.textContent = "Select another address to price + offer";
        return;
      }
      const active = root.querySelector(".zl__row.is-active");
      const next = active
        ? (Number(active.getAttribute("data-zl-row") ?? "0") + 1) % ROWS.length
        : 0;
      void runTryRow(next);
    });
  }

  document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-zl]").forEach((el) => wireZillow(el as HTMLElement));
  });
</script>

