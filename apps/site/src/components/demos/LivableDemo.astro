---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="livable-demo"
  aspect="16 / 10"
  system="Billing → allocation → payment"
  cta="Watch recoveries land, then pay a unit share from the resident side."
  caption="Interactive walkthrough"
>
  <div class="lv" data-lv>
    <header class="lv__top">
      <div class="lv__brand">
        <span class="lv__mark" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
            <path d="M7 1.5L12.5 5.5V13H9.5V9H4.5V13H1.5V5.5L7 1.5Z" fill="currentColor"></path>
          </svg>
        </span>
        <div class="lv__brand-text">
          <p class="lv__name">Oak Court</p>
          <p class="lv__meta">24 units · Chicago, IL</p>
        </div>
      </div>

      <div class="lv__toggle" role="tablist" data-lv-toggle>
        <button
          type="button"
          class="lv__tab is-active"
          data-lv-tab="landlord"
          role="tab"
          aria-selected="true"
          disabled
        >
          Landlord
        </button>
        <button
          type="button"
          class="lv__tab"
          data-lv-tab="resident"
          role="tab"
          aria-selected="false"
          disabled
        >
          Resident
        </button>
      </div>

      <div class="lv__user">
        <span class="lv__avatar" data-lv-avatar>ML</span>
        <span class="lv__user-name" data-lv-user>Maria Lopez</span>
      </div>
    </header>

    <div class="lv__title-row">
      <div>
        <h3 class="lv__title" data-lv-title>Recovery dashboard</h3>
        <p class="lv__subtitle" data-lv-subtitle>August 2026 · Oak Court, 24 units</p>
      </div>
      <span class="lv__step" data-lv-step>Idle</span>
    </div>

    <div class="lv__panel" data-lv-panel="landlord">
      <div class="lv__stats">
        <div class="lv__stat lv__stat--hero" data-lv-stat="recovered">
          <p class="lv__stat-label">Recovered this month</p>
          <p class="lv__stat-value" data-lv-recovered>$0</p>
          <p class="lv__stat-sub">August 2026</p>
        </div>
        <div class="lv__stat" data-lv-stat="open">
          <p class="lv__stat-label">Open recoveries</p>
          <p class="lv__stat-value" data-lv-open>-</p>
          <p class="lv__stat-sub" data-lv-open-sub>Waiting on units</p>
        </div>
        <div class="lv__stat" data-lv-stat="csat">
          <p class="lv__stat-label">CSAT score</p>
          <p class="lv__stat-value" data-lv-csat>-</p>
          <p class="lv__stat-sub">out of 5.0 · 38 responses</p>
        </div>
      </div>

      <div class="lv__grid">
        <section class="lv__card lv__chart-card" aria-label="Recoveries by month">
          <p class="lv__card-label">Recoveries by month</p>
          <div class="lv__chart" data-lv-chart>
            <div class="lv__y" aria-hidden="true">
              <span>$4k</span>
              <span>$2k</span>
              <span>$0</span>
            </div>
            <div class="lv__bars" role="img" aria-label="Monthly recoveries Mar through Aug">
              <div class="lv__bar-col" data-lv-bar="0" style="--h: 66%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">Mar</span>
              </div>
              <div class="lv__bar-col" data-lv-bar="1" style="--h: 75%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">Apr</span>
              </div>
              <div class="lv__bar-col" data-lv-bar="2" style="--h: 86%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">May</span>
              </div>
              <div class="lv__bar-col" data-lv-bar="3" style="--h: 92%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">Jun</span>
              </div>
              <div class="lv__bar-col" data-lv-bar="4" style="--h: 96%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">Jul</span>
              </div>
              <div class="lv__bar-col is-current" data-lv-bar="5" style="--h: 100%">
                <span class="lv__bar"></span>
                <span class="lv__bar-label">Aug</span>
              </div>
            </div>
          </div>
        </section>

        <section class="lv__card lv__table-card" aria-label="All units">
          <div class="lv__table-head">
            <p class="lv__card-label">All units</p>
            <span class="lv__row-count">12 rows</span>
          </div>
          <div class="lv__table-scroll">
            <table class="lv__table">
              <thead>
                <tr>
                  <th>Unit</th>
                  <th>Utility</th>
                  <th class="is-num">Amount</th>
                  <th class="is-status">Status</th>
                </tr>
              </thead>
              <tbody data-lv-tbody>
                <tr data-lv-row="0" data-unit="12">
                  <td class="is-mono">12</td>
                  <td>Water</td>
                  <td class="is-num is-mono">$47.20</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--reply" data-lv-status>
                      <span class="lv__dot"></span>Resident reply
                    </span>
                  </td>
                </tr>
                <tr data-lv-row="1" data-unit="8">
                  <td class="is-mono">8</td>
                  <td>Electricity</td>
                  <td class="is-num is-mono">$89.40</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--review"><span class="lv__dot"></span>In review</span>
                  </td>
                </tr>
                <tr data-lv-row="2" data-unit="3">
                  <td class="is-mono">3</td>
                  <td>Gas</td>
                  <td class="is-num is-mono">$62.10</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--ok"><span class="lv__dot"></span>Recovered</span>
                  </td>
                </tr>
                <tr data-lv-row="3" data-unit="17">
                  <td class="is-mono">17</td>
                  <td>Water</td>
                  <td class="is-num is-mono">$38.90</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--ok"><span class="lv__dot"></span>Recovered</span>
                  </td>
                </tr>
                <tr data-lv-row="4" data-unit="22">
                  <td class="is-mono">22</td>
                  <td>Trash</td>
                  <td class="is-num is-mono">$24.60</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--review"><span class="lv__dot"></span>In review</span>
                  </td>
                </tr>
                <tr data-lv-row="5" data-unit="5">
                  <td class="is-mono">5</td>
                  <td>Sewer</td>
                  <td class="is-num is-mono">$31.80</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--ok"><span class="lv__dot"></span>Recovered</span>
                  </td>
                </tr>
                <tr data-lv-row="6" data-unit="14">
                  <td class="is-mono">14</td>
                  <td>Electricity</td>
                  <td class="is-num is-mono">$95.20</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--review"><span class="lv__dot"></span>In review</span>
                  </td>
                </tr>
                <tr data-lv-row="7" data-unit="9">
                  <td class="is-mono">9</td>
                  <td>Water</td>
                  <td class="is-num is-mono">$42.30</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--ok"><span class="lv__dot"></span>Recovered</span>
                  </td>
                </tr>
                <tr data-lv-row="8" data-unit="19">
                  <td class="is-mono">19</td>
                  <td>Gas</td>
                  <td class="is-num is-mono">$71.50</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--reply"><span class="lv__dot"></span>Resident reply</span>
                  </td>
                </tr>
                <tr data-lv-row="9" data-unit="1">
                  <td class="is-mono">1</td>
                  <td>Trash</td>
                  <td class="is-num is-mono">$19.40</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--ok"><span class="lv__dot"></span>Recovered</span>
                  </td>
                </tr>
                <tr data-lv-row="10" data-unit="7">
                  <td class="is-mono">7</td>
                  <td>Electricity</td>
                  <td class="is-num is-mono">$88.30</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--review"><span class="lv__dot"></span>In review</span>
                  </td>
                </tr>
                <tr data-lv-row="11" data-unit="11">
                  <td class="is-mono">11</td>
                  <td>Sewer</td>
                  <td class="is-num is-mono">$44.90</td>
                  <td class="is-status">
                    <span class="lv__pill lv__pill--reply"><span class="lv__dot"></span>Resident reply</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

    <div class="lv__panel lv__panel--resident" data-lv-panel="resident" hidden>
      <div class="lv__bill" data-lv-bill>
        <div class="lv__bill-hero">
          <p class="lv__bill-kicker">Your share this month</p>
          <p class="lv__bill-amt">$47.20</p>
          <p class="lv__bill-due">Due Sep 1, 2026 · Oak Court, Unit 12</p>
        </div>
        <div class="lv__bill-lines">
          <div class="lv__bill-line">
            <div>
              <p class="lv__bill-line-name">Water</p>
              <p class="lv__bill-line-desc">Shared metered</p>
            </div>
            <span class="is-mono">$18.40</span>
          </div>
          <div class="lv__bill-line">
            <div>
              <p class="lv__bill-line-name">Trash</p>
              <p class="lv__bill-line-desc">Weekly pickup</p>
            </div>
            <span class="is-mono">$12.30</span>
          </div>
          <div class="lv__bill-line">
            <div>
              <p class="lv__bill-line-name">Sewer</p>
              <p class="lv__bill-line-desc">Municipal</p>
            </div>
            <span class="is-mono">$16.50</span>
          </div>
          <div class="lv__bill-total">
            <span>Total</span>
            <span class="is-mono">$47.20</span>
          </div>
        </div>
        <div class="lv__bill-actions">
          <button type="button" class="lv__pay" data-lv-pay disabled>Pay $47.20</button>
          <button type="button" class="lv__details" data-lv-details disabled>View details</button>
        </div>
        <p class="lv__paid" data-lv-paid hidden>Paid. Recovery updated for Unit 12.</p>
      </div>

      <div class="lv__why" data-lv-why>
        <p class="lv__why-label">Why this charge?</p>
        <p class="lv__why-body">
          Oak Court splits shared utility costs by unit size. Unit 12 (780 sq ft) is charged for water,
          trash, and sewer from building-wide usage for August 2026. Costs pass through at cost with no markup.
        </p>
        <p class="lv__why-method">
          <span class="lv__why-dot"></span>
          Billing method: RUBS (Ratio Utility Billing System)
        </p>
      </div>
    </div>

    <div class="lv__try" data-lv-try hidden>
      <p class="lv__hint" data-lv-hint>Toggle landlord / resident. Pay from Unit 12, or Replay.</p>
      <button type="button" class="lv__replay" data-lv-replay>Replay</button>
    </div>
  </div>
</DemoFrame>

<script>
  const BASE_RECOVERED = 4280;
  const UNIT12_CENTS = 4720;
  const OPEN_BEFORE = 11;
  const OPEN_AFTER = 10;

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function formatDollars(n: number) {
    return `$${Math.round(n).toLocaleString("en-US")}`;
  }

  function wireLivable(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-lv-wired")) return;
    frame.setAttribute("data-lv-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-lv-step]");
    const titleEl = root.querySelector<HTMLElement>("[data-lv-title]");
    const subtitleEl = root.querySelector<HTMLElement>("[data-lv-subtitle]");
    const avatarEl = root.querySelector<HTMLElement>("[data-lv-avatar]");
    const userEl = root.querySelector<HTMLElement>("[data-lv-user]");
    const recoveredEl = root.querySelector<HTMLElement>("[data-lv-recovered]");
    const openEl = root.querySelector<HTMLElement>("[data-lv-open]");
    const openSubEl = root.querySelector<HTMLElement>("[data-lv-open-sub]");
    const csatEl = root.querySelector<HTMLElement>("[data-lv-csat]");
    const payBtn = root.querySelector<HTMLButtonElement>("[data-lv-pay]");
    const detailsBtn = root.querySelector<HTMLButtonElement>("[data-lv-details]");
    const paidEl = root.querySelector<HTMLElement>("[data-lv-paid]");
    const tryBar = root.querySelector<HTMLElement>("[data-lv-try]");
    const hint = root.querySelector<HTMLElement>("[data-lv-hint]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-lv-replay]");
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-lv-tab]");
    const landlordPanel = root.querySelector<HTMLElement>("[data-lv-panel='landlord']");
    const residentPanel = root.querySelector<HTMLElement>("[data-lv-panel='resident']");
    const unit12Row = root.querySelector<HTMLElement>("[data-lv-row='0']");
    const unit12Status = unit12Row?.querySelector<HTMLElement>("[data-lv-status]");
    const bars = Array.from(root.querySelectorAll<HTMLElement>("[data-lv-bar]"));
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-lv-row]"));
    const stats = {
      recovered: root.querySelector<HTMLElement>("[data-lv-stat='recovered']"),
      open: root.querySelector<HTMLElement>("[data-lv-stat='open']"),
      csat: root.querySelector<HTMLElement>("[data-lv-stat='csat']"),
    };
    const chart = root.querySelector<HTMLElement>("[data-lv-chart]");
    const tableCard = root.querySelector(".lv__table-card");
    const bill = root.querySelector<HTMLElement>("[data-lv-bill]");
    const why = root.querySelector<HTMLElement>("[data-lv-why]");

    let running = false;
    let token = 0;
    let paid = false;
    let recoveredDollars = 0;

    const setStep = (text: string) => {
      if (!stepEl) return;
      stepEl.textContent = text;
      const busy =
        /loading|calculat|charting|scanning|posting|waiting/i.test(text) ||
        text.includes("…");
      stepEl.classList.toggle("is-busy", busy);
    };

    const setView = (id: "landlord" | "resident") => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-lv-tab") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (landlordPanel) landlordPanel.hidden = id !== "landlord";
      if (residentPanel) residentPanel.hidden = id !== "resident";
      if (avatarEl) avatarEl.textContent = id === "landlord" ? "ML" : "12";
      if (userEl) userEl.textContent = id === "landlord" ? "Maria Lopez" : "Unit 12";
      if (titleEl) titleEl.textContent = id === "landlord" ? "Recovery dashboard" : "August statement";
      if (subtitleEl) {
        subtitleEl.textContent =
          id === "landlord" ? "August 2026 · Oak Court, 24 units" : "Oak Court · Unit 12 · August 2026";
      }
    };

    const setTabsEnabled = (on: boolean) => {
      tabs.forEach((tab) => {
        tab.disabled = !on;
      });
    };

    const clearPulse = () => {
      tabs.forEach((tab) => tab.classList.remove("is-pulse"));
      payBtn?.classList.remove("is-pulse");
    };

    const setRecovered = (dollars: number) => {
      recoveredDollars = dollars;
      if (recoveredEl) recoveredEl.textContent = formatDollars(dollars);
    };

    const setOpen = (n: number) => {
      if (openEl) openEl.textContent = String(n);
      if (openSubEl) {
        openSubEl.textContent =
          n === OPEN_AFTER ? "7 in review · 3 awaiting reply" : "7 in review · 4 awaiting reply";
      }
    };

    const markUnit12Recovered = () => {
      if (!unit12Status) return;
      unit12Status.className = "lv__pill lv__pill--ok";
      unit12Status.innerHTML = '<span class="lv__dot"></span>Recovered';
    };

    const resetUnit12Status = () => {
      if (!unit12Status) return;
      unit12Status.className = "lv__pill lv__pill--reply";
      unit12Status.innerHTML = '<span class="lv__dot"></span>Resident reply';
    };

    const resetBoard = () => {
      setStep("Idle");
      setView("landlord");
      setTabsEnabled(false);
      clearPulse();
      paid = false;
      setRecovered(0);
      setOpen(OPEN_BEFORE);
      if (csatEl) csatEl.textContent = "-";
      Object.values(stats).forEach((el) => el?.classList.remove("is-live", "is-working", "is-tick"));
      chart?.classList.remove("is-live", "is-working");
      tableCard?.classList.remove("is-live", "is-working");
      bars.forEach((bar) => bar.classList.remove("is-grown", "is-pulse-bar"));
      rows.forEach((row) => row.classList.remove("is-visible", "is-highlight"));
      resetUnit12Status();
      recoveredEl?.classList.remove("is-tick");
      bill?.classList.remove("is-live");
      why?.classList.remove("is-live");
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.hidden = false;
        payBtn.textContent = "Pay $47.20";
      }
      if (detailsBtn) detailsBtn.disabled = true;
      if (paidEl) paidEl.hidden = true;
      if (tryBar) tryBar.hidden = true;
      if (hint) {
        hint.hidden = true;
        hint.textContent = "Toggle landlord / resident. Pay from Unit 12, or Replay.";
      }
    };

    const paintLandlordFinal = (withPay: boolean) => {
      setRecovered(withPay ? BASE_RECOVERED + UNIT12_CENTS / 100 : BASE_RECOVERED);
      setOpen(withPay ? OPEN_AFTER : OPEN_BEFORE);
      if (csatEl) csatEl.textContent = "4.6";
      Object.values(stats).forEach((el) => {
        el?.classList.remove("is-working");
        el?.classList.add("is-live");
      });
      if (withPay) recoveredEl?.classList.add("is-tick");
      chart?.classList.add("is-live");
      tableCard?.classList.add("is-live");
      bars.forEach((bar) => bar.classList.add("is-grown"));
      rows.forEach((row) => row.classList.add("is-visible"));
      if (withPay) {
        markUnit12Recovered();
        unit12Row?.classList.add("is-highlight");
      }
    };

    const paintResidentPaid = () => {
      paid = true;
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.hidden = true;
        payBtn.classList.remove("is-pulse");
      }
      if (paidEl) paidEl.hidden = false;
      bill?.classList.add("is-live");
      why?.classList.add("is-live");
    };

    const tickRecovered = async (target: number, durationMs: number, my: number) => {
      if (!recoveredEl) {
        setRecovered(target);
        return;
      }
      recoveredEl.classList.remove("is-tick");
      const from = recoveredDollars;
      const start = performance.now();
      while (true) {
        if (my !== token) return;
        const t = Math.min(1, (performance.now() - start) / durationMs);
        const eased = 1 - Math.pow(1 - t, 3);
        setRecovered(from + (target - from) * eased);
        if (t >= 1) break;
        await sleep(32);
      }
      setRecovered(target);
      recoveredEl.classList.add("is-tick");
      stats.recovered?.classList.add("is-tick");
    };

    const applyPaid = async (my: number, animate: boolean) => {
      paid = true;
      markUnit12Recovered();
      unit12Row?.classList.add("is-highlight");
      setOpen(OPEN_AFTER);
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.hidden = true;
        payBtn.classList.remove("is-pulse");
      }
      if (paidEl) paidEl.hidden = false;
      const target = BASE_RECOVERED + UNIT12_CENTS / 100;
      if (animate) {
        await tickRecovered(target, 900, my);
      } else {
        setRecovered(target);
        recoveredEl?.classList.add("is-tick");
        stats.recovered?.classList.add("is-tick");
      }
    };

    const showTry = () => {
      setTabsEnabled(true);
      if (tryBar) tryBar.hidden = false;
      if (hint) hint.hidden = false;
      clearPulse();
      if (!paid) {
        root.querySelector<HTMLButtonElement>("[data-lv-tab='resident']")?.classList.add("is-pulse");
        if (payBtn) {
          payBtn.disabled = false;
          payBtn.hidden = false;
        }
        if (detailsBtn) detailsBtn.disabled = false;
      }
    };

    const finish = () => {
      running = false;
      setStep("Try it");
      showTry();
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const snapFinal = () => {
      resetBoard();
      paintLandlordFinal(true);
      paintResidentPaid();
      setView("landlord");
      setStep("Recovered");
      finish();
    };

    const run = async () => {
      const my = ++token;
      running = true;
      resetBoard();

      setStep("Loading recoveries…");
      Object.values(stats).forEach((el) => el?.classList.add("is-working"));
      await sleep(900);
      if (my !== token) return;

      setStep("Recovered this month");
      stats.recovered?.classList.remove("is-working");
      stats.recovered?.classList.add("is-live");
      await tickRecovered(BASE_RECOVERED, 700, my);
      if (my !== token) return;
      await sleep(950);
      if (my !== token) return;

      setStep("Open recoveries");
      stats.open?.classList.remove("is-working");
      stats.open?.classList.add("is-live");
      setOpen(OPEN_BEFORE);
      await sleep(1050);
      if (my !== token) return;

      setStep("CSAT score");
      stats.csat?.classList.remove("is-working");
      stats.csat?.classList.add("is-live");
      if (csatEl) csatEl.textContent = "4.6";
      await sleep(900);
      if (my !== token) return;

      setStep("Charting months…");
      chart?.classList.add("is-working");
      await sleep(1000);
      if (my !== token) return;
      chart?.classList.remove("is-working");
      chart?.classList.add("is-live");
      for (const bar of bars) {
        if (my !== token) return;
        bar.classList.add("is-grown");
        await sleep(140);
      }
      bars[bars.length - 1]?.classList.add("is-pulse-bar");
      setStep("August peak");
      await sleep(1150);
      if (my !== token) return;
      bars[bars.length - 1]?.classList.remove("is-pulse-bar");

      setStep("Scanning units…");
      tableCard?.classList.add("is-working");
      await sleep(950);
      if (my !== token) return;
      tableCard?.classList.remove("is-working");
      tableCard?.classList.add("is-live");
      for (let i = 0; i < Math.min(rows.length, 6); i++) {
        if (my !== token) return;
        rows[i]?.classList.add("is-visible");
        await sleep(90);
      }
      rows.forEach((row) => row.classList.add("is-visible"));
      await sleep(900);
      if (my !== token) return;

      setStep("Unit 12 needs reply");
      unit12Row?.classList.add("is-highlight");
      await sleep(1500);
      if (my !== token) return;

      setStep("Resident statement");
      setView("resident");
      bill?.classList.add("is-live");
      why?.classList.add("is-live");
      if (payBtn) {
        payBtn.disabled = false;
        payBtn.classList.add("is-pulse");
      }
      if (detailsBtn) detailsBtn.disabled = false;
      await sleep(1700);
      if (my !== token) return;

      setStep("Posting payment…");
      payBtn?.classList.remove("is-pulse");
      setView("landlord");
      await applyPaid(my, true);
      if (my !== token) return;
      setStep("Payment posted");
      await sleep(900);
      if (my !== token) return;

      finish();
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        snapFinal();
        return;
      }
      void run();
    });

    frame.addEventListener("demo-replay", () => void run());

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (running || tab.disabled) return;
        const id = tab.getAttribute("data-lv-tab");
        if (id !== "landlord" && id !== "resident") return;
        setView(id);
        clearPulse();
        if (id === "resident" && !paid && payBtn && !payBtn.disabled) {
          payBtn.classList.add("is-pulse");
        }
      });
    });

    payBtn?.addEventListener("click", () => {
      if (running || paid || payBtn.disabled) return;
      const my = ++token;
      void (async () => {
        setView("landlord");
        clearPulse();
        setStep("Posting payment…");
        await applyPaid(my, true);
        if (my !== token) return;
        setStep("Try it");
        if (hint) {
          hint.hidden = false;
          hint.textContent = "Unit 12 recovered. Toggle views, or Replay.";
        }
      })();
    });

    replayBtn?.addEventListener("click", () => {
      if (running) return;
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-lv]").forEach((el) => wireLivable(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-lv]").forEach((el) => wireLivable(el as HTMLElement));
  });
</script>

