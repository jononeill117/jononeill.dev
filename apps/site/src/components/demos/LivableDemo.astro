---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="livable-demo"
  system="Billing → allocation → payment"
  cta="Watch a utility bill get split across units, then paid. Then toggle landlord / resident."
  caption="Interactive walkthrough"
>
  <div class="lv" data-lv>
    <header class="lv__head">
      <div class="lv__brand">
        <span class="lv__product">Livable</span>
        <span class="lv__prop">Oak Court · 24 units</span>
      </div>
      <span class="lv__step" data-lv-step>Idle</span>
    </header>

    <div class="lv__toggle" role="tablist" data-lv-toggle>
      <button
        type="button"
        class="lv__tab is-active is-pulse"
        data-lv-tab="landlord"
        role="tab"
        aria-selected="true"
        disabled
      >
        Landlord
      </button>
      <button
        type="button"
        class="lv__tab"
        data-lv-tab="resident"
        role="tab"
        aria-selected="false"
        disabled
      >
        Resident
      </button>
    </div>

    <div class="lv__panel" data-lv-panel="landlord">
      <div class="lv__bill-row">
        <div class="lv__pdf" data-lv-pdf aria-hidden="true">
          <span class="lv__pdf-label">PDF</span>
          <span class="lv__pdf-vendor">APS Utility</span>
          <span class="lv__pdf-amt" data-lv-bill-total>$1,770.50</span>
          <span class="lv__pdf-meta">Oct cycle · Oak Court</span>
        </div>
        <div class="lv__extract" data-lv-extract>
          <p class="lv__extract-title">Extracted</p>
          <dl class="lv__lines">
            <div class="lv__line" data-lv-line="electric">
              <dt>Electric</dt>
              <dd data-lv-electric>-</dd>
            </div>
            <div class="lv__line" data-lv-line="water">
              <dt>Water</dt>
              <dd data-lv-water>-</dd>
            </div>
            <div class="lv__line lv__line--total" data-lv-line="total">
              <dt>Total</dt>
              <dd data-lv-total>-</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="lv__alloc" data-lv-alloc>
        <p class="lv__alloc-title">Unit shares</p>
        <div class="lv__shares" data-lv-shares aria-hidden="true">
          <div class="lv__share" data-lv-share="04" style="--share: 18%"><span>04</span></div>
          <div class="lv__share" data-lv-share="09" style="--share: 28%"><span>09</span></div>
          <div class="lv__share is-focus" data-lv-share="12" style="--share: 12%"><span>12</span></div>
          <div class="lv__share" data-lv-share="18" style="--share: 22%"><span>18</span></div>
          <div class="lv__share" data-lv-share="21" style="--share: 20%"><span>21</span></div>
        </div>
      </div>

      <div class="lv__units-table-wrap">
        <table class="lv__table">
          <thead>
            <tr><th>Unit</th><th>Status</th><th>Share</th></tr>
          </thead>
          <tbody>
            <tr data-lv-row="04"><td>04</td><td data-lv-status="04">Pending</td><td>$312.00</td></tr>
            <tr data-lv-row="09"><td>09</td><td data-lv-status="09">Open</td><td>$128.40</td></tr>
            <tr data-lv-row="12" class="is-focus"><td>12</td><td data-lv-status="12">Open</td><td>$47.20</td></tr>
            <tr data-lv-row="18"><td>18</td><td data-lv-status="18">Pending</td><td>$0.00</td></tr>
          </tbody>
        </table>
      </div>

      <p class="lv__recovered">
        Recovered
        <strong data-lv-recovered>$0.00</strong>
        <span class="lv__recovered-cap">of $1,770.50</span>
      </p>
    </div>

    <div class="lv__panel" data-lv-panel="resident" hidden>
      <p class="lv__resident-kicker">Unit 12 · Oct utility share</p>
      <p class="lv__resident-amt" data-lv-resident-amt>$47.20</p>
      <p class="lv__resident-note" data-lv-resident-note>Electric + water allocation from Oak Court master bill.</p>
      <button type="button" class="lv__pay" data-lv-pay disabled>Pay $47.20</button>
      <p class="lv__paid" data-lv-paid hidden>Paid. Landlord recovery updated.</p>
    </div>

    <div class="lv__try" data-lv-try hidden>
      <p class="lv__hint" data-lv-hint>Toggle views. Pay once from the open unit.</p>
      <button type="button" class="lv__replay" data-lv-replay>Replay</button>
    </div>
  </div>
</DemoFrame>

<script>
  const BILL = {
    electric: "$1,248.30",
    water: "$522.20",
    total: "$1,770.50",
    unit12: "$47.20",
    recoveredAfterPay: "$47.20",
  } as const;

  const SHARE_UNITS = ["04", "09", "12", "18", "21"] as const;

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireLivable(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-lv-wired")) return;
    frame.setAttribute("data-lv-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-lv-step]");
    const pdf = root.querySelector<HTMLElement>("[data-lv-pdf]");
    const extract = root.querySelector<HTMLElement>("[data-lv-extract]");
    const electricEl = root.querySelector<HTMLElement>("[data-lv-electric]");
    const waterEl = root.querySelector<HTMLElement>("[data-lv-water]");
    const totalEl = root.querySelector<HTMLElement>("[data-lv-total]");
    const alloc = root.querySelector<HTMLElement>("[data-lv-alloc]");
    const recoveredEl = root.querySelector<HTMLElement>("[data-lv-recovered]");
    const residentAmt = root.querySelector<HTMLElement>("[data-lv-resident-amt]");
    const residentNote = root.querySelector<HTMLElement>("[data-lv-resident-note]");
    const payBtn = root.querySelector<HTMLButtonElement>("[data-lv-pay]");
    const paidEl = root.querySelector<HTMLElement>("[data-lv-paid]");
    const tryBar = root.querySelector<HTMLElement>("[data-lv-try]");
    const hint = root.querySelector<HTMLElement>("[data-lv-hint]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-lv-replay]");
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-lv-tab]");
    const landlordTab = root.querySelector<HTMLButtonElement>("[data-lv-tab='landlord']");
    const landlordPanel = root.querySelector<HTMLElement>("[data-lv-panel='landlord']");
    const residentPanel = root.querySelector<HTMLElement>("[data-lv-panel='resident']");
    const unit12Row = root.querySelector<HTMLElement>("[data-lv-row='12']");
    const unit12Status = root.querySelector<HTMLElement>("[data-lv-status='12']");

    let running = false;
    let token = 0;
    let paid = false;

    const setStep = (text: string) => {
      if (stepEl) stepEl.textContent = text;
    };

    const setView = (id: "landlord" | "resident") => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute("data-lv-tab") === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (landlordPanel) landlordPanel.hidden = id !== "landlord";
      if (residentPanel) residentPanel.hidden = id !== "resident";
    };

    const setTabsEnabled = (on: boolean) => {
      tabs.forEach((tab) => {
        tab.disabled = !on;
      });
    };

    const clearPulse = () => {
      tabs.forEach((tab) => tab.classList.remove("is-pulse"));
      payBtn?.classList.remove("is-pulse");
    };

    const resetExtract = () => {
      if (electricEl) electricEl.textContent = "-";
      if (waterEl) waterEl.textContent = "-";
      if (totalEl) totalEl.textContent = "-";
      root.querySelectorAll("[data-lv-line]").forEach((el) => el.classList.remove("is-live"));
    };

    const resetShares = () => {
      SHARE_UNITS.forEach((id) => {
        root.querySelector(`[data-lv-share='${id}']`)?.classList.remove("is-live", "is-highlight");
      });
      alloc?.classList.remove("is-live");
    };

    const resetBoard = () => {
      setStep("Idle");
      setView("landlord");
      setTabsEnabled(false);
      clearPulse();
      pdf?.classList.remove("is-live", "is-upload");
      extract?.classList.remove("is-live");
      resetExtract();
      resetShares();
      unit12Row?.classList.remove("is-highlight");
      if (unit12Status) unit12Status.textContent = "Open";
      if (recoveredEl) recoveredEl.textContent = "$0.00";
      recoveredEl?.classList.remove("is-tick");
      if (residentAmt) residentAmt.textContent = BILL.unit12;
      if (residentNote) {
        residentNote.textContent = "Electric + water allocation from Oak Court master bill.";
      }
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.textContent = `Pay ${BILL.unit12}`;
        payBtn.hidden = false;
      }
      if (paidEl) paidEl.hidden = true;
      if (tryBar) tryBar.hidden = true;
      if (hint) hint.hidden = true;
      paid = false;
    };

    const paintExtracted = () => {
      extract?.classList.add("is-live");
      if (electricEl) electricEl.textContent = BILL.electric;
      if (waterEl) waterEl.textContent = BILL.water;
      if (totalEl) totalEl.textContent = BILL.total;
      root.querySelectorAll("[data-lv-line]").forEach((el) => el.classList.add("is-live"));
    };

    const paintAllocation = () => {
      alloc?.classList.add("is-live");
      SHARE_UNITS.forEach((id) => {
        root.querySelector(`[data-lv-share='${id}']`)?.classList.add("is-live");
      });
    };

    const paintUnit12 = () => {
      root.querySelector("[data-lv-share='12']")?.classList.add("is-highlight");
      unit12Row?.classList.add("is-highlight");
    };

    const paintPaid = () => {
      paid = true;
      if (unit12Status) unit12Status.textContent = "Settled";
      if (recoveredEl) recoveredEl.textContent = BILL.recoveredAfterPay;
      recoveredEl?.classList.add("is-tick");
      if (payBtn) {
        payBtn.disabled = true;
        payBtn.hidden = true;
        payBtn.classList.remove("is-pulse");
      }
      if (paidEl) paidEl.hidden = false;
      if (residentNote) residentNote.textContent = "Payment recorded for Unit 12.";
    };

    const showTry = () => {
      setTabsEnabled(true);
      if (tryBar) tryBar.hidden = false;
      if (hint) hint.hidden = false;
      clearPulse();
      landlordTab?.classList.add("is-pulse");
      if (!paid && payBtn) {
        payBtn.disabled = false;
        payBtn.hidden = false;
      }
    };

    const finish = () => {
      running = false;
      setStep("Try it");
      showTry();
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const snapFinal = () => {
      resetBoard();
      setStep("Recovered");
      pdf?.classList.add("is-live", "is-upload");
      paintExtracted();
      paintAllocation();
      paintUnit12();
      setView("resident");
      if (payBtn) {
        payBtn.disabled = false;
        payBtn.hidden = false;
      }
      paintPaid();
      setView("landlord");
      finish();
    };

    const run = async () => {
      const my = ++token;
      running = true;
      resetBoard();

      // 1. Landlord receives utility bill PDF
      setStep("Bill received");
      pdf?.classList.add("is-live");
      await sleep(1200);
      if (my !== token) return;

      // 2. Upload
      setStep("Uploading");
      pdf?.classList.add("is-upload");
      await sleep(900);
      if (my !== token) return;

      // 3. Extract Electric / Water / Total
      setStep("Extracting line items");
      extract?.classList.add("is-live");
      if (electricEl) electricEl.textContent = BILL.electric;
      root.querySelector("[data-lv-line='electric']")?.classList.add("is-live");
      await sleep(700);
      if (my !== token) return;
      if (waterEl) waterEl.textContent = BILL.water;
      root.querySelector("[data-lv-line='water']")?.classList.add("is-live");
      await sleep(700);
      if (my !== token) return;
      if (totalEl) totalEl.textContent = BILL.total;
      root.querySelector("[data-lv-line='total']")?.classList.add("is-live");
      await sleep(800);
      if (my !== token) return;

      // 4. Allocation engine paints unit shares
      setStep("Allocating across units");
      alloc?.classList.add("is-live");
      for (const id of SHARE_UNITS) {
        if (my !== token) return;
        root.querySelector(`[data-lv-share='${id}']`)?.classList.add("is-live");
        await sleep(280);
      }
      await sleep(600);
      if (my !== token) return;

      // 5. Unit 12 tenant bill highlights
      setStep("Unit 12 share");
      paintUnit12();
      await sleep(1100);
      if (my !== token) return;

      // 6. Toggle to Resident: bill + Pay
      setStep("Resident view");
      setView("resident");
      if (payBtn) {
        payBtn.disabled = false;
        payBtn.classList.add("is-pulse");
      }
      await sleep(1300);
      if (my !== token) return;

      // 7. Pay → recovered total ticks up
      setStep("Payment posted");
      payBtn?.classList.remove("is-pulse");
      paintPaid();
      setView("landlord");
      await sleep(1200);
      if (my !== token) return;

      finish();
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        snapFinal();
        return;
      }
      void run();
    });

    frame.addEventListener("demo-replay", () => void run());

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (running || tab.disabled) return;
        const id = tab.getAttribute("data-lv-tab");
        if (id !== "landlord" && id !== "resident") return;
        setView(id);
        clearPulse();
        if (id === "resident" && !paid && payBtn && !payBtn.disabled) {
          payBtn.classList.add("is-pulse");
        }
      });
    });

    payBtn?.addEventListener("click", () => {
      if (running || paid || payBtn.disabled) return;
      paintPaid();
      setView("landlord");
      clearPulse();
      if (hint) hint.textContent = "Unit 12 settled. Toggle landlord / resident, or Replay.";
    });

    replayBtn?.addEventListener("click", () => {
      if (running) return;
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-lv]").forEach((el) => wireLivable(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-lv]").forEach((el) => wireLivable(el as HTMLElement));
  });
</script>

<style>
  .lv {
    --lv-canvas: #0b0a09;
    --lv-ink: #f2ebe1;
    --lv-copper: #b87333;
    --lv-muted: color-mix(in srgb, var(--lv-ink) 42%, transparent);
    --lv-line: color-mix(in srgb, var(--lv-ink) 14%, transparent);
    --lv-panel: color-mix(in srgb, var(--lv-ink) 6%, transparent);

    height: 100%;
    padding: var(--s-4);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    color: var(--lv-ink);
    background:
      radial-gradient(ellipse at 8% 0%, color-mix(in srgb, var(--lv-copper) 18%, transparent), transparent 46%),
      linear-gradient(180deg, color-mix(in srgb, var(--lv-ink) 4%, transparent), transparent 40%),
      var(--lv-canvas);
  }

  .lv__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .lv__brand {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
  }

  .lv__product {
    color: var(--lv-copper);
  }

  .lv__prop {
    color: var(--lv-muted);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
    font-size: var(--t-body-sm);
  }

  .lv__step {
    color: var(--lv-muted);
  }

  .lv__toggle {
    display: flex;
    gap: var(--s-2);
  }

  .lv__tab {
    flex: 1;
    padding: var(--s-2) var(--s-3);
    border: var(--hairline) solid var(--lv-line);
    background: transparent;
    color: var(--lv-muted);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    cursor: pointer;
  }

  .lv__tab:disabled {
    cursor: default;
    opacity: 0.7;
  }

  .lv__tab.is-active {
    border-color: color-mix(in srgb, var(--lv-copper) 55%, var(--lv-line));
    color: var(--lv-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lv-copper) 28%, transparent);
  }

  .lv__tab.is-pulse {
    animation: lv-control-pulse 1.6s var(--ease-out, ease-out) infinite;
  }

  .lv__panel {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    min-height: 0;
  }

  .lv__bill-row {
    display: grid;
    grid-template-columns: minmax(7rem, 9rem) 1fr;
    gap: var(--s-3);
    align-items: stretch;
  }

  .lv__pdf {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding: var(--s-3);
    border: var(--hairline) solid var(--lv-line);
    background: var(--lv-panel);
    opacity: 0.35;
    transition:
      opacity var(--dur-base, 240ms) var(--ease-out, ease-out),
      border-color var(--dur-base, 240ms) var(--ease-out, ease-out);
  }

  .lv__pdf.is-live {
    opacity: 1;
    border-color: color-mix(in srgb, var(--lv-copper) 45%, var(--lv-line));
  }

  .lv__pdf.is-upload {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lv-copper) 35%, transparent);
  }

  .lv__pdf-label {
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-copper);
  }

  .lv__pdf-vendor {
    font-size: var(--t-body-sm);
    color: var(--lv-ink);
  }

  .lv__pdf-amt {
    margin-block-start: var(--s-2);
    font-size: var(--t-body-lg);
    font-weight: var(--fw-semibold);
    color: var(--lv-ink);
  }

  .lv__pdf-meta {
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-muted);
  }

  .lv__extract {
    padding: var(--s-3);
    border: var(--hairline) solid var(--lv-line);
    background: var(--lv-panel);
    opacity: 0.4;
    transition: opacity var(--dur-base, 240ms) var(--ease-out, ease-out);
  }

  .lv__extract.is-live {
    opacity: 1;
  }

  .lv__extract-title,
  .lv__alloc-title {
    margin: 0 0 var(--s-2);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-muted);
  }

  .lv__lines {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }

  .lv__line {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: var(--t-mono-sm);
    color: var(--lv-muted);
    opacity: 0.45;
    transition:
      opacity var(--dur-quick, 160ms) ease,
      color var(--dur-quick, 160ms) ease;
  }

  .lv__line.is-live {
    opacity: 1;
    color: var(--lv-ink);
  }

  .lv__line dt {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .lv__line dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .lv__line--total.is-live {
    color: var(--lv-copper);
  }

  .lv__alloc {
    opacity: 0.4;
    transition: opacity var(--dur-base, 240ms) var(--ease-out, ease-out);
  }

  .lv__alloc.is-live {
    opacity: 1;
  }

  .lv__shares {
    display: flex;
    align-items: flex-end;
    gap: var(--s-2);
    height: 3.5rem;
  }

  .lv__share {
    flex: 1;
    height: var(--share);
    min-height: 0.75rem;
    display: grid;
    place-items: end center;
    padding-block-end: 0.15rem;
    border: var(--hairline) solid var(--lv-line);
    background: color-mix(in srgb, var(--lv-copper) 18%, transparent);
    opacity: 0.25;
    transition:
      opacity var(--dur-quick, 160ms) ease,
      border-color var(--dur-quick, 160ms) ease,
      background var(--dur-quick, 160ms) ease;
  }

  .lv__share span {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-muted);
  }

  .lv__share.is-live {
    opacity: 1;
  }

  .lv__share.is-highlight {
    border-color: var(--lv-copper);
    background: color-mix(in srgb, var(--lv-copper) 38%, transparent);
  }

  .lv__share.is-highlight span {
    color: var(--lv-ink);
  }

  .lv__units-table-wrap {
    overflow: auto;
  }

  .lv__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-mono-sm);
  }

  .lv__table th,
  .lv__table td {
    padding: var(--s-2);
    text-align: left;
    border-block-end: var(--hairline) solid var(--lv-line);
  }

  .lv__table th {
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-muted);
  }

  .lv__table tr.is-highlight td {
    color: var(--lv-copper);
  }

  .lv__recovered {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--font-label);
    font-size: var(--t-mono-xs);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--lv-muted);
  }

  .lv__recovered strong {
    font-size: var(--t-body-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-body);
    color: var(--lv-ink);
    font-variant-numeric: tabular-nums;
  }

  .lv__recovered strong.is-tick {
    color: var(--lv-copper);
  }

