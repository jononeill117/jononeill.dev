---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="homelight-demo"
  system="Lead → model → offer"
  cta="Watch one lead become an automated offer."
  caption="Interactive walkthrough"
>
  <div class="hl" data-hl>
    <header class="hl__head">
      <span class="hl__kicker" data-hl-step>Ready</span>
      <span class="hl__count" data-hl-count>0 of 300</span>
    </header>

    <p class="hl__addr" data-hl-addr>918 Maple Ave</p>

    <div class="hl__nodes" role="list">
      <div class="hl__node" data-hl-node="lead" role="listitem">
        <span class="hl__node-name">Lead</span>
        <span class="hl__node-detail" data-hl-detail="lead">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="avm" role="listitem">
        <span class="hl__node-name">AVM</span>
        <span class="hl__node-detail" data-hl-detail="avm">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="tax" role="listitem">
        <span class="hl__node-name">Tax</span>
        <span class="hl__node-detail" data-hl-detail="tax">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="mls" role="listitem">
        <span class="hl__node-name">MLS</span>
        <span class="hl__node-detail" data-hl-detail="mls">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="rehab" role="listitem">
        <span class="hl__node-name">Rehab</span>
        <span class="hl__node-detail" data-hl-detail="rehab">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="offer" role="listitem">
        <span class="hl__node-name">Offer</span>
        <span class="hl__node-detail" data-hl-detail="offer">Waiting</span>
      </div>
      <div class="hl__node" data-hl-node="email" role="listitem">
        <span class="hl__node-name">Email</span>
        <span class="hl__node-detail" data-hl-detail="email">Waiting</span>
      </div>
    </div>

    <div class="hl__result" data-hl-result hidden>
      <p class="hl__price" data-hl-price>$412,000 · 86% of list</p>
      <p class="hl__note">No analyst in the loop</p>
    </div>

    <div class="hl__actions">
      <p class="hl__hint" data-hl-hint hidden>Now explore it yourself.</p>
      <button type="button" class="hl__btn hl__btn--pulse" data-hl-try hidden>
        Run another offer
      </button>
      <button type="button" class="hl__btn" data-hl-replay hidden>Replay</button>
    </div>
  </div>
</DemoFrame>

<script>
  type HlBeat = {
    id: string;
    progressLabel: string;
    resolvedLabel: string;
    progressDetail: string;
    valueKey: keyof HlOfferValues;
    progressMs: number;
    resolveMs: number;
  };

  type HlOfferValues = {
    address: string;
    lead: string;
    avm: string;
    tax: string;
    mls: string;
    rehab: string;
    offer: string;
    email: string;
  };

  const BEATS: HlBeat[] = [
    {
      id: "lead",
      progressLabel: "Receiving lead…",
      resolvedLabel: "Lead in",
      progressDetail: "Ingesting listing…",
      valueKey: "lead",
      progressMs: 1000,
      resolveMs: 500,
    },
    {
      id: "avm",
      progressLabel: "Pricing AVM…",
      resolvedLabel: "AVM locked",
      progressDetail: "Running valuation model…",
      valueKey: "avm",
      progressMs: 1400,
      resolveMs: 600,
    },
    {
      id: "tax",
      progressLabel: "Pulling assessor…",
      resolvedLabel: "Tax matched",
      progressDetail: "Querying public records…",
      valueKey: "tax",
      progressMs: 1200,
      resolveMs: 500,
    },
    {
      id: "mls",
      progressLabel: "Loading comps…",
      resolvedLabel: "MLS loaded",
      progressDetail: "Matching neighborhood comps…",
      valueKey: "mls",
      progressMs: 1200,
      resolveMs: 500,
    },
    {
      id: "rehab",
      progressLabel: "Scoring condition…",
      resolvedLabel: "Rehab scored",
      progressDetail: "Estimating scope hold…",
      valueKey: "rehab",
      progressMs: 1200,
      resolveMs: 500,
    },
    {
      id: "offer",
      progressLabel: "Calculating offer…",
      resolvedLabel: "Offer painted",
      progressDetail: "Risk-adjusting price…",
      valueKey: "offer",
      progressMs: 1600,
      resolveMs: 700,
    },
    {
      id: "email",
      progressLabel: "Sending offer…",
      resolvedLabel: "Email out",
      progressDetail: "Composing seller email…",
      valueKey: "email",
      progressMs: 1000,
      resolveMs: 500,
    },
  ];

  const OFFERS: HlOfferValues[] = [
    {
      address: "918 Maple Ave",
      lead: "918 Maple Ave · seller intent",
      avm: "$428,000",
      tax: "Assessed $401,200 · 2025",
      mls: "18 DOM · last list $479,000",
      rehab: "Rehab scope $18,400",
      offer: "$412,000 · 86% of list",
      email: "Sent · no analyst in loop",
    },
    {
      address: "441 Cedar Ct",
      lead: "441 Cedar Ct · seller intent",
      avm: "$402,500",
      tax: "Assessed $378,900 · 2025",
      mls: "24 DOM · last list $465,000",
      rehab: "Rehab scope $22,100",
      offer: "$389,500 · 84% of list",
      email: "Sent · no analyst in loop",
    },
    {
      address: "72 Birch Rd",
      lead: "72 Birch Rd · seller intent",
      avm: "$471,000",
      tax: "Assessed $449,800 · 2025",
      mls: "11 DOM · last list $522,000",
      rehab: "Rehab scope $14,900",
      offer: "$455,200 · 87% of list",
      email: "Sent · no analyst in loop",
    },
  ];

  function sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }

  function wireHomeLight(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-hl-wired")) return;
    frame.setAttribute("data-hl-wired", "true");

    const stepEl = root.querySelector<HTMLElement>("[data-hl-step]");
    const countEl = root.querySelector<HTMLElement>("[data-hl-count]");
    const addrEl = root.querySelector<HTMLElement>("[data-hl-addr]");
    const result = root.querySelector<HTMLElement>("[data-hl-result]");
    const priceEl = root.querySelector<HTMLElement>("[data-hl-price]");
    const tryBtn = root.querySelector<HTMLButtonElement>("[data-hl-try]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-hl-replay]");
    const hint = root.querySelector<HTMLElement>("[data-hl-hint]");

    let running = false;
    let token = 0;
    let offerIndex = 0;
    let completedCount = 0;

    const currentOffer = () => OFFERS[offerIndex] ?? OFFERS[0]!;

    const clearNodeState = (id: string) => {
      root.querySelector(`[data-hl-node='${id}']`)?.classList.remove("is-working", "is-live");
    };

    const setWorking = (id: string, detail: string) => {
      clearNodeState(id);
      root.querySelector(`[data-hl-node='${id}']`)?.classList.add("is-working");
      const d = root.querySelector(`[data-hl-detail='${id}']`);
      if (d) d.textContent = detail;
    };

    const setLive = (id: string, detail: string) => {
      clearNodeState(id);
      root.querySelector(`[data-hl-node='${id}']`)?.classList.add("is-live");
      const d = root.querySelector(`[data-hl-detail='${id}']`);
      if (d) d.textContent = detail;
    };

    const resetBoard = () => {
      BEATS.forEach((s) => {
        clearNodeState(s.id);
        const d = root.querySelector(`[data-hl-detail='${s.id}']`);
        if (d) d.textContent = "Waiting";
      });
      if (stepEl) stepEl.textContent = "Ready";
      if (countEl) countEl.textContent = `${completedCount} of 300`;
      if (addrEl) addrEl.textContent = currentOffer().address;
      if (result) result.hidden = true;
      if (tryBtn) tryBtn.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      if (hint) hint.hidden = true;
      tryBtn?.classList.remove("is-pulse");
    };

    const paintFinal = () => {
      const offer = currentOffer();
      BEATS.forEach((s) => setLive(s.id, offer[s.valueKey]));
      if (addrEl) addrEl.textContent = offer.address;
      if (priceEl) priceEl.textContent = offer.offer;
      if (result) result.hidden = false;
      completedCount = Math.max(completedCount, 1);
      if (countEl) countEl.textContent = `${completedCount} of 300`;
    };

    const finish = () => {
      running = false;
      completedCount = Math.min(300, Math.max(completedCount, 1));
      if (countEl) countEl.textContent = `${completedCount} of 300`;
      if (stepEl) stepEl.textContent = "Offer sent";
      if (result) result.hidden = false;
      if (tryBtn) tryBtn.hidden = false;
      if (replayBtn) replayBtn.hidden = false;
      if (hint) hint.hidden = false;
      tryBtn?.classList.add("is-pulse");
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const run = async () => {
      const my = ++token;
      running = true;
      resetBoard();
      if (tryBtn) tryBtn.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      if (hint) hint.hidden = true;

      const offer = currentOffer();
      if (addrEl) addrEl.textContent = offer.address;

      for (const beat of BEATS) {
        if (my !== token) return;

        if (stepEl) stepEl.textContent = beat.progressLabel;
        setWorking(beat.id, beat.progressDetail);
        await sleep(beat.progressMs);
        if (my !== token) return;

        const value = offer[beat.valueKey];
        setLive(beat.id, value);
        if (stepEl) stepEl.textContent = beat.resolvedLabel;

        if (beat.id === "offer") {
          if (priceEl) priceEl.textContent = offer.offer;
          if (result) result.hidden = false;
        }

        if (beat.id === "email") {
          completedCount = Math.max(completedCount, 1);
          if (countEl) countEl.textContent = `${completedCount} of 300`;
        }

        await sleep(beat.resolveMs);
        if (my !== token) return;
      }

      finish();
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        resetBoard();
        paintFinal();
        finish();
        return;
      }
      void run();
    });
    frame.addEventListener("demo-replay", () => {
      offerIndex = 0;
      completedCount = 0;
      void run();
    });

    tryBtn?.addEventListener("click", () => {
      if (running) return;
      offerIndex = (offerIndex + 1) % OFFERS.length;
      completedCount = Math.min(300, completedCount + 1);
      void run();
    });
    replayBtn?.addEventListener("click", () => {
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-hl]").forEach((el) => wireHomeLight(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-hl]").forEach((el) => wireHomeLight(el as HTMLElement));
  });
</script>

<style>
  .hl {
    --hl-copper: var(--accent, #b87333);
    height: 100%;
    padding: var(--s-4);
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--s-3);
    color: var(--fg);
    background:
      radial-gradient(ellipse at top right, color-mix(in srgb, var(--hl-copper) 16%, transparent), transparent 55%),
      var(--bg);
  }

  .hl__head {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--font-label);
    font-size: var(--t-mono-md);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .hl__kicker {
    color: var(--hl-copper);
  }

  .hl__count {
    color: var(--fg-muted);
  }

  .hl__addr {
    margin: 0;
    font-size: var(--t-proof, var(--t-body));
    color: var(--fg-secondary);
  }

  .hl__nodes {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--s-2);
    align-content: start;
  }

  .hl__node {
    border: var(--hairline) solid var(--hairline-color);
    padding: var(--s-3);
    display: grid;
    gap: var(--s-2);
    min-height: 5rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .hl__node.is-working {
    border-color: color-mix(in srgb, var(--hl-copper) 70%, var(--hairline-color));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--hl-copper) 30%, transparent);
    animation: hl-working 1.4s ease-in-out infinite;
  }

  .hl__node.is-live {
    border-color: var(--hl-copper);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--hl-copper) 45%, transparent);
    animation: none;
  }

  .hl__node-name {
    font-family: var(--font-label);
    font-size: var(--t-mono-md);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .hl__node-detail {
    font-size: var(--t-body-sm);
    color: var(--fg-secondary);
    line-height: 1.35;
  }

  .hl__node.is-working .hl__node-detail {
    color: var(--hl-copper);
  }

  .hl__result {
    border-block-start: var(--hairline) solid var(--hairline-color);
    padding-block-start: var(--s-3);
    display: grid;
    gap: var(--s-1);
  }

  .hl__price {
    margin: 0;
    font-size: var(--t-proof, var(--t-body));
    color: var(--hl-copper);
  }

  .hl__note {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-mono-md);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .hl__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .hl__hint {
    margin: 0;
    font-size: var(--t-proof, var(--t-body-sm));
    color: var(--fg-secondary);
  }

  .hl__btn {
    padding: var(--s-2) var(--s-4);
    border: var(--hairline) solid var(--hairline-color);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-label);
    font-size: var(--t-mono-md);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    cursor: pointer;
  }

  .hl__btn--pulse.is-pulse {
    border-color: var(--hl-copper);
    color: var(--hl-copper);
    animation: hl-pulse 1.6s ease-out infinite;
  }

  @keyframes hl-working {
    0%,
    100% {
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--hl-copper) 20%, transparent);
      opacity: 1;
    }
    50% {
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--hl-copper) 55%, transparent);
      opacity: 0.88;
    }
  }

  @keyframes hl-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--hl-copper) 0%, transparent);
    }
    50% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--hl-copper) 28%, transparent);
    }
  }

  @media (max-width: 48rem) {
    .hl__nodes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .hl__nodes {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hl__node.is-working,
    .hl__btn--pulse.is-pulse {
      transition: none;
      animation: none;
    }
  }
</style>
