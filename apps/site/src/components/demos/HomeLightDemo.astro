---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="homelight-demo"
  aspect="16 / 10"
  system="Lead → model → offer"
  cta="Watch one lead become an automated offer."
  caption="Interactive walkthrough"
>
  <div class="cc" data-cc>
    <header class="cc__head">
      <div class="cc__brand">
        <span class="cc__mark" aria-hidden="true">CC</span>
        <span class="cc__name">Cash Close</span>
        <span class="cc__tag">Automated Offer Engine</span>
      </div>
      <div class="cc__meta">
        <span>Market: <strong>Greenfield, OH</strong></span>
        <span class="cc__dot" aria-hidden="true"></span>
        <span>Queue: <strong>14 pending</strong></span>
        <span class="cc__dot" aria-hidden="true"></span>
        <span>Model: <strong>v2.4.1</strong></span>
      </div>
      <div class="cc__count-box">
        <span class="cc__count" data-cc-count>0</span>
        <span class="cc__count-label">/ 300 offers / mo</span>
      </div>
    </header>

    <div class="cc__main">
      <aside class="cc__listing">
        <div class="cc__photo">
          <svg class="cc__photo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="cc__photo-label">No photo · demo only</span>
        </div>
        <div class="cc__listing-body">
          <h3 class="cc__addr">918 Maple Ave</h3>
          <p class="cc__city">Greenfield, OH 45123 · Greene County</p>
          <div class="cc__stats">
            <div class="cc__stat">
              <span class="cc__stat-val">3</span>
              <span class="cc__stat-lab">Beds</span>
            </div>
            <div class="cc__stat">
              <span class="cc__stat-val">1.5</span>
              <span class="cc__stat-lab">Baths</span>
            </div>
            <div class="cc__stat">
              <span class="cc__stat-val">1,842</span>
              <span class="cc__stat-lab">Sq Ft</span>
            </div>
          </div>
          <dl class="cc__facts">
            <div><dt>List price</dt><dd class="cc__mono">$389,000</dd></div>
            <div><dt>Year built</dt><dd>1964</dd></div>
            <div><dt>Lot size</dt><dd>0.28 ac</dd></div>
            <div><dt>Type</dt><dd>SFR</dd></div>
            <div><dt>Lead source</dt><dd>Inbound web</dd></div>
            <div><dt>Agent</dt><dd>M. Calloway</dd></div>
            <div><dt>Days on market</dt><dd>12</dd></div>
          </dl>
          <p class="cc__status">
            <span class="cc__status-dot" data-cc-status-dot></span>
            Status: <strong data-cc-status>Awaiting offer</strong>
          </p>
        </div>
      </aside>

      <div class="cc__right">
        <section class="cc__pipeline">
          <div class="cc__pipeline-head">
            <div>
              <h3 class="cc__pipeline-title">Offer Pipeline</h3>
              <p class="cc__pipeline-sub">918 Maple Ave · Run #OCE-2847 · 2026-08-29</p>
            </div>
            <div class="cc__pipeline-actions">
              <button type="button" class="cc__btn cc__btn--ghost" data-cc-replay hidden>
                Replay
              </button>
              <button type="button" class="cc__btn cc__btn--run" data-cc-run>
                <span class="cc__spin" data-cc-spin hidden aria-hidden="true"></span>
                <span data-cc-run-label>Run offer</span>
              </button>
            </div>
          </div>

          <div class="cc__nodes" role="list">
            <div class="cc__node" data-cc-node="lead" role="listitem">
              <div class="cc__node-icon" data-cc-icon="lead">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="cc__node-label">Lead In</span>
              <span class="cc__node-sub">Inbound web</span>
            </div>
            <div class="cc__line" data-cc-line="0"><span></span></div>
            <div class="cc__node" data-cc-node="sources" role="listitem">
              <div class="cc__node-icon" data-cc-icon="sources">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
              </div>
              <span class="cc__node-label">Data Sources</span>
              <span class="cc__node-sub">4 feeds</span>
            </div>
            <div class="cc__line" data-cc-line="1"><span></span></div>
            <div class="cc__node" data-cc-node="model" role="listitem">
              <div class="cc__node-icon" data-cc-icon="model">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M8 21h8M12 17v4"></path>
                </svg>
              </div>
              <span class="cc__node-label">Underwriting</span>
              <span class="cc__node-sub">Model v2.4</span>
            </div>
            <div class="cc__line" data-cc-line="2"><span></span></div>
            <div class="cc__node cc__node--green" data-cc-node="email" role="listitem">
              <div class="cc__node-icon" data-cc-icon="email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <span class="cc__node-label">Offer Email</span>
              <span class="cc__node-sub">Outbound</span>
            </div>
          </div>

          <div class="cc__sources">
            <p class="cc__sources-label">Data Sources</p>
            <div class="cc__chips">
              <div class="cc__chip" data-cc-chip="0">
                <span class="cc__chip-name">AVM</span>
                <span class="cc__chip-desc">Automated valuation</span>
              </div>
              <div class="cc__chip" data-cc-chip="1">
                <span class="cc__chip-name">Tax Record</span>
                <span class="cc__chip-desc">County assessor</span>
              </div>
              <div class="cc__chip" data-cc-chip="2">
                <span class="cc__chip-name">MLS</span>
                <span class="cc__chip-desc">Active listing data</span>
              </div>
              <div class="cc__chip" data-cc-chip="3">
                <span class="cc__chip-name">Rehab Model</span>
                <span class="cc__chip-desc">Repair estimate</span>
              </div>
            </div>
          </div>
        </section>

        <div class="cc__results">
          <section class="cc__model" data-cc-model>
            <div class="cc__model-head">
              <span class="cc__eyebrow">Underwriting Output</span>
              <span class="cc__badge" data-cc-badge hidden>Complete</span>
            </div>
            <div class="cc__model-idle" data-cc-model-idle>Awaiting model run</div>
            <div class="cc__model-live" data-cc-model-live hidden>
              <div class="cc__offer-block">
                <span class="cc__offer-label">Cash offer price</span>
                <span class="cc__offer-price">$412,000</span>
              </div>
              <div class="cc__conf">
                <div class="cc__conf-row">
                  <span>Model confidence</span>
                  <span class="cc__mono">86%</span>
                </div>
                <div class="cc__conf-track">
                  <div class="cc__conf-fill" data-cc-conf></div>
                </div>
              </div>
              <div class="cc__metrics">
                <div class="cc__metric">
                  <span class="cc__metric-lab">AVM range</span>
                  <span class="cc__metric-val">$398-$425k</span>
                </div>
                <div class="cc__metric">
                  <span class="cc__metric-lab">ARV</span>
                  <span class="cc__metric-val">$461,000</span>
                </div>
                <div class="cc__metric">
                  <span class="cc__metric-lab">Repair est.</span>
                  <span class="cc__metric-val">$18,500</span>
                </div>
                <div class="cc__metric">
                  <span class="cc__metric-lab">MAO</span>
                  <span class="cc__metric-val">$398,000</span>
                </div>
              </div>
            </div>
          </section>

          <section class="cc__email" data-cc-email>
            <div class="cc__email-idle" data-cc-email-idle>
              Email preview appears<br />after underwriting completes
            </div>
            <div class="cc__email-live" data-cc-email-live hidden>
              <div class="cc__email-bar">
                <div>
                  <span class="cc__eyebrow">Offer Email Preview</span>
                  <p class="cc__email-queued">
                    <span class="cc__email-dot" aria-hidden="true"></span>
                    Queued for delivery
                  </p>
                </div>
                <span class="cc__email-id">#OE-1847</span>
              </div>
              <div class="cc__email-body">
                <div class="cc__email-fields">
                  <p><span>To:</span> seller@918maple.example.com</p>
                  <p><span>From:</span> offers@cashclose.io</p>
                  <p><span>Subject:</span> Cash offer - 918 Maple Ave</p>
                </div>
                <div class="cc__email-copy">
                  <p class="cc__email-headline">Offer ready for 918 Maple Ave.</p>
                  <p>
                    We're pleased to present a cash offer of
                    <strong class="cc__green">$412,000</strong>
                    for your property at 918 Maple Ave, Greenfield, OH.
                  </p>
                  <p>
                    This offer <strong>expires in 48 hours</strong>. No repairs required. Close on your schedule.
                  </p>
                  <button type="button" class="cc__accept" tabindex="-1">Review &amp; Accept Offer →</button>
                </div>
              </div>
            </div>
          </section>
        </div>

        <div class="cc__try-row" data-cc-try-row hidden>
          <p class="cc__hint" data-cc-hint>Now explore it yourself.</p>
          <button type="button" class="cc__btn cc__btn--run cc__btn--pulse" data-cc-try>
            Run another offer
          </button>
        </div>
      </div>
    </div>
  </div>
</DemoFrame>

<script>
  type CcStage = "idle" | "sources" | "model" | "email" | "complete";

  const CHECK_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

  const ICON_SVGS: Record<string, string> = {
    lead: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    sources: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`,
    model: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><path d="M8 21h8M12 17v4"></path></svg>`,
    email: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`,
  };

  function wireCashClose(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-cc-wired")) return;
    frame.setAttribute("data-cc-wired", "true");

    const countEl = root.querySelector<HTMLElement>("[data-cc-count]");
    const statusEl = root.querySelector<HTMLElement>("[data-cc-status]");
    const statusDot = root.querySelector<HTMLElement>("[data-cc-status-dot]");
    const runBtn = root.querySelector<HTMLButtonElement>("[data-cc-run]");
    const runLabel = root.querySelector<HTMLElement>("[data-cc-run-label]");
    const spin = root.querySelector<HTMLElement>("[data-cc-spin]");
    const replayBtn = root.querySelector<HTMLButtonElement>("[data-cc-replay]");
    const tryBtn = root.querySelector<HTMLButtonElement>("[data-cc-try]");
    const tryRow = root.querySelector<HTMLElement>("[data-cc-try-row]");
    const modelCard = root.querySelector<HTMLElement>("[data-cc-model]");
    const modelIdle = root.querySelector<HTMLElement>("[data-cc-model-idle]");
    const modelLive = root.querySelector<HTMLElement>("[data-cc-model-live]");
    const badge = root.querySelector<HTMLElement>("[data-cc-badge]");
    const conf = root.querySelector<HTMLElement>("[data-cc-conf]");
    const emailCard = root.querySelector<HTMLElement>("[data-cc-email]");
    const emailIdle = root.querySelector<HTMLElement>("[data-cc-email-idle]");
    const emailLive = root.querySelector<HTMLElement>("[data-cc-email-live]");
    const chips = Array.from(root.querySelectorAll<HTMLElement>("[data-cc-chip]"));
    const lines = [
      root.querySelector<HTMLElement>('[data-cc-line="0"] span'),
      root.querySelector<HTMLElement>('[data-cc-line="1"] span'),
      root.querySelector<HTMLElement>('[data-cc-line="2"] span'),
    ];

    let stage: CcStage = "idle";
    let offerCount = 0;
    let activeSourceIdx = -1;
    let timers: ReturnType<typeof setTimeout>[] = [];
    let tryMode = false;

    const clearTimers = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const schedule = (fn: () => void, ms: number) => {
      timers.push(setTimeout(fn, ms));
    };

    const setNode = (id: string, active: boolean, done: boolean) => {
      const node = root.querySelector(`[data-cc-node="${id}"]`);
      const icon = root.querySelector(`[data-cc-icon="${id}"]`);
      if (!node || !icon) return;
      node.classList.toggle("is-active", active);
      node.classList.toggle("is-done", done);
      if (done) {
        icon.innerHTML = CHECK_SVG;
      } else {
        icon.innerHTML = ICON_SVGS[id] ?? "";
      }
    };

    const setLine = (index: number, pct: number) => {
      const el = lines[index];
      if (el) el.style.width = `${pct}%`;
    };

    const setChips = (idx: number) => {
      activeSourceIdx = idx;
      chips.forEach((chip, i) => {
        chip.classList.toggle("is-active", idx >= i);
      });
    };

    const setRunningUi = (running: boolean) => {
      if (runBtn) runBtn.disabled = running;
      if (spin) spin.hidden = !running;
      if (runLabel) runLabel.textContent = running ? "Running…" : "Run offer";
    };

    const paintStage = (next: CcStage) => {
      stage = next;
      const order: CcStage[] = ["idle", "sources", "model", "email", "complete"];
      const idx = order.indexOf(next);
      const showModel = idx >= 2;
      const showEmail = idx >= 3;

      setNode("lead", idx >= 1, idx >= 1);
      setNode("sources", idx >= 1, idx >= 2);
      setNode("model", idx >= 2, idx >= 3);
      setNode("email", idx >= 3, idx >= 4);

      if (modelCard) modelCard.classList.toggle("is-live", showModel);
      if (modelIdle) modelIdle.hidden = showModel;
      if (modelLive) modelLive.hidden = !showModel;
      if (badge) badge.hidden = !showModel;
      if (conf) {
        conf.style.width = showModel ? "86%" : "0%";
      }

      if (emailCard) emailCard.classList.toggle("is-live", showEmail);
      if (emailIdle) emailIdle.hidden = showEmail;
      if (emailLive) emailLive.hidden = !showEmail;

      if (statusEl) {
        statusEl.textContent =
          next === "complete" ? "Offer queued" : next === "idle" ? "Awaiting offer" : "Generating offer";
      }
      if (statusDot) {
        statusDot.classList.toggle("is-done", next === "complete");
        statusDot.classList.toggle("is-run", idx > 0 && next !== "complete");
      }

      if (countEl) countEl.textContent = String(offerCount);
      if (replayBtn) replayBtn.hidden = next !== "complete";
      setRunningUi(idx > 0 && idx < 4);
    };

    const resetBoard = () => {
      clearTimers();
      offerCount = 0;
      setChips(-1);
      setLine(0, 0);
      setLine(1, 0);
      setLine(2, 0);
      if (conf) conf.style.width = "0%";
      if (tryRow) tryRow.hidden = true;
      paintStage("idle");
    };

    const finish = () => {
      offerCount = 1;
      paintStage("complete");
      if (tryMode && tryRow) tryRow.hidden = false;
      frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
    };

    const runOffer = () => {
      clearTimers();
      offerCount = 0;
      setChips(-1);
      setLine(0, 0);
      setLine(1, 0);
      setLine(2, 0);
      if (conf) conf.style.width = "0%";
      if (tryRow) tryRow.hidden = true;
      if (replayBtn) replayBtn.hidden = true;
      paintStage("idle");

      schedule(() => {
        paintStage("sources");
        setLine(0, 100);
      }, 1100);
      schedule(() => setChips(0), 1400);
      schedule(() => setChips(1), 1760);
      schedule(() => setChips(2), 2120);
      schedule(() => setChips(3), 2480);
      schedule(() => {
        paintStage("model");
        setLine(1, 100);
      }, 3150);
      schedule(() => {
        paintStage("email");
        setLine(2, 100);
      }, 4500);
      schedule(() => finish(), 5400);
    };

    const paintFinal = () => {
      clearTimers();
      setChips(3);
      setLine(0, 100);
      setLine(1, 100);
      setLine(2, 100);
      offerCount = 1;
      paintStage("complete");
      if (tryMode && tryRow) tryRow.hidden = false;
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      tryMode = false;
      if (detail?.reduced) {
        paintFinal();
        frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
        return;
      }
      runOffer();
    });

    frame.addEventListener("demo-replay", () => {
      tryMode = false;
      resetBoard();
      runOffer();
    });

    frame.addEventListener("demo-complete", () => {
      tryMode = true;
      if (stage === "complete" && tryRow) tryRow.hidden = false;
    });

    runBtn?.addEventListener("click", () => {
      if (stage !== "idle" && stage !== "complete") return;
      runOffer();
    });

    tryBtn?.addEventListener("click", () => {
      if (stage !== "idle" && stage !== "complete") return;
      runOffer();
    });

    replayBtn?.addEventListener("click", () => {
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-cc]").forEach((el) => wireCashClose(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-cc]").forEach((el) => wireCashClose(el as HTMLElement));
  });
</script>

<style>
  .cc {
    --cc-navy: #0d2240;
    --cc-navy-deep: #0b1929;
    --cc-navy-mid: #1b2d52;
    --cc-green: #16a34a;
    --cc-green-dark: #15803d;
    --cc-green-bright: #22c55e;
    --cc-green-soft: #f0fdf4;
    --cc-green-border: #86efac;
    --cc-green-badge: #bbf7d0;
    --cc-bg: #eef0f5;
    --cc-card: #ffffff;
    --cc-muted: #8693ae;
    --cc-faint: #bcc5d8;
    --cc-line: #d4daea;
    --cc-soft: #f4f6fa;
    --cc-track: #e8ebf3;
    --cc-body: #4a5568;
    --cc-amber: #f59e0b;
    --cc-sans: "DM Sans", "Segoe UI", Helvetica, Arial, sans-serif;
    --cc-mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;

    height: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--cc-bg);
    color: var(--cc-navy);
    font-family: var(--cc-sans);
    font-size: 13px;
    line-height: 1.4;
    overflow: hidden;
  }

  .cc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.65rem 1rem;
    background: var(--cc-navy);
    color: #fff;
    flex-shrink: 0;
  }

  .cc__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .cc__mark {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.35rem;
    background: var(--cc-green-bright);
    color: var(--cc-navy);
    display: grid;
    place-items: center;
    font-size: 0.625rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .cc__name {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }

  .cc__tag {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.6875rem;
  }

  .cc__meta {
    display: none;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .cc__meta strong {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .cc__dot {
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .cc__count-box {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cc__count {
    font-family: var(--cc-mono);
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: color 0.4s ease;
  }

  .cc__count-label {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.8125rem;
  }

  .cc__main {
    display: grid;
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
    gap: 0.85rem;
    padding: 0.85rem;
    flex: 1;
