---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="zoom-drain-demo"
  aspect="16 / 10"
  system="Agents + systems → booked job"
  cta="Watch agents hand a job from email to the board."
  caption="See agents coordinate across Gmail, ServiceTitan, Quo, and the board"
>
  <div class="zd" data-zd>
    <nav class="zd__agents" aria-label="Agent strip">
      <div class="zd__agent" data-zd-agent="gary">
        <span class="zd__agent-pulse" aria-hidden="true"></span>
        <span class="zd__agent-name">Gary</span>
        <span class="zd__agent-sys">Gmail</span>
      </div>
      <div class="zd__agent" data-zd-agent="steve">
        <span class="zd__agent-pulse" aria-hidden="true"></span>
        <span class="zd__agent-name">Steve</span>
        <span class="zd__agent-sys">ServiceTitan</span>
      </div>
      <div class="zd__agent" data-zd-agent="quinn">
        <span class="zd__agent-pulse" aria-hidden="true"></span>
        <span class="zd__agent-name">Quinn</span>
        <span class="zd__agent-sys">Quo</span>
      </div>
      <div class="zd__agent" data-zd-agent="lisa">
        <span class="zd__agent-pulse" aria-hidden="true"></span>
        <span class="zd__agent-name">Lisa</span>
        <span class="zd__agent-sys">Board</span>
      </div>
    </nav>

    <main class="zd__stage" data-zd-stage>
      <!-- Beat 1: inbound email -->
      <section class="zd__scene is-active" data-zd-scene="email" aria-label="Inbound email">
        <div class="zd__scene-label">INBOUND · GMAIL</div>
        <article class="zd__email">
          <header class="zd__email-head">
            <div class="zd__email-from">
              <span class="zd__avatar">PM</span>
              <div>
                <strong>Property Mgmt Co.</strong>
                <span>to dispatch@zoomdrain.com</span>
              </div>
            </div>
            <time>9:14 AM</time>
          </header>
          <h3 class="zd__email-subj">Slow drain — kitchen · 14th Ave</h3>
          <div class="zd__email-body">
            <p>Hi team,</p>
            <p>
              Tenant at <strong>14th Ave</strong> reports a <strong>slow drain in the kitchen</strong>.
              Water pools when running the sink. Please schedule service.
            </p>
            <p>Thanks,<br />A. Reyes</p>
          </div>
          <div class="zd__email-badge">Unread · no agent assigned</div>
        </article>
      </section>

      <!-- Beat 2: Gary work packet -->
      <section class="zd__scene" data-zd-scene="packet" hidden aria-label="Work packet">
        <div class="zd__scene-label">WORK PACKET · GARY</div>
        <article class="zd__packet">
          <div class="zd__packet-row">
            <span class="zd__packet-id">WO-1842</span>
            <span class="zd__packet-tag">Extracted</span>
          </div>
          <h3 class="zd__packet-title">Slow drain — kitchen</h3>
          <p class="zd__packet-addr">14th Ave</p>
          <dl class="zd__packet-fields">
            <div><dt>Source</dt><dd>Gmail intake</dd></div>
            <div><dt>Priority</dt><dd class="zd__copper">Standard · SLA 4hr</dd></div>
            <div><dt>Contact</dt><dd>Tenant on-site</dd></div>
            <div><dt>Notes</dt><dd>Water pools at sink; kitchen only</dd></div>
          </dl>
          <div class="zd__packet-status">
            <span class="zd__dot" aria-hidden="true"></span>
            Packet ready — routing to dispatch
          </div>
        </article>
      </section>

      <!-- Beat 3: Steve availability -->
      <section class="zd__scene" data-zd-scene="availability" hidden aria-label="ServiceTitan availability">
        <div class="zd__scene-label">AVAILABILITY · SERVICETITAN</div>
        <article class="zd__st">
          <header class="zd__st-head">
            <span>Dispatch · WO-1842</span>
            <span class="zd__st-sla is-match">SLA match ✓</span>
          </header>
          <div class="zd__st-slots">
            <div class="zd__st-slot is-best">
              <span class="zd__st-slot-time">Today · 2–4 PM</span>
              <span class="zd__st-slot-meta">Soonest · 2.1 mi</span>
              <span class="zd__st-slot-tech">Tech: Martinez</span>
            </div>
            <div class="zd__st-slot">
              <span class="zd__st-slot-time">Today · 4–6 PM</span>
              <span class="zd__st-slot-meta">Backup window</span>
            </div>
            <div class="zd__st-slot">
              <span class="zd__st-slot-time">Tomorrow · 8–10 AM</span>
              <span class="zd__st-slot-meta">Outside SLA</span>
            </div>
          </div>
          <div class="zd__st-footer">
            <span>Response SLA: &lt; 4 hr</span>
            <span class="zd__copper">Best fit: 2–4 PM</span>
          </div>
        </article>
      </section>

      <!-- Beat 4: Quinn texts customer -->
      <section class="zd__scene" data-zd-scene="sms-out" hidden aria-label="Outbound SMS">
        <div class="zd__scene-label">OUTBOUND · QUO</div>
        <article class="zd__sms">
          <header class="zd__sms-head">
            <span class="zd__avatar zd__avatar--quo">Q</span>
            <div>
              <strong>Tenant · 14th Ave</strong>
              <span>+1 (614) 555-0182</span>
            </div>
          </header>
          <div class="zd__sms-thread">
            <div class="zd__bubble zd__bubble--out is-visible">
              <p>
                Hi! This is Zoom Drain. We can address your kitchen drain
                <strong>today between 2–4 PM</strong>. Does that window work for you?
              </p>
              <time>9:18 AM</time>
            </div>
          </div>
          <div class="zd__sms-foot">Awaiting customer reply…</div>
        </article>
      </section>

      <!-- Beat 5: customer reply -->
      <section class="zd__scene" data-zd-scene="sms-reply" hidden aria-label="Customer SMS reply">
        <div class="zd__scene-label">INBOUND · QUO</div>
        <article class="zd__sms">
          <header class="zd__sms-head">
            <span class="zd__avatar zd__avatar--quo">Q</span>
            <div>
              <strong>Tenant · 14th Ave</strong>
              <span>+1 (614) 555-0182</span>
            </div>
          </header>
          <div class="zd__sms-thread">
            <div class="zd__bubble zd__bubble--out">
              <p>
                Hi! This is Zoom Drain. We can address your kitchen drain
                <strong>today between 2–4 PM</strong>. Does that window work for you?
              </p>
              <time>9:18 AM</time>
            </div>
            <div class="zd__bubble zd__bubble--in is-visible">
              <p>Yes, 2–4 works. I'll be home.</p>
              <time>9:19 AM</time>
            </div>
          </div>
        </article>
      </section>

      <!-- Beat 6: Quinn confirms with Steve -->
      <section class="zd__scene" data-zd-scene="confirm" hidden aria-label="Agent coordination">
        <div class="zd__scene-label">COORDINATION</div>
        <article class="zd__coord">
          <div class="zd__coord-line">
            <span class="zd__coord-who">Quinn · Quo</span>
            <p>Customer confirmed <strong>2–4 PM</strong> arrival window.</p>
          </div>
          <div class="zd__coord-arrow" aria-hidden="true">↓</div>
          <div class="zd__coord-line is-steve">
            <span class="zd__coord-who">Steve · ServiceTitan</span>
            <p>Booking job on calendar…</p>
            <div class="zd__coord-progress">
              <span class="zd__coord-bar"></span>
            </div>
          </div>
        </article>
      </section>

      <!-- Beat 7: booked board -->
      <section class="zd__scene" data-zd-scene="booked" hidden aria-label="Booked job board">
        <div class="zd__scene-label">BOARD · CONFIRMED</div>
        <article class="zd__board-card">
          <header class="zd__board-head">
            <span class="zd__board-id">WO-1842</span>
            <span class="zd__board-status">BOOKED</span>
          </header>
          <h3 class="zd__board-title">Slow drain — kitchen</h3>
          <p class="zd__board-addr">14th Ave</p>
          <div class="zd__board-grid">
            <div><span>Window</span><strong>Today 2–4 PM</strong></div>
            <div><span>Tech</span><strong>Martinez</strong></div>
            <div><span>Source</span><strong>Gmail → Quo</strong></div>
            <div><span>SLA</span><strong class="zd__copper">Met</strong></div>
          </div>
          <div class="zd__board-note">Posted to dispatch board · 9:20 AM</div>
        </article>
      </section>

      <!-- Beat 8: Lisa notifies humans -->
      <section class="zd__scene" data-zd-scene="lisa" hidden aria-label="Lisa office update">
        <div class="zd__scene-label">HANDOFF · LISA</div>
        <article class="zd__lisa">
          <div class="zd__lisa-board">
            <span class="zd__lisa-check" aria-hidden="true">✓</span>
            <div>
              <strong>WO-1842 on the board</strong>
              <p>14th Ave · 2–4 PM · Martinez</p>
            </div>
          </div>
          <div class="zd__lisa-divider" aria-hidden="true"></div>
          <div class="zd__lisa-notify">
            <span class="zd__lisa-label">Office manager</span>
            <p>
              Job booked and confirmed. Tenant expects tech
              <strong>today 2–4 PM</strong>. No further action needed unless reschedule.
            </p>
            <div class="zd__lisa-recipients">
              <span class="zd__lisa-pill">D. Walsh · Office Mgr</span>
              <span class="zd__lisa-pill">Dispatch channel</span>
            </div>
          </div>
        </article>
      </section>
    </main>

    <p class="zd__nudge" data-zd-nudge hidden>Replay anytime from the corner control.</p>
  </div>
</DemoFrame>

<script>
  type Scene =
    | "email"
    | "packet"
    | "availability"
    | "sms-out"
    | "sms-reply"
    | "confirm"
    | "booked"
    | "lisa";

  type Agent = "none" | "gary" | "steve" | "quinn" | "lisa";

  const SCENES: Scene[] = [
    "email",
    "packet",
    "availability",
    "sms-out",
    "sms-reply",
    "confirm",
    "booked",
    "lisa",
  ];

  /** Eight transitions (email → lisa); ~1.7s between beats, ~13.5s total walk */
  const BEAT_MS = [900, 2600, 4300, 6000, 7700, 9400, 11100, 12800];

  function sceneForBeat(beat: number): Scene {
    switch (beat) {
      case 0:
        return "email";
      case 1:
        return "packet";
      case 2:
        return "availability";
      case 3:
        return "sms-out";
      case 4:
        return "sms-reply";
      case 5:
        return "confirm";
      case 6:
        return "booked";
      case 7:
        return "lisa";
      default: {
        const _exhaustive: never = beat;
        return _exhaustive;
      }
    }
  }

  function agentsForBeat(beat: number): Agent | Agent[] {
    switch (beat) {
      case 0:
        return "none";
      case 1:
        return "gary";
      case 2:
        return "steve";
      case 3:
        return "quinn";
      case 4:
        return "quinn";
      case 5:
        return ["quinn", "steve"];
      case 6:
        return "steve";
      case 7:
        return "lisa";
      default: {
        const _exhaustive: never = beat;
        return _exhaustive;
      }
    }
  }

  function wireZoomDrain(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-zd-wired")) return;
    frame.setAttribute("data-zd-wired", "true");

    const scenes = new Map<Scene, HTMLElement>();
    SCENES.forEach((id) => {
      const el = root.querySelector<HTMLElement>(`[data-zd-scene="${id}"]`);
      if (el) scenes.set(id, el);
    });

    const agents = {
      gary: root.querySelector<HTMLElement>("[data-zd-agent='gary']"),
      steve: root.querySelector<HTMLElement>("[data-zd-agent='steve']"),
      quinn: root.querySelector<HTMLElement>("[data-zd-agent='quinn']"),
      lisa: root.querySelector<HTMLElement>("[data-zd-agent='lisa']"),
    };

    const nudge = root.querySelector<HTMLElement>("[data-zd-nudge]");

    let running = false;
    let done = false;
    let beat = 0;
    let tryMode = false;
    const timers: ReturnType<typeof setTimeout>[] = [];

    const clearTimers = () => {
      timers.forEach(clearTimeout);
      timers.length = 0;
    };

    const setAgentActive = (active: Agent | Agent[]) => {
      const activeSet = new Set(
        Array.isArray(active) ? active : active === "none" ? [] : [active],
      );
      (Object.entries(agents) as [Exclude<Agent, "none">, HTMLElement | null][]).forEach(
        ([name, el]) => {
          el?.classList.toggle("is-active", activeSet.has(name));
        },
      );
    };

    const showScene = (scene: Scene) => {
      scenes.forEach((el, id) => {
        const on = id === scene;
        el.hidden = !on;
        el.classList.toggle("is-active", on);
      });
    };

    const paint = (b: number, isDone: boolean, isRunning: boolean) => {
      beat = b;
      done = isDone;
      running = isRunning;

      const scene = b < SCENES.length ? sceneForBeat(b) : "lisa";
      const activeAgents = b < SCENES.length ? agentsForBeat(b) : "lisa";

      showScene(scene);
      setAgentActive(activeAgents);

      if (nudge) {
        nudge.hidden = !tryMode || !isDone || isRunning;
      }
    };

    const reset = () => {
      clearTimers();
      tryMode = false;
      paint(0, false, false);
    };

    const paintFinal = () => {
      clearTimers();
      tryMode = true;
      paint(SCENES.length - 1, true, false);
    };

    const start = () => {
      if (running) return;
      clearTimers();
      tryMode = false;
      paint(0, false, true);

      BEAT_MS.forEach((ms, idx) => {
        const nextBeat = idx + 1;
        const isLast = idx === BEAT_MS.length - 1;
        timers.push(
          setTimeout(() => {
            paint(
              isLast ? SCENES.length - 1 : nextBeat,
              isLast,
              !isLast,
            );
            if (isLast) {
              tryMode = true;
              frame.dispatchEvent(
                new CustomEvent("demo-request-complete", { bubbles: true }),
              );
            }
          }, ms),
        );
      });
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        paintFinal();
        frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
        return;
      }
      start();
    });

    frame.addEventListener("demo-replay", () => {
      reset();
      start();
    });

    frame.addEventListener("demo-complete", () => {
      tryMode = true;
      if (done && nudge) nudge.hidden = false;
    });
  }

  document.querySelectorAll("[data-zd]").forEach((el) => wireZoomDrain(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-zd]").forEach((el) => wireZoomDrain(el as HTMLElement));
  });
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap");

  @keyframes zd-agent-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  @keyframes zd-scene-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zd-progress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }
</style>

<style>
  .zd {
    --zd-bg: #12131a;
    --zd-panel: #1a1b22;
    --zd-border: #23242b;
    --zd-copper: #b87333;
    --zd-copper-glow: rgba(184, 115, 51, 0.38);
    --zd-copper-dim: rgba(184, 115, 51, 0.12);
    --zd-spark: #d9963c;
    --zd-text: #ddd9d3;
    --zd-muted: #6e6c68;
    --zd-dim: #3a3936;
    --zd-sans: "Barlow Condensed", sans-serif;
    --zd-mono: "Space Mono", monospace;

    height: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--zd-text);
    font-family: var(--zd-mono);
    font-size: 0.72rem;
    background-color: var(--zd-bg);
    background-image: radial-gradient(var(--zd-border) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .zd__agents {
    flex-shrink: 0;
    display: flex;
    gap: 0.45rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--zd-border);
    background: rgba(18, 19, 26, 0.94);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .zd__agents::-webkit-scrollbar {
    display: none;
  }

  .zd__agent {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--zd-border);
    border-radius: 999px;
    background: var(--zd-panel);
    flex-shrink: 0;
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
  }

  .zd__agent-pulse {
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 1px solid rgba(184, 115, 51, 0.3);
    pointer-events: none;
    opacity: 0;
  }

  .zd__agent.is-active {
    border-color: var(--zd-copper);
    background: var(--zd-copper-dim);
    box-shadow: 0 0 14px var(--zd-copper-glow);
  }

  .zd__agent.is-active .zd__agent-pulse {
    opacity: 1;
    animation: zd-agent-pulse 1.6s ease-out infinite;
  }

  .zd__agent-name {
    font-family: var(--zd-sans);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .zd__agent-sys {
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--zd-muted);
    text-transform: uppercase;
    border-left: 1px solid var(--zd-border);
    padding-left: 0.45rem;
  }

  .zd__agent.is-active .zd__agent-sys {
    color: var(--zd-copper);
  }

  .zd__stage {
    flex: 1;
    min-height: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.25rem;
    overflow: hidden;
  }

  .zd__scene {
    width: 100%;
    max-width: 28rem;
    animation: zd-scene-in 0.35s ease both;
  }

  .zd__scene-label {
    font-size: 0.52rem;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: var(--zd-copper);
    margin-bottom: 0.55rem;
  }

  .zd__copper {
    color: var(--zd-copper);
  }

  /* Email */
  .zd__email {
    background: var(--zd-panel);
    border: 1px solid var(--zd-border);
    border-left: 3px solid var(--zd-copper);
    border-radius: 3px;
    padding: 0.85rem 1rem;
  }

  .zd__email-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
    font-size: 0.62rem;
    color: var(--zd-muted);
  }

  .zd__email-from {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .zd__email-from strong {
    display: block;
    color: var(--zd-text);
    font-size: 0.72rem;
  }

  .zd__email-subj {
    font-family: var(--zd-sans);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
    line-height: 1.25;
  }

  .zd__email-body {
    font-size: 0.68rem;
    line-height: 1.55;
    color: var(--zd-muted);
    margin-bottom: 0.75rem;
  }

  .zd__email-body strong {
    color: var(--zd-text);
  }

  .zd__email-badge {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--zd-muted);
    padding: 0.3rem 0.5rem;
    background: #161719;
    border: 1px solid var(--zd-border);
    border-radius: 2px;
  }

  /* Work packet */
  .zd__packet {
    background: var(--zd-panel);
    border: 1px solid var(--zd-border);
    border-radius: 3px;
    padding: 0.9rem 1rem;
  }

  .zd__packet-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
  }

  .zd__packet-id {
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--zd-copper);
    font-weight: 700;
  }

  .zd__packet-tag {
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--zd-muted);
    background: #161719;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--zd-border);
  }

  .zd__packet-title {
    font-family: var(--zd-sans);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.15rem;
  }

  .zd__packet-addr {
    font-size: 0.68rem;
    color: var(--zd-muted);
    margin: 0 0 0.75rem;
  }

  .zd__packet-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 0.75rem;
    margin: 0 0 0.75rem;
  }

  .zd__packet-fields dt {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--zd-dim);
    text-transform: uppercase;
    margin-bottom: 0.1rem;
  }

  .zd__packet-fields dd {
    margin: 0;
    font-size: 0.68rem;
  }

  .zd__packet-status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    color: var(--zd-copper);
    letter-spacing: 0.04em;
  }

  .zd__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--zd-copper);
    box-shadow: 0 0 6px var(--zd-copper);
  }

  /* ServiceTitan */
  .zd__st {
    background: var(--zd-panel);
    border: 1px solid var(--zd-border);
    border-radius: 3px;
    padding: 0.85rem 1rem;
  }

  .zd__st-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.62rem;
    color: var(--zd-muted);
  }

  .zd__st-sla {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.45rem;
    border-radius: 2px;
    border: 1px solid var(--zd-border);
  }

  .zd__st-sla.is-match {
    color: var(--zd-copper);
    border-color: rgba(184, 115, 51, 0.45);
