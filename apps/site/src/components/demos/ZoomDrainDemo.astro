---
import DemoFrame from "./DemoFrame.astro";
---

<DemoFrame
  class="zoom-drain-demo"
  aspect="16 / 10"
  system="Vendor intake → automation → dispatch"
  cta="Watch a work order move from portal to a tech on a truck."
  caption="See the operating system in action"
>
  <div class="zd" data-zd>
    <header class="zd__header">
      <div class="zd__brand">
        <span class="zd__live-dot" data-zd-live-dot aria-hidden="true"></span>
        <span class="zd__title">DISPATCH OS</span>
        <span class="zd__sub">FIELD SERVICE · DRAIN CO.</span>
      </div>
      <span class="zd__ver">DEMO · v0.1</span>
    </header>

    <div class="zd__body">
      <aside class="zd__col zd__col--intake">
        <div class="zd__col-label zd__col-label--copper">INTAKE</div>

        <div class="zd__card">
          <div class="zd__card-top">
            <span class="zd__wo">WO-1842</span>
            <span class="zd__wo-dot" data-zd-wo-dot aria-hidden="true"></span>
          </div>
          <div class="zd__job">Slow drain - kitchen</div>
          <div class="zd__addr">14th Ave.</div>
          <span class="zd__tag">VENDOR PORTAL</span>
        </div>

        <div class="zd__status" data-zd-status>
          <span class="zd__status-dot" aria-hidden="true">●</span>
          <span data-zd-status-text>Active dispatch</span>
        </div>

        <div class="zd__spacer"></div>

        <button type="button" class="zd__action" data-zd-action hidden>
          ↩  REPLAY
        </button>
      </aside>

      <section class="zd__col zd__col--pipeline">
        <div class="zd__col-label zd__col-label--muted">DISPATCH PIPELINE</div>

        <div class="zd__pipeline" data-zd-pipeline>
          <div class="zd__node" data-zd-node="0">
            <div class="zd__node-circle">
              <span class="zd__pulse" data-zd-pulse aria-hidden="true"></span>
              <span>1</span>
            </div>
            <div class="zd__node-label">Vendor Portal</div>
            <div class="zd__node-cap" data-zd-cap>Intake received</div>
          </div>

          <div class="zd__seg" data-zd-seg="0">
            <div class="zd__seg-track"></div>
            <div class="zd__seg-fill" data-zd-fill></div>
          </div>

          <div class="zd__node" data-zd-node="1">
            <div class="zd__node-circle">
              <span class="zd__pulse" data-zd-pulse aria-hidden="true"></span>
              <span>2</span>
            </div>
            <div class="zd__node-label">CSM</div>
            <div class="zd__node-cap" data-zd-cap>Tenant confirmed</div>
          </div>

          <div class="zd__seg" data-zd-seg="1">
            <div class="zd__seg-track"></div>
            <div class="zd__seg-fill" data-zd-fill></div>
          </div>

          <div class="zd__node" data-zd-node="2">
            <div class="zd__node-circle">
              <span class="zd__pulse" data-zd-pulse aria-hidden="true"></span>
              <span>3</span>
            </div>
            <div class="zd__node-label">VOIP Text</div>
            <div class="zd__node-cap" data-zd-cap>Tech assigned</div>
          </div>

          <div class="zd__seg" data-zd-seg="2">
            <div class="zd__seg-track"></div>
            <div class="zd__seg-fill" data-zd-fill></div>
          </div>

          <div class="zd__node" data-zd-node="3">
            <div class="zd__node-circle">
              <span class="zd__pulse" data-zd-pulse aria-hidden="true"></span>
              <span>4</span>
            </div>
            <div class="zd__node-label">Tech on Truck</div>
            <div class="zd__node-cap" data-zd-cap>En route</div>
          </div>
        </div>
      </section>

      <aside class="zd__col zd__col--outcome">
        <div class="zd__col-label" data-zd-outcome-label>OUTCOME</div>

        <div class="zd__stat" data-zd-stat="0">
          <div class="zd__stat-label">BOOKING TIME</div>
          <div class="zd__stat-vals">
            <div class="zd__stat-before" data-zd-before>3h</div>
            <div class="zd__stat-after" data-zd-after>12 min</div>
          </div>
        </div>

        <div class="zd__stat" data-zd-stat="1">
          <div class="zd__stat-label">SPEED TO LEAD</div>
          <div class="zd__stat-vals">
            <div class="zd__stat-before" data-zd-before>-</div>
            <div class="zd__stat-after" data-zd-after>+300%</div>
          </div>
        </div>

        <div class="zd__stat" data-zd-stat="2">
          <div class="zd__stat-label">WEEKLY REVENUE</div>
          <div class="zd__stat-vals">
            <div class="zd__stat-before" data-zd-before>baseline</div>
            <div class="zd__stat-after" data-zd-after>+12%</div>
          </div>
        </div>

        <div class="zd__done-mark" data-zd-done-mark>✓ DISPATCH COMPLETE</div>
      </aside>
    </div>
  </div>
</DemoFrame>

<script>
  // Steps 1-8 advance the animation:
  //   node i lights at step 2i+1   (steps 1, 3, 5, 7)
  //   seg  i burns  at step 2i+2   (steps 2, 4, 6)
  //   seg  i done   at step 2i+3+
  const STEP_MS = [50, 1280, 2880, 3980, 5580, 6680, 8280, 9680];

  function nodeIsLit(s: number, i: number) {
    return s >= 2 * i + 1;
  }
  function segIsLit(s: number, i: number) {
    return s >= 2 * i + 3;
  }
  function segIsBurning(s: number, i: number) {
    return s === 2 * i + 2;
  }
  function activeCap(s: number) {
    return s > 0 ? Math.min(3, Math.floor((s - 1) / 2)) : -1;
  }

  function wireZoomDrain(root: HTMLElement) {
    const frame = root.closest<HTMLElement>("[data-demo-frame]");
    if (!frame || frame.hasAttribute("data-zd-wired")) return;
    frame.setAttribute("data-zd-wired", "true");

    const liveDot = root.querySelector<HTMLElement>("[data-zd-live-dot]");
    const woDot = root.querySelector<HTMLElement>("[data-zd-wo-dot]");
    const statusEl = root.querySelector<HTMLElement>("[data-zd-status]");
    const statusText = root.querySelector<HTMLElement>("[data-zd-status-text]");
    const actionBtn = root.querySelector<HTMLButtonElement>("[data-zd-action]");
    const outcomeLabel = root.querySelector<HTMLElement>("[data-zd-outcome-label]");
    const doneMark = root.querySelector<HTMLElement>("[data-zd-done-mark]");
    const nodes = Array.from(root.querySelectorAll<HTMLElement>("[data-zd-node]"));
    const segs = Array.from(root.querySelectorAll<HTMLElement>("[data-zd-seg]"));
    const stats = Array.from(root.querySelectorAll<HTMLElement>("[data-zd-stat]"));

    let running = false;
    let done = false;
    let step = 0;
    const timers: ReturnType<typeof setTimeout>[] = [];

    const clearTimers = () => {
      timers.forEach(clearTimeout);
      timers.length = 0;
    };

    const remountFills = () => {
      segs.forEach((seg) => {
        const old = seg.querySelector<HTMLElement>("[data-zd-fill]");
        if (!old) return;
        const next = old.cloneNode(false) as HTMLElement;
        next.className = "zd__seg-fill";
        next.setAttribute("data-zd-fill", "");
        old.replaceWith(next);
      });
    };

    const paint = (s: number, isDone: boolean, isRunning: boolean) => {
      step = s;
      done = isDone;
      running = isRunning;

      const cap = activeCap(s);

      liveDot?.classList.toggle("is-running", isRunning);
      liveDot?.classList.toggle("is-done", isDone && !isRunning);

      woDot?.classList.toggle("is-running", isRunning);
      woDot?.classList.toggle("is-done", isDone && !isRunning);

      statusEl?.classList.toggle("is-visible", isRunning || isDone);
      if (statusText) {
        statusText.textContent = isDone ? "Dispatch complete" : "Active dispatch";
      }

      outcomeLabel?.classList.toggle("is-done", isDone);
      doneMark?.classList.toggle("is-visible", isDone);

      nodes.forEach((node, i) => {
        const lit = nodeIsLit(s, i);
        const isActive = cap === i;
        node.classList.toggle("is-lit", lit);
        node.classList.toggle("is-active", lit && isActive);
      });

      segs.forEach((seg, i) => {
        const fill = seg.querySelector<HTMLElement>("[data-zd-fill]");
        if (!fill) return;
        const on = segIsLit(s, i) || segIsBurning(s, i);
        fill.classList.toggle("is-on", on);
      });

      stats.forEach((stat) => {
        stat.classList.toggle("is-done", isDone);
      });

      if (actionBtn) {
        if (isDone && !isRunning) {
          actionBtn.hidden = false;
          actionBtn.disabled = false;
          actionBtn.textContent = "↩  REPLAY";
          actionBtn.classList.add("is-replay");
          actionBtn.classList.remove("is-running");
        } else if (isRunning) {
          actionBtn.hidden = true;
        } else {
          actionBtn.hidden = true;
        }
      }
    };

    const reset = () => {
      clearTimers();
      remountFills();
      // Force reflow so fill width transitions restart cleanly
      void root.offsetWidth;
      paint(0, false, false);
    };

    const paintFinal = () => {
      clearTimers();
      remountFills();
      void root.offsetWidth;
      paint(STEP_MS.length, true, false);
      // Snap fills without waiting for transition
      segs.forEach((seg) => {
        const fill = seg.querySelector<HTMLElement>("[data-zd-fill]");
        if (!fill) return;
        fill.style.transition = "none";
        fill.classList.add("is-on");
      });
    };

    const start = () => {
      if (running) return;
      clearTimers();
      remountFills();
      void root.offsetWidth;
      paint(0, false, true);

      STEP_MS.forEach((ms, idx) => {
        const s = idx + 1;
        timers.push(
          setTimeout(() => {
            const finished = s === STEP_MS.length;
            paint(s, finished, !finished);
            if (finished) {
              frame.dispatchEvent(
                new CustomEvent("demo-request-complete", { bubbles: true }),
              );
            }
          }, ms),
        );
      });
    };

    frame.addEventListener("demo-play", (e) => {
      const detail = (e as CustomEvent).detail as { reduced?: boolean } | undefined;
      if (detail?.reduced) {
        paintFinal();
        frame.dispatchEvent(new CustomEvent("demo-request-complete", { bubbles: true }));
        return;
      }
      start();
    });

    frame.addEventListener("demo-replay", () => {
      reset();
      start();
    });

    actionBtn?.addEventListener("click", () => {
      if (running) return;
      frame.dispatchEvent(new CustomEvent("demo-request-replay", { bubbles: true }));
    });
  }

  document.querySelectorAll("[data-zd]").forEach((el) => wireZoomDrain(el as HTMLElement));
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-zd]").forEach((el) => wireZoomDrain(el as HTMLElement));
  });
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap");

  @keyframes zd-pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes zd-caption-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<style>
  .zd {
    --zd-bg: #12131a;
    --zd-panel: #1a1b22;
    --zd-border: #23242b;
    --zd-copper: #b87333;
    --zd-copper-glow: rgba(184, 115, 51, 0.38);
    --zd-copper-dim: rgba(184, 115, 51, 0.1);
    --zd-spark: #d9963c;
    --zd-text: #ddd9d3;
    --zd-muted: #555250;
    --zd-dim: #2b2a28;
    --zd-sans: "Barlow Condensed", sans-serif;
    --zd-mono: "Space Mono", monospace;

    height: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--zd-text);
    font-family: var(--zd-mono);
    background-color: var(--zd-bg);
    background-image: radial-gradient(var(--zd-border) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .zd__header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--zd-border);
    background: rgba(18, 19, 26, 0.92);
  }

  .zd__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .zd__live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--zd-copper);
    box-shadow: 0 0 6px var(--zd-copper);
    transition: box-shadow 0.5s ease;
  }

  .zd__live-dot.is-running {
    box-shadow: 0 0 14px var(--zd-copper);
  }

  .zd__live-dot.is-done {
    box-shadow: 0 0 12px var(--zd-copper);
  }

  .zd__title {
    font-family: var(--zd-sans);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .zd__sub {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--zd-muted);
    border-left: 1px solid var(--zd-border);
    padding-left: 0.85rem;
    white-space: nowrap;
  }

  .zd__ver {
    font-size: 0.56rem;
    color: var(--zd-dim);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .zd__body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(11rem, 17.5rem) 1fr minmax(11rem, 17.5rem);
  }

  .zd__col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem 1.1rem;
    min-width: 0;
  }

  .zd__col--intake {
    border-right: 1px solid var(--zd-border);
  }

  .zd__col--outcome {
    border-left: 1px solid var(--zd-border);
  }

  .zd__col--pipeline {
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.75rem;
  }

  .zd__col-label {
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--zd-dim);
    transition: color 0.5s ease;
  }

  .zd__col-label--copper {
    color: var(--zd-copper);
  }

  .zd__col-label--muted {
    color: var(--zd-muted);
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .zd__col-label.is-done {
    color: var(--zd-copper);
  }

  .zd__card {
    background: var(--zd-panel);
    border: 1px solid var(--zd-border);
    border-left: 3px solid var(--zd-copper);
    padding: 0.9rem 1rem;
    border-radius: 3px;
  }

  .zd__card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.55rem;
  }

  .zd__wo {
    font-size: 0.56rem;
    color: var(--zd-copper);
    letter-spacing: 0.18em;
    font-weight: 700;
  }

  .zd__wo-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--zd-dim);
    transition: all 0.4s ease;
  }

  .zd__wo-dot.is-running {
    background: var(--zd-spark);
    box-shadow: 0 0 6px var(--zd-copper);
  }

  .zd__wo-dot.is-done {
    background: var(--zd-copper);
    box-shadow: 0 0 6px var(--zd-copper);
  }

  .zd__job {
    font-family: var(--zd-sans);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
    color: var(--zd-text);
  }

  .zd__addr {
    font-size: 0.7rem;
    color: var(--zd-muted);
    margin-bottom: 0.75rem;
  }

  .zd__tag {
    display: inline-block;
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    color: var(--zd-muted);
    background: #161719;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--zd-border);
  }

  .zd__status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    color: var(--zd-copper);
    letter-spacing: 0.06em;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .zd__status.is-visible {
    opacity: 0.7;
  }

  .zd__status-dot {
    font-size: 0.5rem;
  }

  .zd__spacer {
    flex: 1;
  }

  .zd__action {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-family: var(--zd-mono);
    cursor: pointer;
    transition: all 0.35s ease;
    background: transparent;
    color: var(--zd-muted);
    border: 1px solid var(--zd-border);
  }

  .zd__action:hover:not(:disabled) {
    color: var(--zd-copper);
    border-color: var(--zd-copper);
  }

  .zd__pipeline {
    display: flex;
    align-items: flex-start;
    width: 100%;
  }

  .zd__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.5rem;
    flex: 0 0 auto;
  }

  .zd__node-circle {
    position: relative;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 2px solid var(--zd-border);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--zd-dim);
    transition: all 0.5s ease;
  }

  .zd__node.is-lit .zd__node-circle {
    border-color: var(--zd-copper);
    background: var(--zd-copper-dim);
    color: var(--zd-copper);
    box-shadow:
      0 0 18px var(--zd-copper-glow),
      0 0 40px rgba(184, 115, 51, 0.12);
  }

  .zd__pulse {
    display: none;
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(184, 115, 51, 0.28);
    pointer-events: none;
  }

  .zd__node.is-active .zd__pulse {
    display: block;
    animation: zd-pulse-ring 1.8s ease-out infinite;
  }

  .zd__node-label {
    margin-top: 0.7rem;
    font-family: var(--zd-sans);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--zd-muted);
    text-align: center;
    line-height: 1.3;
    transition: color 0.5s ease;
  }

  .zd__node.is-lit .zd__node-label {
    color: var(--zd-text);
  }

  .zd__node-cap {
    margin-top: 0.35rem;
    height: 0.9rem;
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    color: transparent;
    text-align: center;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .zd__node.is-active .zd__node-cap {
    color: var(--zd-copper);
    animation: zd-caption-in 0.3s ease both;
  }

  .zd__seg {
    flex: 1;
    margin-top: 1.55rem;
    height: 2px;
    position: relative;
    min-width: 1.25rem;
  }

  .zd__seg-track {
    position: absolute;
    inset: 0;
    background: var(--zd-border);
  }

  .zd__seg-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background: linear-gradient(90deg, var(--zd-copper) 0%, var(--zd-spark) 100%);
    transition: width 800ms linear;
  }

  .zd__seg-fill.is-on {
    width: 100%;
    box-shadow:
      0 0 8px var(--zd-copper),
      0 0 18px rgba(184, 115, 51, 0.22);
  }

  .zd__stat {
    background: var(--zd-panel);
    border: 1px solid var(--zd-border);
    border-top-width: 2px;
    border-top-color: var(--zd-border);
    padding: 0.8rem 0.9rem;
    border-radius: 3px;
    transition: border-top-color 0.5s ease;
  }

  .zd__stat[data-zd-stat="0"].is-done {
    transition-delay: 0ms;
    border-top-color: var(--zd-copper);
  }

  .zd__stat[data-zd-stat="1"].is-done {
    transition-delay: 160ms;
    border-top-color: var(--zd-copper);
  }

  .zd__stat[data-zd-stat="2"].is-done {
    transition-delay: 320ms;
    border-top-color: var(--zd-copper);
  }

  .zd__stat-label {
    font-family: var(--zd-sans);
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    color: var(--zd-muted);
    font-weight: 600;
    margin-bottom: 0.55rem;
  }

  .zd__stat-vals {
    position: relative;
    height: 2.5rem;
  }

  .zd__stat-before {
    position: absolute;
    top: 0.35rem;
    left: 0;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: var(--zd-mono);
    color: var(--zd-dim);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    user-select: none;
  }

  .zd__stat-after {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 1.7rem;
    font-weight: 700;
    font-family: var(--zd-sans);
    color: var(--zd-copper);
    letter-spacing: -0.01em;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
    white-space: nowrap;
  }

  .zd__stat[data-zd-stat="0"] .zd__stat-before,
  .zd__stat[data-zd-stat="0"] .zd__stat-after {
    transition-delay: 0ms;
  }

  .zd__stat[data-zd-stat="1"] .zd__stat-before,
  .zd__stat[data-zd-stat="1"] .zd__stat-after {
    transition-delay: 160ms;
  }

  .zd__stat[data-zd-stat="2"] .zd__stat-before,
  .zd__stat[data-zd-stat="2"] .zd__stat-after {
    transition-delay: 320ms;
  }

  .zd__stat.is-done .zd__stat-before {
    opacity: 0;
    transform: translateY(-7px);
  }

  .zd__stat.is-done .zd__stat-after {
    opacity: 1;
    transform: translateY(0);
