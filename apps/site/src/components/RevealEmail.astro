---
/**
 * Mailbox link. Initial HTML shows "Show email" with no address and no
 * mailto. Click assembles the mailbox in the browser.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  class:list={["reveal-email", className]}
  href="#show-email"
  data-email-reveal
>
  Show email
</a>

<script>
  import "./reveal-email";
</script>

<style>
  .reveal-email {
    color: inherit;
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
  }
</style>
