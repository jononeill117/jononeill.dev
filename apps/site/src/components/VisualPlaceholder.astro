---
/**
 * Labeled empty frame for case study visuals. No fake product screenshots.
 */
interface Props {
  caption: string;
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<figure class:list={["visual-placeholder", className]}>
  <div class="visual-placeholder__frame" aria-hidden="true"></div>
  <figcaption class="visual-placeholder__caption">{caption}</figcaption>
</figure>

<style>
  .visual-placeholder {
    margin: var(--s-12) 0 0;
    max-width: var(--max-w);
  }

  .visual-placeholder__frame {
    aspect-ratio: 16 / 10;
    border: var(--hairline) solid var(--hairline-color);
    background-color: var(--ghost-color);
  }

  .visual-placeholder__caption {
    margin-block-start: var(--s-4);
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--fg-muted);
  }
</style>
