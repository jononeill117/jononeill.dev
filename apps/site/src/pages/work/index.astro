---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";

const studies = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Work. Jon O'Neill, product manager."
  description="Case studies from Livable, Stoa, HomeLight, Zillow, and Zoom Drain Phoenix."
  canonicalPath="/work/"
>
  <Band surface="canvas" as="header" class="page-hero">
    <div class="page-inner">
      <Eyebrow>Work</Eyebrow>
      <h1 class="page-title">Five seats, same job.</h1>
    </div>
  </Band>

  <Band surface="canvas" as="section" class="page-section">
    <div class="page-inner">
      <ul class="work-list" role="list">
        {
          studies.map((study) => (
            <li class="work-item">
              <Eyebrow>
                {study.data.role} · {study.data.dates}
              </Eyebrow>
              <h2 class="work-item__title">
                <a href={`/work/${study.id}/`}>{study.data.title}</a>
              </h2>
              <p class="work-item__lede">{study.data.lede}</p>
              <p class="page-meta">{study.data.outcome}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Band>
</BaseLayout>

<style>
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-12);
  }

  .work-item__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .work-item__title a {
    text-decoration: none;
  }

  .work-item__title a:hover,
  .work-item__title a:focus-visible {
    color: var(--accent);
  }

  .work-item__lede {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-secondary);
  }
</style>
