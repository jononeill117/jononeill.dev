---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import VisualPlaceholder from "../../components/VisualPlaceholder.astro";

export async function getStaticPaths() {
  const studies = await getCollection("work");
  return studies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title}. ${entry.data.role}.`;
const visualCaption =
  entry.data.visualCaption ?? "Product screenshot, placeholder";
---

<BaseLayout
  title={title}
  description={entry.data.lede}
  canonicalPath={`/work/${entry.id}/`}
>
  <Band surface="canvas" as="header" class="page-hero">
    <div class="page-inner">
      <Eyebrow>{entry.data.role}</Eyebrow>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="page-lede">{entry.data.lede}</p>
    </div>
  </Band>

  <Band surface="canvas" as="article" class="page-section">
    <div class="page-inner prose">
      <Content />
      <VisualPlaceholder caption={visualCaption} />
      <p class="page-meta">
        <a href="/work/">Back to work</a>
      </p>
    </div>
  </Band>
</BaseLayout>

<style>
  .prose :global(p) {
    max-width: var(--measure);
    color: var(--fg-secondary);
  }

  .prose :global(p + p) {
    margin-block-start: var(--s-6);
  }
</style>
