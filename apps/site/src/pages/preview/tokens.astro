---
/**
 * THROW AWAY. Marked for deletion.
 *
 * Temporary recruiter / design-system preview of the locked palette.
 * Delete this route once real pages land and the palette is visible in situ.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
---

<BaseLayout
  title="Token preview (delete me)"
  description="Throwaway palette preview for jononeill.dev. Marked for deletion."
  noindex={true}
  chrome={true}
>
  <Band surface="canvas" as="header" class="preview">
    <div class="preview__inner">
      <Eyebrow>Throwaway route</Eyebrow>
      <h1 class="preview__title">Token preview</h1>
      <p class="preview__note">
        Marked for deletion. Design locked: near-black canvas, warm off-white
        ink, copper accent. No indigo.
      </p>

      <ul class="swatches" role="list">
        <li class="swatch">
          <span class="swatch__chip swatch__chip--canvas"></span>
          <span class="swatch__meta">
            <strong>canvas</strong>
            <code>#0B0A09</code>
          </span>
        </li>
        <li class="swatch">
          <span class="swatch__chip swatch__chip--ink"></span>
          <span class="swatch__meta">
            <strong>ink</strong>
            <code>#F2EBE1</code>
          </span>
        </li>
        <li class="swatch">
          <span class="swatch__chip swatch__chip--copper"></span>
          <span class="swatch__meta">
            <strong>copper</strong>
            <code>#B87333</code>
          </span>
        </li>
      </ul>

      <div class="surfaces">
        <Band surface="canvas" class="surface-card" as="div">
          <p>canvas surface</p>
          <p class="muted">secondary on canvas</p>
        </Band>
        <Band surface="inverted" class="surface-card" as="div">
          <p>inverted surface</p>
          <p class="muted-inv">secondary on inverted</p>
        </Band>
        <Band surface="accent" class="surface-card" as="div">
          <p>accent surface</p>
          <p class="muted-acc">secondary on accent</p>
        </Band>
      </div>

      <p class="preview__back">
        <a href="/">Back to home</a>
      </p>
    </div>
  </Band>
</BaseLayout>

<style>
  .preview {
    padding-block: var(--s-section);
  }

  .preview__inner {
    width: min(100%, var(--max-w));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .preview__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h1-tight);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }

  .preview__note {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-secondary);
  }

  .swatches {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .swatch {
    display: grid;
    gap: var(--s-3);
  }

  .swatch__chip {
    display: block;
    aspect-ratio: 16 / 10;
    border: var(--hairline) solid var(--hairline-color);
  }

  .swatch__chip--canvas {
    background: #0b0a09;
  }

  .swatch__chip--ink {
    background: #f2ebe1;
  }

  .swatch__chip--copper {
    background: #b87333;
  }

  .swatch__meta {
    display: grid;
    gap: var(--s-1);
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .swatch__meta code {
    color: var(--fg-muted);
    font-family: inherit;
  }

  .surfaces {
    margin-block-start: var(--s-12);
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .surface-card {
    padding: var(--s-6);
    border: var(--hairline) solid var(--hairline-color);
  }

  .muted {
    color: var(--fg-secondary);
  }

  .muted-inv {
    color: var(--fg-secondary-on-inverted);
  }

  .muted-acc {
    color: var(--fg-muted-on-accent);
  }

  .preview__back {
    margin-block-start: var(--s-12);
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }
</style>
