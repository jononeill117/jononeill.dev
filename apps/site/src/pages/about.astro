---
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import { SITE } from "../components/site";
---

<BaseLayout
  title="About. Jon ONeill."
  description="Phoenix, AZ. Product, operations, and analytics."
  canonicalPath="/about/"
  navSurface="inverted"
>
  <Band surface="inverted" as="header" class="page-hero">
    <div class="page-inner">
      <Eyebrow>About</Eyebrow>
      <h1 class="page-title">Phoenix, AZ</h1>
      <p class="page-lede">
        Product, operations, and analytics. Mid-level. I currently run
        operations at Zoom Drain Phoenix. Before that I was Head of Product at
        Livable.
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" class="page-section">
    <div class="page-inner">
      <div class="page-body">
        <p>
          Enterprise product work starts at Zillow, September 2019 to March
          2021. Associate on underwriting models and AI models. Then HomeLight,
          Stoa, and Livable.
        </p>
        <p>
          Ecclesio is a side project. Church software. It is not a job.
        </p>
        <p>
          This site is the hire packet. If you want the long version, email
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>
    </div>
  </Band>
</BaseLayout>
