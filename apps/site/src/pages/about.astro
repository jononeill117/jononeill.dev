---
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import RevealEmail from "../components/RevealEmail.astro";
---

<BaseLayout
  title="About. Jon ONeill."
  description="Phoenix, AZ. Product, operations, and analytics."
  canonicalPath="/about/"
  navSurface="inverted"
>
  <Band surface="inverted" as="header" class="page-hero">
    <div class="page-inner">
      <Eyebrow>About</Eyebrow>
      <h1 class="page-title">About</h1>
      <p class="page-lede">
        Product, operations, and analytics. Full role history is on
        <a href="/experience/">Experience</a>.
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" class="page-section">
    <div class="page-inner">
      <div class="page-body">
        <p>
          Enterprise product work starts at Zillow, September 2019 to March
          2021. Associate on underwriting models and AI models. Then HomeLight,
          Stoa, and Livable.
        </p>
        <p>
          Ecclesio is a side project. Church software. Invite-only.
        </p>
        <p>
          <RevealEmail />
        </p>
      </div>
    </div>
  </Band>
</BaseLayout>

<style>
  .page-lede a {
    color: inherit;
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
  }
</style>
