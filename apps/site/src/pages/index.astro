---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import RevealEmail from "../components/RevealEmail.astro";
import { SITE } from "../components/site";

const studies = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Jon ONeill. Product, operations, and analytics.">
  <Band surface="canvas" as="header" class="hero">
    <div class="page-inner">
      <Eyebrow>Phoenix, AZ</Eyebrow>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__lede">
        Product, operations, and analytics. Director of Operations at Zoom Drain
        Phoenix. Previously Head of Product at Livable. Product and analytics at
        HomeLight, Stoa, and Zillow.
      </p>
      <p class="page-meta hero__actions">
        <a href="/work/">View work</a>
        <span aria-hidden="true"> · </span>
        <a href={SITE.resumeHref}>Resume</a>
        <span aria-hidden="true"> · </span>
        <a href={SITE.linkedin}>LinkedIn</a>
        <span aria-hidden="true"> · </span>
        <RevealEmail />
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" id="work" class="page-section">
    <div class="page-inner">
      <Eyebrow>Work</Eyebrow>
      <h2 class="page-section-title">Case studies</h2>
      <ul class="work-list" role="list">
        {
          studies.map((study) => (
            <li class="work-item">
              <Eyebrow>{study.data.role}</Eyebrow>
              <h3 class="work-item__title">
                <a href={`/work/${study.id}/`}>{study.data.title}</a>
              </h3>
              <p class="work-item__lede">{study.data.lede}</p>
            </li>
          ))
        }
      </ul>
      <p class="page-meta">
        <a href="/experience/">Full experience</a>
      </p>
    </div>
  </Band>

  <Band surface="accent" as="section" id="contact" class="page-section section--contact">
    <div class="page-inner">
      <Eyebrow>Contact</Eyebrow>
      <h2 class="page-section-title">Phoenix, AZ</h2>
      <p class="page-body">
        <a href="/contact/">Phone, email, LinkedIn</a>
      </p>
    </div>
  </Band>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-section-tight);
  }

  .hero__title {
    margin-block-start: var(--s-4);
    font-size: var(--t-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    max-width: 12ch;
  }

  .hero__lede {
    margin-block-start: var(--s-6);
    max-width: var(--measure-tight);
    font-size: var(--t-body-lg);
    color: var(--fg-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  .work-list {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-12);
  }

  .work-item__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .work-item__title a {
    text-decoration: none;
  }

  .work-item__title a:hover,
  .work-item__title a:focus-visible {
    color: var(--accent);
  }

  .work-item__lede {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-secondary);
  }

  .section--contact .page-section-title,
  .section--contact .page-body {
    color: var(--fg-on-accent);
  }

  .section--contact a {
    color: inherit;
  }
</style>
