---
/**
 * Home. One scrolling page: hero, experience, about, contact.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import RevealEmail from "../components/RevealEmail.astro";
import RoleDemo from "../components/demos/RoleDemo.astro";
import { SITE } from "../components/site";

const allEntries = await getCollection("work");

const EXPERIENCE_ORDER = [
  "zoom-drain",
  "ecclesio",
  "livable",
  "stoa",
  "homelight",
  "zillow",
] as const;

const experienceEntries = EXPERIENCE_ORDER.map((id) => {
  const entry = allEntries.find((e) => e.id === id);
  if (!entry) throw new Error(`Missing work entry: ${id}`);
  return entry;
});

const COMPANY_INDEX = experienceEntries.map((entry) => ({
  id: entry.id,
  name: entry.data.title,
}));
---

<BaseLayout
  title="Jon O'Neill. Product leader."
  description={SITE.description}
  canonicalPath="/"
>
  <Band surface="canvas" as="header" class="hero">
    <div class="page-inner">
      <Eyebrow>Product · operations · analytics</Eyebrow>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__lede">
        Seven years turning manual processes into automated systems — then using
        the data to guide product, pricing, and go-to-market.
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" id="experience" class="page-section experience">
    <div class="page-inner">
      <Eyebrow>Experience</Eyebrow>
      <h2 class="page-section-title">Product &amp; operations.</h2>

      <nav class="company-index" aria-label="Companies">
        <ul class="company-index__list" role="list">
          {
            COMPANY_INDEX.map((company, i) => (
              <li>
                <a class="company-index__link" href={`#${company.id}`}>
                  {company.name}
                </a>
                {i < COMPANY_INDEX.length - 1 && (
                  <span class="company-index__sep" aria-hidden="true">
                    ·
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <ol class="role-list">
        {
          experienceEntries.map((entry) => (
            <li class="role" id={entry.id}>
              <Eyebrow>
                {entry.data.role} · {entry.data.dates}
              </Eyebrow>
              <h3 class="role__title">
                <a class="role__company" href={`#${entry.id}`}>
                  {entry.data.title}
                </a>
              </h3>
              <RoleDemo id={entry.id} />
              <ul class="role__bullets">
                {entry.data.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              {
                entry.data.marketingUrl && (
                  <p class="role__site">
                    <a
                      href={entry.data.marketingUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {entry.data.marketingUrl.replace(/^https?:\/\//, "")}
                    </a>
                  </p>
                )
              }
            </li>
          ))
        }
      </ol>
    </div>
  </Band>

  <Band surface="inverted" as="section" id="about" class="page-section about">
    <div class="page-inner">
      <Eyebrow>About</Eyebrow>
      <h2 class="page-section-title">Where product meets operations.</h2>
      <div class="page-body about__body">
        <p>
          Started at Zillow on underwriting models, then Cash Close at HomeLight,
          Portico at Stoa, Head of Product at Livable, and the P&amp;L at Zoom
          Drain Phoenix. Looking for a product role where operational execution
          and product thinking meet.
        </p>
        <p>Phoenix, AZ · open to remote.</p>
      </div>
      <p class="hero-actions hero-actions--on-inverted">
        <a href="#experience">Experience</a>
        <span aria-hidden="true"> · </span>
        <a href="#ecclesio">Portfolio</a>
        <span aria-hidden="true"> · </span>
        <a href="#resume" data-resume-open>Resume</a>
        <span aria-hidden="true"> · </span>
        <a href="#contact">Contact</a>
      </p>
    </div>
  </Band>

  <Band surface="accent" as="section" id="contact" class="page-section section--contact">
    <div class="page-inner">
      <Eyebrow>Contact</Eyebrow>
      <h2 class="page-section-title">Open to product roles</h2>
      <p class="page-body">
        Phoenix, AZ · glad to work remote. Email is fastest.
      </p>
      <ul class="contact-lines" role="list">
        <li>
          <RevealEmail class="contact-email" />
        </li>
        <li>
          <a href={SITE.linkedin}>linkedin.com/in/jon-oneill-020196</a>
        </li>
        <li>
          <a href="#resume" data-resume-open>Resume, PDF</a>
        </li>
      </ul>
    </div>
  </Band>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-section-tight);
    padding-block-start: calc(
      var(--nav-stack-height, var(--nav-height-mobile, var(--nav-height))) +
        var(--s-6)
    );
  }

  @media (min-width: 60.0625rem) {
    .hero {
      padding-block-start: calc(
        var(--nav-stack-height, var(--nav-height)) + var(--s-8)
      );
    }
  }

  .hero__title {
    margin-block-start: var(--s-4);
    font-size: var(--t-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    max-width: 12ch;
  }

  .hero__lede {
    margin-block-start: var(--s-6);
    max-width: var(--measure-tight);
    font-size: var(--t-body-lg);
    line-height: var(--lh-body);
    color: var(--fg-secondary);
  }

  .hero-actions {
    margin-block-start: var(--s-8);
    font-size: var(--t-proof);
    line-height: 1.6;
  }

  .hero-actions a {
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
    padding-block: var(--s-2);
  }

  .hero-actions--on-inverted {
    color: var(--fg-on-inverted);
  }

  .company-index {
    margin-block-start: var(--s-8);
  }

  .company-index__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .company-index__link {
    font-size: var(--t-proof);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.2em;
  }

  .company-index__sep {
    color: var(--fg-muted);
    margin-inline: var(--s-1);
  }

  .role-list {
    list-style: none;
    margin: var(--s-16) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-24);
  }

  .role__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .role__title + :global(.demo-frame) {
    margin-block-start: var(--s-6);
  }

  .role__company {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.2em;
  }

  .role__bullets {
    margin: var(--s-8) 0 0;
    padding: 0 0 0 1.15rem;
    max-width: var(--measure);
    display: grid;
    gap: var(--s-3);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--fg-secondary);
  }

  .role__bullets li::marker {
    color: var(--fg-muted);
  }

  .role__site {
    margin-block-start: var(--s-4);
    font-size: var(--t-proof, var(--t-body-sm));
    color: var(--fg-muted);
  }

  .role__site a {
    color: var(--fg-secondary);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.2em;
  }

  .role__site a:hover {
    color: var(--accent);
  }

  .about__body {
    color: var(--fg-secondary-on-inverted);
  }

  .about .page-section-title {
    color: var(--fg-on-inverted);
  }

  .section--contact .page-section-title,
  .section--contact .page-body {
    color: var(--fg-on-accent);
  }

  .section--contact a,
  .section--contact :global(.reveal-email) {
    color: inherit;
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
  }

  .contact-lines {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    font-size: var(--t-body-lg);
  }
</style>
