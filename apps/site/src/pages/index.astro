---
/**
 * Hire-packet home for Jon O'Neill.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import { SITE, WORK, FOCUS } from "../components/site";
---

<BaseLayout title={`${SITE.name}. Product, operations, and analytics.`}>
  <Band surface="canvas" as="header" class="hero" data-surface="canvas">
    <div class="hero__inner">
      <Eyebrow>Phoenix, AZ</Eyebrow>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__lede">
        I build the systems behind product, operations, and analytics. Right now
        that means running operations at Zoom Drain Phoenix. Before that, Head of
        Product at Livable, and product and analytics seats at HomeLight, Stoa,
        and Zillow.
      </p>
      <p class="hero__meta">
        <a href="#work">Work</a>
        <span aria-hidden="true"> · </span>
        <a href="#focus">Focus</a>
        <span aria-hidden="true"> · </span>
        <a href="#contact">Contact</a>
        <span aria-hidden="true"> · </span>
        <a href={SITE.linkedin}>LinkedIn</a>
      </p>
    </div>
  </Band>

  <Band surface="inverted" as="section" id="work" class="section">
    <div class="section__inner">
      <Eyebrow>Work</Eyebrow>
      <h2 class="section__title">Where I have been</h2>
      <ol class="work">
        {
          WORK.map((job) => (
            <li class="work__item">
              <div class="work__head">
                <h3 class="work__org">{job.org}</h3>
                <p class="work__when">{job.when}</p>
              </div>
              <p class="work__role">{job.role}</p>
              <p class="work__summary">{job.summary}</p>
            </li>
          ))
        }
      </ol>
      <p class="aside">
        Ecclesio is a side project. It is not my day job and it is not a claim
        about ownership.
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" id="focus" class="section">
    <div class="section__inner">
      <Eyebrow>Focus</Eyebrow>
      <h2 class="section__title">What I am good for</h2>
      <ul class="focus">
        {
          FOCUS.map((item) => (
            <li class="focus__item">
              <h3 class="focus__title">{item.title}</h3>
              <p class="focus__body">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Band>

  <Band surface="accent" as="section" id="contact" class="section section--contact">
    <div class="section__inner">
      <Eyebrow>Contact</Eyebrow>
      <h2 class="section__title">Hire me, brief me, or say hello</h2>
      <p class="section__body">
        Best reach is email. LinkedIn is fine too if that is how your process
        works.
      </p>
      <p class="contact__lines">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span aria-hidden="true" class="contact__sep">/</span>
        <a href={SITE.linkedin}>linkedin.com/in/jon-oneill-020196</a>
      </p>
    </div>
  </Band>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: flex-end;
    padding-block: var(--s-section);
  }

  .hero__inner,
  .section__inner {
    width: min(100%, var(--max-w));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__title {
    margin-block-start: var(--s-4);
    font-size: var(--t-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    max-width: 11ch;
  }

  .hero__lede {
    margin-block-start: var(--s-6);
    max-width: var(--measure-tight);
    font-size: var(--t-body-lg);
    color: var(--fg-secondary);
  }

  .hero__meta {
    margin-block-start: var(--s-8);
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .hero__meta a {
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
  }

  .section {
    padding-block: var(--s-section);
  }

  .section__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    max-width: 18ch;
  }

  .section__body {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-secondary);
  }

  .work {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .work__item {
    padding-block: var(--s-8);
    border-block-start: var(--hairline) solid var(--hairline-on-inverted);
  }

  .work__item:last-child {
    border-block-end: var(--hairline) solid var(--hairline-on-inverted);
  }

  .work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
  }

  .work__org {
    font-size: var(--t-h4);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .work__when {
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--fg-muted-on-inverted);
  }

  .work__role {
    margin-block-start: var(--s-2);
    font-size: var(--t-body-lg);
  }

  .work__summary {
    margin-block-start: var(--s-3);
    max-width: var(--measure);
    color: var(--fg-secondary-on-inverted);
  }

  .aside {
    margin-block-start: var(--s-8);
    max-width: var(--measure);
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--fg-muted-on-inverted);
  }

  .focus {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-12);
  }

  @media (min-width: 900px) {
    .focus {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-8);
    }
  }

  .focus__title {
    font-size: var(--t-h4);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .focus__body {
    margin-block-start: var(--s-3);
    color: var(--fg-secondary);
    max-width: 36ch;
  }

  .section--contact .section__title,
  .section--contact .section__body {
    color: var(--fg-on-accent);
  }

  .section--contact .section__body {
    color: var(--fg-muted-on-accent);
  }

  .contact__lines {
    margin-block-start: var(--s-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    font-family: var(--font-label);
    font-size: var(--t-mono-sm);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
  }

  .contact__lines a {
    color: var(--fg-on-accent);
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
  }

  .contact__sep {
    color: var(--fg-muted-on-accent);
  }
</style>
