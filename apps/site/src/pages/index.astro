---
/**
 * Home. A recruiter has ninety seconds. Claim, proof, numbers, then the roles.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "@jononeill/ui/Band.astro";
import Eyebrow from "@jononeill/ui/Eyebrow.astro";
import { SITE } from "../components/site";

const entries = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);

const roles = entries.filter((entry) => entry.data.kind !== "project");
const side = entries.filter((entry) => entry.data.kind === "project");

/** Reverse chronological, and Zoom Drain does not open the page. */
const PROOF = ["Zillow", "HomeLight", "Stoa", "Livable", "Zoom Drain"];

const STATS = [
  "$1B underwritten",
  "$800M annual book",
  "2,000 units in four months",
  "Cycle time down 85%",
];
---

<BaseLayout title="Jon O'Neill. Product manager, zero to one SaaS and pricing platforms.">
  <Band surface="canvas" as="header" class="hero">
    <div class="page-inner">
      <Eyebrow>Product manager. Phoenix, AZ.</Eyebrow>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__lede">
        I build the product that makes the expensive decision. Underwriting
        models at Zillow and HomeLight, the pricing platform forty analysts
        worked in at Stoa, and a zero to one SaaS at Livable that reached 2,000
        units in its first four months.
      </p>
      <p class="page-meta">
        {
          PROOF.map((name, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span>{name}</span>
            </>
          ))
        }
      </p>
      <p class="page-meta">
        {
          STATS.map((stat, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span>{stat}</span>
            </>
          ))
        }
      </p>
      <p class="page-meta">
        <a href={SITE.resume}>Resume</a>
        <span aria-hidden="true"> · </span>
        <a href={SITE.linkedin}>LinkedIn</a>
        <span aria-hidden="true"> · </span>
        <a href="/contact/">Contact</a>
      </p>
    </div>
  </Band>

  <Band surface="canvas" as="section" id="work" class="page-section">
    <div class="page-inner">
      <Eyebrow>Work</Eyebrow>
      <h2 class="page-section-title">Five seats, same job.</h2>
      <p class="page-body">
        Product on enterprise models, on a marketplace acquisitions book, on a
        pricing platform, and on a zero to one SaaS. Then the operating side of a
        live P&amp;L, to find out what my roadmaps had been costing the people
        who ran them.
      </p>
      <ul class="work-list" role="list">
        {
          roles.map((entry) => (
            <li class="work-item">
              <Eyebrow>
                {entry.data.role} · {entry.data.dates}
              </Eyebrow>
              <h3 class="work-item__title">
                {entry.id === "zoom-drain" ? (
                  <span>{entry.data.title}</span>
                ) : (
                  <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
                )}
              </h3>
              <p class="work-item__lede">{entry.data.lede}</p>
              <p class="page-meta">{entry.data.outcome}</p>
            </li>
          ))
        }
      </ul>
      <p class="page-meta">
        <a href="/experience/">Full experience</a>
      </p>
    </div>
  </Band>

  {
    side.map((entry) => (
      <Band surface="canvas" as="section" class="page-section">
        <div class="page-inner">
          <Eyebrow>On the side · {entry.data.dates}</Eyebrow>
          <h2 class="work-item__title">
            <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
          </h2>
          <p class="work-item__lede">{entry.data.lede}</p>
          <p class="page-meta">{entry.data.outcome}</p>
        </div>
      </Band>
    ))
  }

  <Band surface="accent" as="section" id="contact" class="page-section section--contact">
    <div class="page-inner">
      <Eyebrow>Contact</Eyebrow>
      <h2 class="page-section-title">I want the next zero to one.</h2>
      <p class="page-body">
        A product role at a startup, where the roadmap, the number, and the go to
        market sit inside one job. Phoenix, AZ, and glad to work remote.
      </p>
      <p class="page-meta">
        <a href="/contact/">Phone, email, LinkedIn, resume</a>
      </p>
    </div>
  </Band>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-section-tight);
  }

  .hero__title {
    margin-block-start: var(--s-4);
    font-size: var(--t-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    max-width: 12ch;
  }

  .hero__lede {
    margin-block-start: var(--s-6);
    max-width: var(--measure-tight);
    font-size: var(--t-body-lg);
    color: var(--fg-secondary);
  }

  .work-list {
    list-style: none;
    margin: var(--s-12) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-12);
  }

  .work-item__title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  .work-item__title a {
    text-decoration: none;
  }

  .work-item__title a:hover,
  .work-item__title a:focus-visible {
    color: var(--accent);
  }

  .work-item__lede {
    margin-block-start: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-secondary);
  }

  .section--contact .page-section-title,
  .section--contact .page-body {
    color: var(--fg-on-accent);
  }

  .section--contact a {
    color: inherit;
  }
</style>
